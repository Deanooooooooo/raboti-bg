---
interface Props {
  name: string;
  slug: string;
  accent: string;
  accentSoft: string;
  size?: "micro" | "small" | "medium" | "large";
}

const { name, slug, accent, accentSoft, size = "medium" } = Astro.props;
const vdigaMark = `${import.meta.env.BASE_URL}assets/vdiga-v-mark.png`;
---

<div class:list={["agent-identity", `agent-identity--${slug}`, `agent-identity--${size}`]} style={`--agent:${accent};--agent-soft:${accentSoft}`} aria-hidden="true">
  <svg viewBox="0 0 120 120" role="img" aria-label={name}>
    <defs>
      <linearGradient id={`identity-ink-${slug}`} x1="25" y1="25" x2="94" y2="96" gradientUnits="userSpaceOnUse">
        <stop stop-color="color-mix(in srgb,var(--agent) 55%,#101328)" />
        <stop offset="1" stop-color="var(--agent)" />
      </linearGradient>
    </defs>

    {slug === "vdiga" && <image href={vdigaMark} x="14" y="14" width="92" height="92" />}

    {slug === "pomaga" && (
      <g class="identity-mark identity-mark--pomaga" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M29 39v11c0 7 5 12 12 12h12" stroke="#191b2d" stroke-width="10" />
        <path d="M91 81V70c0-7-5-12-12-12H67" stroke={`url(#identity-ink-${slug})`} stroke-width="10" />
        <circle cx="60" cy="60" r="7" fill="var(--agent)" stroke="#10172b" stroke-width="3" />
        <circle cx="29" cy="35" r="4" fill="#191b2d" stroke="none" /><circle cx="91" cy="85" r="4" fill="var(--agent)" stroke="none" />
      </g>
    )}

    {slug === "pishe" && (
      <g class="identity-mark identity-mark--pishe" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M29 82h19c10 0 18-4 25-11" stroke="#191b2d" stroke-width="10" />
        <path d="m48 76 35-37" stroke={`url(#identity-ink-${slug})`} stroke-width="11" />
        <path d="m76 35 10-3-3 10" fill="var(--agent)" stroke="none" />
        <circle cx="29" cy="82" r="4" fill="#191b2d" stroke="none" />
      </g>
    )}

    {slug === "smyata" && (
      <g class="identity-mark identity-mark--smyata" fill="none" stroke-linecap="round">
        <path d="M34 79V67" stroke="#191b2d" stroke-width="11" />
        <path d="M56 79V51" stroke="#191b2d" stroke-opacity=".58" stroke-width="11" />
        <path d="M78 79V35" stroke={`url(#identity-ink-${slug})`} stroke-width="11" />
        <path d="M29 88h58" stroke="#191b2d" stroke-opacity=".18" stroke-width="3" />
        <circle cx="88" cy="88" r="4" fill="var(--agent)" stroke="none" />
      </g>
    )}

    {slug === "prodava" && (
      <g class="identity-mark identity-mark--prodava" fill="none" stroke-linecap="round">
        <path d="M34 73c-5-18 7-36 25-40 10-2 20 1 27 8" stroke="#191b2d" stroke-width="10" />
        <path d="M86 47c5 18-7 36-25 40-10 2-20-1-27-8" stroke={`url(#identity-ink-${slug})`} stroke-width="10" />
        <circle cx="86" cy="43" r="5" fill="var(--agent)" stroke="none" />
        <circle cx="34" cy="77" r="5" fill="#191b2d" stroke="none" />
      </g>
    )}
  </svg>
</div>

<style>
  .agent-identity{position:relative;flex:0 0 auto;color:var(--agent)}
  .agent-identity svg{display:block;width:100%;height:100%;overflow:visible}
  .agent-identity--micro{width:32px;height:32px}.agent-identity--small{width:52px;height:52px}.agent-identity--medium{width:82px;height:82px}.agent-identity--large{width:min(220px,42vw);height:min(220px,42vw)}
  .agent-identity--vdiga image{filter:brightness(0) saturate(100%) invert(44%) sepia(60%) saturate(880%) hue-rotate(125deg) brightness(91%)}
  .agent-identity--large .identity-mark,.agent-identity--large image{transform-origin:60px 60px;transition:transform .45s cubic-bezier(.2,.8,.2,1)}
  .agent-identity--large:hover .identity-mark,.agent-identity--large:hover image{transform:scale(1.045)}
  @media(prefers-reduced-motion:reduce){.agent-identity--large .identity-mark,.agent-identity--large image{transition:none}}
</style>
