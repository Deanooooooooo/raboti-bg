---
interface Props {
  name: string;
  slug: string;
  accent: string;
  accentSoft: string;
  size?: "micro" | "small" | "medium" | "large";
}

const { name, slug, accent, accentSoft, size = "medium" } = Astro.props;
const vdigaMark = `${import.meta.env.BASE_URL}assets/vdiga-v-mark.png`;
---

<div class:list={["agent-identity", `agent-identity--${slug}`, `agent-identity--${size}`]} style={`--agent:${accent};--agent-soft:${accentSoft}`} aria-hidden="true">
  <svg viewBox="0 0 120 120" role="img" aria-label={name}>
    <defs>
      <radialGradient id={`identity-field-${slug}`} cx="32%" cy="24%" r="82%">
        <stop stop-color="color-mix(in srgb,var(--agent) 52%,#263152)" />
        <stop offset=".48" stop-color="color-mix(in srgb,var(--agent) 18%,#10172b)" />
        <stop offset="1" stop-color="#080d1b" />
      </radialGradient>
      <linearGradient id={`identity-ink-${slug}`} x1="25" y1="25" x2="94" y2="96" gradientUnits="userSpaceOnUse">
        <stop stop-color="color-mix(in srgb,var(--agent) 72%,white)" />
        <stop offset="1" stop-color="var(--agent)" />
      </linearGradient>
      <filter id={`identity-glow-${slug}`} x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="5" /></filter>
    </defs>

    <circle class="identity-aura" cx="60" cy="60" r="49" fill="var(--agent)" opacity=".18" filter={`url(#identity-glow-${slug})`} />
    <circle class="identity-field" cx="60" cy="60" r="47" fill={`url(#identity-field-${slug})`} />
    <circle cx="60" cy="60" r="46.5" fill="none" stroke="white" stroke-opacity=".1" />
    <path class="identity-orbit" d="M18 71A44 44 0 0 0 91 91" />
    <circle class="identity-orbit-dot" cx="18" cy="71" r="2.8" fill="var(--agent)" />

    {slug === "vdiga" && <image href={vdigaMark} x="25" y="25" width="70" height="70" />}

    {slug === "pomaga" && (
      <g class="identity-mark identity-mark--pomaga" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M29 39v11c0 7 5 12 12 12h12" stroke="white" stroke-width="10" />
        <path d="M91 81V70c0-7-5-12-12-12H67" stroke={`url(#identity-ink-${slug})`} stroke-width="10" />
        <circle cx="60" cy="60" r="7" fill="var(--agent)" stroke="#10172b" stroke-width="3" />
        <circle cx="29" cy="35" r="4" fill="white" stroke="none" /><circle cx="91" cy="85" r="4" fill="var(--agent)" stroke="none" />
      </g>
    )}

    {slug === "pishe" && (
      <g class="identity-mark identity-mark--pishe" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <path d="M29 82h19c10 0 18-4 25-11" stroke="white" stroke-width="10" />
        <path d="m48 76 35-37" stroke={`url(#identity-ink-${slug})`} stroke-width="11" />
        <path d="m76 35 10-3-3 10" fill="var(--agent)" stroke="none" />
        <circle cx="29" cy="82" r="4" fill="white" stroke="none" />
      </g>
    )}

    {slug === "smyata" && (
      <g class="identity-mark identity-mark--smyata" fill="none" stroke-linecap="round">
        <path d="M34 79V67" stroke="white" stroke-width="11" />
        <path d="M56 79V51" stroke="white" stroke-opacity=".62" stroke-width="11" />
        <path d="M78 79V35" stroke={`url(#identity-ink-${slug})`} stroke-width="11" />
        <path d="M29 88h58" stroke="white" stroke-opacity=".18" stroke-width="3" />
        <circle cx="88" cy="88" r="4" fill="var(--agent)" stroke="none" />
      </g>
    )}

    {slug === "prodava" && (
      <g class="identity-mark identity-mark--prodava" fill="none" stroke-linecap="round">
        <path d="M34 73c-5-18 7-36 25-40 10-2 20 1 27 8" stroke="white" stroke-width="10" />
        <path d="M86 47c5 18-7 36-25 40-10 2-20-1-27-8" stroke={`url(#identity-ink-${slug})`} stroke-width="10" />
        <circle cx="86" cy="43" r="5" fill="var(--agent)" stroke="none" />
        <circle cx="34" cy="77" r="5" fill="white" stroke="none" />
      </g>
    )}
  </svg>
</div>

<style>
  .agent-identity{position:relative;flex:0 0 auto;color:var(--agent);filter:drop-shadow(0 16px 24px color-mix(in srgb,var(--agent) 24%,transparent))}
  .agent-identity svg{display:block;width:100%;height:100%;overflow:visible}
  .agent-identity--micro{width:32px;height:32px}.agent-identity--small{width:52px;height:52px}.agent-identity--medium{width:82px;height:82px}.agent-identity--large{width:min(220px,42vw);height:min(220px,42vw)}
  .identity-orbit{fill:none;stroke:white;stroke-width:1.25;stroke-dasharray:1 7;stroke-linecap:round;opacity:.22}
  .agent-identity--large .identity-field,.agent-identity--large .identity-mark,.agent-identity--large image{transform-origin:60px 60px;transition:transform .45s cubic-bezier(.2,.8,.2,1)}
  .agent-identity--large:hover .identity-field{transform:scale(1.025)}.agent-identity--large:hover .identity-mark,.agent-identity--large:hover image{transform:scale(1.045)}
  .agent-identity--large .identity-aura{animation:identity-breathe 4.5s ease-in-out infinite}
  @keyframes identity-breathe{50%{opacity:.28;transform:scale(1.08);transform-origin:60px 60px}}
  @media(prefers-reduced-motion:reduce){.agent-identity--large .identity-aura{animation:none}.agent-identity--large .identity-field,.agent-identity--large .identity-mark,.agent-identity--large image{transition:none}}
</style>
