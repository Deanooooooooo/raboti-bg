---
import Icon from "./Icon.astro";
const plans = [
  { name:"Една задача", price:"297 €", scope:"Един повтарящ се път от начало до край", note:"За екип, който всеки ден преписва една и съща заявка от имейл в CRM, таблица или работен списък.", features:["Настройка около една конкретна повтаряща се задача","Прехвърляне на договорените данни между свързаните системи","Проверка за липсващи задължителни полета","Дневник на свършеното и предаване на необичайните случаи към човек"], cta:"Покажете задачата" },
  { name:"Работен поток", price:"597 €", scope:"Няколко свързани стъпки и хора", note:"За заявка, която минава през входяща поща, CRM, задача и известие, преди екипът да може да продължи работа.", features:["Всичко от план „Една задача“","Свързани стъпки между няколко програми","Разпределяне към правилния човек според случая","Справка кое е приключило, кое чака и защо","Одобрение преди плащане, договор или друга необратима стъпка"], cta:"Покажете целия път", featured:true },
  { name:"Операции", price:"Индивидуална оферта", scope:"За повече процеси, обем или нестандартни системи", note:"За фирми, при които няколко екипа обработват много заявки и работата не се побира в един готов месечен обхват.", features:["Карта на процесите и местата, на които работата се губи","Приоритетен ред за внедряване на задачите","Проверка на достъпите, интеграциите и човешките одобрения","Договорен месечен обем и отчет за изпълненото"], cta:"Опишете обема работа" },
];
---
<section class="gloria-pricing pomaga-pricing" id="planove" aria-labelledby="pomaga-pricing-title">
  <header class="gloria-section-head"><p>Планове за работа</p><h2 id="pomaga-pricing-title">Колко от повтарящата се работа да поеме Pomaga?</h2></header>
  <p class="gloria-pricing__lead">Покажете една истинска задача. Ще видим през кои програми минава, къде трябва да спре за човек и кой план покрива работата.</p>
  <div class="gloria-pricing__grid">{plans.map((plan) => <article class:list={["gloria-plan",plan.featured&&"gloria-plan--featured"]}>
    <header><h3>{plan.name}</h3>{plan.featured&&<span>най-избиран</span>}</header><p class="gloria-plan__note">{plan.note}</p>
    <div class="gloria-plan__volume"><strong>{plan.scope}</strong><span>Какво поема Pomaga</span></div>
    <div class="gloria-plan__price"><strong>{plan.price}</strong>{plan.price!=="Индивидуална оферта"&&<span>/месец</span>}</div>
    <p class="gloria-plan__terms">Без ДДС. Настройката и точният обхват се описват преди старта.</p>
    <ul>{plan.features.map((feature)=><li><Icon name="check" />{feature}</li>)}</ul>
    <a class:list={["button",plan.featured?"button--spectrum":"button--dark"]} href="#zayavka" data-pomaga-plan={plan.name}>{plan.cta}<Icon name="arrow-right" /></a>
  </article>)}</div>
</section>
