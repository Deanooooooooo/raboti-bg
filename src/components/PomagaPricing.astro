---
import Icon from "./Icon.astro";
const plans = [
  { name:"1 локален AI агент", price:"297 €", scope:"Една роля за един повтарящ се процес", note:"Избирате първата работа, която искате да махнете от екипа: имейл и CRM, таблици, съдържание или проучване на потенциални клиенти.", features:["Един агент с име и описана роля, например Гюнтер или Woz","Един повтарящ се процес с проверим резултат","Комуникация с агента в Telegram, WhatsApp или Viber","30 дни пълна поддръжка, за да се научите как да възлагате и проверявате работата","Спира преди плащане, договор или друга необратима стъпка"], cta:"Изберете първия агент" },
  { name:"3 локални AI агента", price:"597 €", scope:"Три роли за свързани процеси", note:"За бизнес, който иска отделни агенти за входяща поща, CRM, съдържание, таблици или проучване на потенциални клиенти.", features:["До три агента с отделни имена, роли и правила","Работа между имейл, CRM, документи, таблици и задачи","Комуникация с агентите в Telegram, WhatsApp или Viber","30 дни пълна поддръжка за вашия екип","Дневник на свършеното и предаване към човек при изключение"], cta:"Съставете AI екипа", featured:true },
  { name:"AI екип за бизнеса", price:"Индивидуална оферта", scope:"Брой агенти и процеси според фирмата", note:"Това е нашият ориентир за цялостен бизнес помощник: отделни AI агенти поемат конкретни роли и работят заедно по процесите на фирмата.", features:["Карта на процесите, ролите и нужните връзки","Агенти за имейл, CRM, съдържание, таблици и проучване","Комуникация в Telegram, WhatsApp или Viber","30 дни пълна поддръжка след пускането","Цена и срок след преглед на обема, системите и човешките проверки"], cta:"Проектирайте AI екипа" },
];
---
<section class="gloria-pricing pomaga-pricing" id="planove" aria-labelledby="pomaga-pricing-title">
  <header class="gloria-section-head"><p>Вашият AI екип</p><h2 id="pomaga-pricing-title">Колко локални AI агента да работят за бизнеса ви?</h2></header>
  <p class="gloria-pricing__lead">Започнете с един агент или съберете екип от отделни роли. Всеки агент има име, работа, достъпи и случаи, в които трябва да потърси човек.</p>
<details class="plan-comparison"><summary>Сравнете плановете на едно място</summary><div class="plan-comparison__scroll" tabindex="0" role="region" aria-label="Сравнение на плановете"><table><caption>Основните разлики · Pomaga</caption><thead><tr><th scope="col">Включено</th><th scope="col">1 AI агент</th><th scope="col">3 AI агента</th><th scope="col">AI екип</th></tr></thead><tbody><tr><th scope="row">Роли</th><td>Една</td><td>До три</td><td>Според фирмата</td></tr><tr><th scope="row">Комуникация</th><td>Telegram, WhatsApp или Viber</td><td>Telegram, WhatsApp или Viber</td><td>Според процеса</td></tr><tr><th scope="row">Месечна цена без ДДС</th><td>€297</td><td>€597</td><td>По оферта</td></tr></tbody></table></div></details>
  <div class="gloria-pricing__grid">{plans.map((plan) => <article class:list={["gloria-plan",plan.featured&&"gloria-plan--featured"]}>
    <header><h3>{plan.name}</h3>{plan.featured&&<span>За свързан процес</span>}</header><p class="gloria-plan__note">{plan.note}</p>
    <div class="gloria-plan__volume"><strong>{plan.scope}</strong><span>Какво поема Pomaga</span></div>
    <div class="gloria-plan__price"><strong>{plan.price}</strong>{plan.price!=="Индивидуална оферта"&&<span>/месец</span>}</div>
    <p class="gloria-plan__terms">Без ДДС. Настройката се плаща отделно. Преди старта записваме ролите, достъпите, обема и случаите за човек.</p>
    <ul>{plan.features.map((feature)=><li><Icon name="check" />{feature}</li>)}</ul>
    <a class:list={["button",plan.featured?"button--spectrum":"button--dark"]} href="#zayavka" data-pomaga-plan={plan.name}>{plan.cta}<Icon name="arrow-right" /></a>
  </article>)}</div>
</section>
