---
import Icon from "./Icon.astro";
const plans = [
  { name:"Една задача", price:"297 €", scope:"Един повтарящ се път от начало до край", note:"За екип, който всеки ден преписва една и съща заявка от имейл в CRM, таблица или работен списък.", features:["Настройка около една конкретна повтаряща се задача","Прехвърляне на договорените данни между свързаните системи","Проверка за липсващи задължителни полета","Дневник на свършеното и предаване на необичайните случаи към човек"], cta:"Покажете задачата" },
  { name:"Няколко стъпки", price:"597 €", scope:"Заявката минава през няколко програми и хора", note:"За заявка, която идва по имейл, влиза в CRM, превръща се в задача и накрая трябва да стигне до определен човек.", features:["Всичко от план „Една задача“","Прехвърляне на данни между няколко програми","Задачата стига до човека, който трябва да я продължи","Виждате кое е приключило, кое чака и защо","Pomaga спира преди плащане, договор или друга необратима стъпка"], cta:"Покажете всички стъпки", featured:true },
  { name:"Операции", price:"Индивидуална оферта", scope:"Повече задачи, повече заявки или програма без готова връзка", note:"За фирми, в които няколко екипа обработват много заявки и Pomaga трябва да поеме повече от една повтаряща се задача.", features:["Описваме къде започва и завършва всяка задача","Подреждаме задачите по реда, в който ще ги настройваме","Проверяваме до кои програми може да има достъп и кога трябва да пита човек","Уговаряме колко заявки поема месечно и как ще виждате свършеното"], cta:"Опишете работата" },
];
---
<section class="gloria-pricing pomaga-pricing" id="planove" aria-labelledby="pomaga-pricing-title">
  <header class="gloria-section-head"><p>Планове за работа</p><h2 id="pomaga-pricing-title">Колко от повтарящата се работа да поеме Pomaga?</h2></header>
  <p class="gloria-pricing__lead">Покажете една задача от началото до края. Ще проверим през кои програми минава, кога Pomaga трябва да ви попита и кой план включва нужните стъпки.</p>
<details class="plan-comparison"><summary>Сравнете плановете на едно място</summary><div class="plan-comparison__scroll" tabindex="0" role="region" aria-label="Сравнение на плановете"><table><caption>Основните разлики · Pomaga</caption><thead><tr><th scope="col">Включено</th><th scope="col">Една задача</th><th scope="col">Няколко стъпки</th><th scope="col">Операции</th></tr></thead><tbody><tr><th scope="row">Обхват</th><td>Един повтарящ се процес</td><td>Няколко свързани стъпки</td><td>Няколко процеса по оферта</td></tr><tr><th scope="row">Обем заявки</th><td>Уточнява се</td><td>Уточнява се</td><td>Уточнява се</td></tr><tr><th scope="row">Месечна цена без ДДС</th><td>€297</td><td>€597</td><td>По оферта</td></tr></tbody></table></div></details>
  <div class="gloria-pricing__grid">{plans.map((plan) => <article class:list={["gloria-plan",plan.featured&&"gloria-plan--featured"]}>
    <header><h3>{plan.name}</h3>{plan.featured&&<span>За свързан процес</span>}</header><p class="gloria-plan__note">{plan.note}</p>
    <div class="gloria-plan__volume"><strong>{plan.scope}</strong><span>Какво поема Pomaga</span></div>
    <div class="gloria-plan__price"><strong>{plan.price}</strong>{plan.price!=="Индивидуална оферта"&&<span>/месец</span>}</div>
    <p class="gloria-plan__terms">Без ДДС. Преди да започнем, записваме кои стъпки поема Pomaga и колко заявки ще обработва.</p>
    <ul>{plan.features.map((feature)=><li><Icon name="check" />{feature}</li>)}</ul>
    <a class:list={["button",plan.featured?"button--spectrum":"button--dark"]} href="#zayavka" data-pomaga-plan={plan.name}>{plan.cta}<Icon name="arrow-right" /></a>
  </article>)}</div>
</section>
