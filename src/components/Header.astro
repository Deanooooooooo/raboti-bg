---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Начална страница на Raboti">
      <img class="brand-logo" src="/assets/raboti-logo.webp" width="600" height="191" alt="" decoding="sync" fetchpriority="high" />
    </a>
    <nav id="site-nav" class="site-nav" aria-label="Основна навигация">
      {site.nav.map((item) => <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="button button--small header-cta" href="/kontakti/">
        <span class="header-cta__full">Наемете AI служител</span>
        <span class="header-cta__short" aria-hidden="true">Наемете</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Отвори менюто</span>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const headerInner = header?.querySelector<HTMLElement>(".header-inner");
  const hero = document.querySelector<HTMLElement>(".home-hero");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>(".site-nav");

  const updateHeaderSurface = () => {
    if (!header) return;
    header.classList.toggle("is-scrolled", window.scrollY > 8);
    if (!hero) return;
    const headerEdge = headerInner?.getBoundingClientRect().bottom ?? header.getBoundingClientRect().bottom;
    const heroBounds = hero.getBoundingClientRect();
    header.classList.toggle("is-over-dark", heroBounds.top < headerEdge && heroBounds.bottom > headerEdge);
  };

  updateHeaderSurface();
  window.addEventListener("scroll", updateHeaderSurface, { passive: true });
  window.addEventListener("resize", updateHeaderSurface, { passive: true });

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("is-open", !open);
    const label=toggle.querySelector(".sr-only");if(label)label.textContent=open?"Отвори менюто":"Затвори менюто";
  });
  const closeMenu=()=>{toggle?.setAttribute("aria-expanded","false");nav?.classList.remove("is-open");const label=toggle?.querySelector(".sr-only");if(label)label.textContent="Отвори менюто";};
  document.addEventListener("keydown",event=>{if(event.key==="Escape"&&toggle?.getAttribute("aria-expanded")==="true"){closeMenu();toggle.focus();}});
  document.addEventListener("click",event=>{if(event.target instanceof Node&&!header?.contains(event.target))closeMenu();});
  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
    closeMenu();
  }));
</script>
