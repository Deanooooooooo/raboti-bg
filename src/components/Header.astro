---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Raboti — начало">
      <img class="brand-logo" src="/assets/raboti-logo.webp" width="600" height="191" alt="" decoding="async" />
    </a>
    <nav id="site-nav" class="site-nav" aria-label="Основна навигация">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="button button--small header-cta" href="/kontakti/">
        <span class="header-cta__full">Наеми AI служител</span>
        <span class="header-cta__short" aria-hidden="true">Наеми</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        <span class="sr-only">Отвори менюто</span>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const hero = document.querySelector<HTMLElement>(".home-hero");
  const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>(".site-nav");

  const updateHeaderSurface = () => {
    if (!header || !hero) return;
    const headerEdge = header.getBoundingClientRect().bottom;
    const heroBounds = hero.getBoundingClientRect();
    header.classList.toggle("is-over-dark", heroBounds.top < headerEdge && heroBounds.bottom > headerEdge);
  };

  updateHeaderSurface();
  window.addEventListener("scroll", updateHeaderSurface, { passive: true });
  window.addEventListener("resize", updateHeaderSurface, { passive: true });

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    nav?.classList.toggle("is-open", !open);
  });
  nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
    toggle?.setAttribute("aria-expanded", "false");
    nav?.classList.remove("is-open");
  }));
</script>
