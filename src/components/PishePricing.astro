---
import Icon from "./Icon.astro";

const plans = [
  {
    name: "Изграждане на уебсайт",
    price: "197 €",
    period: "еднократно",
    scope: "Фирмен сайт с най-важното за клиента",
    note: "За бизнес, който има нужда от подреден сайт с услугите, цените и начините за връзка.",
    features: [
      "Страница с цени",
      "Страници за услугите",
      "Оферти и призиви за действие",
      "Контакти и форма за запитване",
      "Pishe работи 24/7",
    ],
    cta: "Разкажете какъв сайт ви трябва",
  },
  {
    name: "Поддръжка на уебсайт",
    price: "297 €",
    period: "/месец",
    scope: "Съдържание, SEO и GEO за фирмен сайт",
    note: "За бизнес, който иска сайтът да печели повече видимост, да отговаря по-добре на клиентските въпроси и да се развива всеки месец.",
    features: [
      "Страници, които обясняват услугите и водят към запитване",
      "SEO и GEO работа за по-добра откриваемост в Google и AI отговорите",
      "Съдържание по въпросите, които клиентите търсят",
      "Чатбот за въпросите на посетителите",
      "Свързване и поддръжка на Google Business Profile и Google Maps",
      "Pishe работи 24/7",
    ],
    cta: "Обсъдете поддръжката на сайта",
    featured: true,
  },
  {
    name: "Поддръжка на онлайн магазин",
    price: "497 €",
    period: "/месец",
    scope: "Каталог, продуктови описания и съдържание",
    note: "За онлайн магазини, в които продуктите и категориите се променят постоянно и съдържанието не трябва да чака екипа.",
    features: [
      "Неограничено обновяване на каталогови страници",
      "Неограничени SEO описания за продуктите",
      "Неограничено съдържание за оптимизация на магазина",
      "Чатбот за продуктови и клиентски въпроси",
      "Pishe работи 24/7",
    ],
    cta: "Покажете ни онлайн магазина",
  },
];
---

<section class="gloria-pricing pishe-pricing" id="planove" aria-labelledby="pishe-pricing-title">
  <header class="gloria-section-head">
    <p>Планове за работа</p>
    <h2 id="pishe-pricing-title">Колко работа искате Pishe да поеме?</h2>
  </header>
  <p class="gloria-pricing__lead">Започнете с нов фирмен сайт или изберете постоянна поддръжка за сайт или онлайн магазин. Pishe работи 24/7, а важните цени, оферти и обещания се публикуват след вашето одобрение.</p>
<details class="plan-comparison"><summary>Сравнете плановете на едно място</summary><div class="plan-comparison__scroll" tabindex="0" role="region" aria-label="Сравнение на плановете"><table><caption>Основните разлики · Pishe</caption><thead><tr><th scope="col">Включено</th><th scope="col">Изграждане на уебсайт</th><th scope="col">Поддръжка на уебсайт</th><th scope="col">Поддръжка на онлайн магазин</th></tr></thead><tbody><tr><th scope="row">Основен резултат</th><td>Нов фирмен сайт</td><td>Съдържание, SEO и GEO</td><td>Каталог, SEO описания и съдържание</td></tr><tr><th scope="row">Чатбот</th><td>По уговорка</td><td>Включен</td><td>Включен</td></tr><tr><th scope="row">Цена без ДДС</th><td>€197 еднократно</td><td>€297/месец</td><td>€497/месец</td></tr></tbody></table></div></details>
  <div class="gloria-pricing__grid">
    {plans.map((plan) => <article class:list={["gloria-plan", plan.featured && "gloria-plan--featured"]}>
      <header><h3>{plan.name}</h3>{plan.featured && <span>За развитие на сайта</span>}</header>
      <p class="gloria-plan__note">{plan.note}</p>
      <div class="gloria-plan__volume"><strong>{plan.scope}</strong><span>Какво поема Pishe</span></div>
      <div class="gloria-plan__price"><strong>{plan.price}</strong><span>{plan.period}</span></div>
      <p class="gloria-plan__terms">Без ДДС. Работата е в рамките на свързания сайт и уговорените правила. Нова функционалност и платени външни услуги се оферират отделно.</p>
      <ul>{plan.features.map((feature) => <li><Icon name="check" />{feature}</li>)}</ul>
      <a class:list={["button", plan.featured ? "button--spectrum" : "button--dark"]} href="#zayavka" data-pishe-plan={plan.name}>{plan.cta}<Icon name="arrow-right" /></a>
    </article>)}
  </div>
</section>
