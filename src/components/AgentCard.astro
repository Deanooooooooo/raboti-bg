---
import type { CollectionEntry } from "astro:content";

interface Props {
  agent: CollectionEntry<"agents">;
  compact?: boolean;
}
const { agent, compact = false } = Astro.props;
const data = agent.data;
const href = `/sluzhiteli/${data.slug}/`;
---

<article
  class:list={["agent-card", compact && "agent-card--compact", data.status === "soon" && "agent-card--soon"]}
  style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}
>
  <div class="agent-card__top">
    <span class="agent-card__number" aria-hidden="true">{String(data.order).padStart(2, "0")}</span>
    <div>
      <span class="status">{data.status === "live" ? "Свободен" : "Скоро"}</span>
      <h3>{data.name}</h3>
      <p class="role">{data.role}</p>
    </div>
  </div>
  {!compact && <p class="agent-card__summary">{data.summary}</p>}
  <div class="agent-card__footer">
    <div>
      <span class="price-label">{data.status === "live" ? "месечна цена" : "позицията"}</span>
      <strong>{data.priceLabel}</strong>
    </div>
    {data.status === "live" ? (
      <a class="card-link" href={href} aria-label={`Наеми ${data.name}`}>Наеми {data.name} <span>→</span></a>
    ) : (
      <a class="card-link" href={`${href}#spisak`}>Извести ме <span>→</span></a>
    )}
  </div>
</article>
