<div
  class="raboti-work-machine"
  data-raboti-work-machine
  data-worker="vdiga"
  role="group"
  aria-label="Работата пристига, Raboti я насочва към подходящия AI служител и връща готов резултат"
>
  <div class="raboti-work-machine__canvas" aria-hidden="true">
    <svg class="rwm-svg" viewBox="0 0 640 560" preserveAspectRatio="xMidYMid meet" focusable="false" role="presentation">
      <defs>
        <filter id="rwm-glow" x="-180%" y="-180%" width="460%" height="460%">
          <feGaussianBlur stdDeviation="5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="rwm-soft-shadow" x="-80%" y="-80%" width="260%" height="260%">
          <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#27407d" flood-opacity=".12"/>
        </filter>
        <linearGradient id="rwm-input-route" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#9eb3ff" stop-opacity=".05"/><stop offset=".68" stop-color="#6384ff" stop-opacity=".35"/><stop offset="1" stop-color="#244cff" stop-opacity=".65"/>
        </linearGradient>
        <linearGradient id="rwm-output-route" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#244cff" stop-opacity=".56"/><stop offset="1" stop-color="#7a9aff" stop-opacity=".06"/>
        </linearGradient>
        <symbol id="rwm-phone" viewBox="-24 -24 48 48"><path d="M-11 -14 C-7 -17 -3 -13 -1 -8 L2 -3 C4 0 3 4 0 6 L-3 8 C2 16 7 20 14 23 L16 19 C18 16 21 16 24 18 L28 21 C32 25 31 29 28 32 C24 36 18 36 12 33 C0 28 -11 17 -17 6 C-21 -3 -18 -10 -11 -14 Z" transform="scale(.55) translate(-8 -8)" class="rwm-icon-line"/></symbol>
        <symbol id="rwm-calendar" viewBox="-24 -24 48 48"><rect x="-14" y="-11" width="28" height="24" rx="5" class="rwm-icon-line"/><path d="M-8 -16 V-7 M8 -16 V-7 M-14 -3 H14 M-7 3 H-3 M2 3 H6 M-7 8 H-3 M2 8 H6" class="rwm-icon-line"/></symbol>
        <symbol id="rwm-document" viewBox="-24 -24 48 48"><path d="M-11 -16 H5 L13 -8 V16 H-11 Z M5 -16 V-8 H13 M-6 -2 H7 M-6 4 H7 M-6 10 H4" class="rwm-icon-line"/></symbol>
        <symbol id="rwm-browser" viewBox="-24 -24 48 48"><rect x="-15" y="-12" width="30" height="24" rx="5" class="rwm-icon-line"/><path d="M-15 -5 H15 M-9 -8 H-8 M-4 -8 H-3 M1 -8 H2 M-8 1 H8 M-8 6 H4" class="rwm-icon-line"/></symbol>
        <symbol id="rwm-mail" viewBox="-24 -24 48 48"><rect x="-15" y="-11" width="30" height="22" rx="5" class="rwm-icon-line"/><path d="M-13 -8 L0 2 L13 -8" class="rwm-icon-line"/></symbol>
        <symbol id="rwm-task" viewBox="-24 -24 48 48"><path d="M-13 -9 L-9 -5 L-3 -12 M2 -9 H13 M-13 1 L-9 5 L-3 -2 M2 1 H13 M-13 11 L-9 15 L-3 8 M2 11 H13" class="rwm-icon-line"/></symbol>
        <symbol id="rwm-check" viewBox="-24 -24 48 48"><path d="M-12 0 L-3 9 L14 -11" class="rwm-check-line"/></symbol>
      </defs>

      <path class="rwm-ambient" d="M25 102 C180 40 330 38 610 80"/>
      <path class="rwm-ambient" d="M10 470 C220 530 390 520 635 450"/>

      <g class="rwm-dispatcher" transform="translate(215 280)">
        <circle r="46" class="rwm-dispatcher-halo rwm-dispatcher-halo--outer"/>
        <circle r="30" class="rwm-dispatcher-halo rwm-dispatcher-halo--inner"/>
        <rect x="-15" y="-10" width="30" height="20" rx="5" class="rwm-dispatcher-block"/>
      </g>

      <g class="rwm-flow is-active" data-rwm-flow="vdiga">
        <path id="rwm-vdiga-in" class="rwm-route rwm-route--input" d="M26 280 C86 280 135 280 188 280"/>
        <path id="rwm-vdiga-mid" class="rwm-route rwm-route--work" d="M240 270 C300 220 350 176 430 142"/>
        <path id="rwm-vdiga-out" class="rwm-route rwm-route--output" d="M510 142 C555 145 590 165 632 192"/>
        <g class="rwm-incoming"><rect x="-27" y="-27" width="54" height="54" rx="17" class="rwm-incoming-tile"/><use href="#rwm-phone" x="-15" y="-15" width="30" height="30"/><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.14;0.31;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-vdiga-in"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.12;0.15;0.30;0.33;1"/></g>
        <rect class="rwm-work-token" width="18" height="12" rx="3" x="-9" y="-6"><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.35;0.52;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-vdiga-mid"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.34;0.37;0.51;0.54;1"/></rect>
        <g class="rwm-result"><rect x="-28" y="-28" width="56" height="56" rx="18" class="rwm-result-tile"/><use href="#rwm-calendar" x="-15" y="-15" width="30" height="30"/><circle cx="18" cy="-18" r="9" class="rwm-result-check-bg"/><use href="#rwm-check" x="12" y="-24" width="12" height="12"/><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.60;0.79;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-vdiga-out"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.59;0.62;0.78;0.81;1"/></g>
      </g>

      <g class="rwm-flow" data-rwm-flow="pishe">
        <path id="rwm-pishe-in" class="rwm-route rwm-route--input" d="M26 280 C86 280 135 280 188 280"/>
        <path id="rwm-pishe-mid" class="rwm-route rwm-route--work" d="M240 280 C312 280 370 280 448 280"/>
        <path id="rwm-pishe-out" class="rwm-route rwm-route--output" d="M528 280 C566 280 600 280 634 280"/>
        <g class="rwm-incoming"><rect x="-27" y="-27" width="54" height="54" rx="17" class="rwm-incoming-tile"/><use href="#rwm-document" x="-15" y="-15" width="30" height="30"/><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.14;0.31;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-pishe-in"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.12;0.15;0.30;0.33;1"/></g>
        <rect class="rwm-work-token" width="18" height="12" rx="3" x="-9" y="-6"><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.35;0.52;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-pishe-mid"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.34;0.37;0.51;0.54;1"/></rect>
        <g class="rwm-result"><rect x="-28" y="-28" width="56" height="56" rx="18" class="rwm-result-tile"/><use href="#rwm-browser" x="-15" y="-15" width="30" height="30"/><circle cx="18" cy="-18" r="9" class="rwm-result-check-bg"/><use href="#rwm-check" x="12" y="-24" width="12" height="12"/><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.60;0.79;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-pishe-out"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.59;0.62;0.78;0.81;1"/></g>
      </g>

      <g class="rwm-flow" data-rwm-flow="pomaga">
        <path id="rwm-pomaga-in" class="rwm-route rwm-route--input" d="M26 280 C86 280 135 280 188 280"/>
        <path id="rwm-pomaga-mid" class="rwm-route rwm-route--work" d="M240 290 C300 340 350 384 430 418"/>
        <path id="rwm-pomaga-out" class="rwm-route rwm-route--output" d="M510 418 C555 414 590 396 632 370"/>
        <g class="rwm-incoming"><rect x="-27" y="-27" width="54" height="54" rx="17" class="rwm-incoming-tile"/><use href="#rwm-mail" x="-15" y="-15" width="30" height="30"/><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.14;0.31;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-pomaga-in"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.12;0.15;0.30;0.33;1"/></g>
        <rect class="rwm-work-token" width="18" height="12" rx="3" x="-9" y="-6"><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.35;0.52;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-pomaga-mid"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.34;0.37;0.51;0.54;1"/></rect>
        <g class="rwm-result"><rect x="-28" y="-28" width="56" height="56" rx="18" class="rwm-result-tile"/><use href="#rwm-task" x="-15" y="-15" width="30" height="30"/><circle cx="18" cy="-18" r="9" class="rwm-result-check-bg"/><use href="#rwm-check" x="12" y="-24" width="12" height="12"/><animateMotion dur="7.7s" repeatCount="indefinite" keyTimes="0;0.60;0.79;1" keyPoints="0;0;1;1" calcMode="linear"><mpath href="#rwm-pomaga-out"/></animateMotion><animate attributeName="opacity" dur="7.7s" repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes="0;0.59;0.62;0.78;0.81;1"/></g>
      </g>

      <g class="rwm-process-pulse" transform="translate(215 280)"><circle r="18"/><circle r="32"/></g>
    </svg>
  </div>

  <button class="rwm-station rwm-station--vdiga is-active" type="button" data-rwm-worker="vdiga" aria-pressed="true" aria-label="Покажи Vdiga">
    <span class="rwm-station__icon" aria-hidden="true"><svg viewBox="-24 -24 48 48"><path d="M-11 -14 C-7 -17 -3 -13 -1 -8 L2 -3 C4 0 3 4 0 6 L-3 8 C2 16 7 20 14 23 L16 19 C18 16 21 16 24 18 L28 21 C32 25 31 29 28 32 C24 36 18 36 12 33 C0 28 -11 17 -17 6 C-21 -3 -18 -10 -11 -14 Z" transform="scale(.55) translate(-8 -8)"/></svg></span><img src="/assets/brand/work-machine-v4/vdiga.webp" width="180" height="55" alt="">
  </button>
  <button class="rwm-station rwm-station--pishe" type="button" data-rwm-worker="pishe" aria-pressed="false" aria-label="Покажи Pishe">
    <span class="rwm-station__icon" aria-hidden="true"><svg viewBox="-24 -24 48 48"><path d="M-11 -16 H5 L13 -8 V16 H-11 Z M5 -16 V-8 H13 M-6 -2 H7 M-6 4 H7 M-6 10 H4"/></svg></span><img src="/assets/brand/work-machine-v4/pishe.webp" width="180" height="55" alt="">
  </button>
  <button class="rwm-station rwm-station--pomaga" type="button" data-rwm-worker="pomaga" aria-pressed="false" aria-label="Покажи Pomaga">
    <span class="rwm-station__icon" aria-hidden="true"><svg viewBox="-24 -24 48 48"><rect x="-15" y="-11" width="30" height="22" rx="5"/><path d="M-13 -8 L0 2 L13 -8"/></svg></span><img src="/assets/brand/work-machine-v4/pomaga.webp" width="180" height="55" alt="">
  </button>

  <div class="rwm-mobile-switcher" role="group" aria-label="AI служители">
    <button type="button" data-rwm-mobile-worker="vdiga" class="is-active" aria-pressed="true">Vdiga</button>
    <button type="button" data-rwm-mobile-worker="pishe" aria-pressed="false">Pishe</button>
    <button type="button" data-rwm-mobile-worker="pomaga" aria-pressed="false">Pomaga</button>
  </div>
</div>
