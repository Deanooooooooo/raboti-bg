<div class="raboti-motion" aria-hidden="true">
  <svg
    class="raboti-motion__svg"
    viewBox="0 0 1600 900"
    preserveAspectRatio="xMidYMid slice"
    focusable="false"
    role="presentation"
  >
    <defs>
      <filter id="raboti-soft-glow" x="-150%" y="-150%" width="400%" height="400%">
        <feGaussianBlur stdDeviation="7" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <filter id="raboti-tiny-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="3" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>

      <!-- shared completion icon -->
      <g id="raboti-check-icon">
        <rect x="-23" y="-23" width="46" height="46" rx="14" class="raboti-icon-tile"/>
        <path d="M-10 0 L-2 8 L13 -9" class="raboti-check-path"/>
      </g>

      <!-- source icons -->
      <g id="raboti-icon-phone">
        <rect x="-28" y="-28" width="56" height="56" rx="17" class="raboti-icon-tile"/>
        <path d="M-11 -13 C-7 -16 -3 -11 -1 -7 L2 -2 C4 1 3 4 0 6 L-3 8 C1 15 6 19 13 22 L15 18 C17 15 20 15 23 17 L27 20 C31 23 30 28 27 31 C23 35 17 35 11 32 C0 27 -10 17 -16 6 C-20 -2 -18 -9 -11 -13 Z"
              transform="scale(.58) translate(-8 -8)"
              class="raboti-source-stroke"/>
      </g>

      <g id="raboti-icon-calendar">
        <rect x="-28" y="-28" width="56" height="56" rx="17" class="raboti-icon-tile"/>
        <rect x="-13" y="-10" width="26" height="22" rx="4" class="raboti-source-stroke"/>
        <path d="M-8 -15 V-7 M8 -15 V-7 M-13 -3 H13 M-7 3 H-3 M2 3 H6 M-7 8 H-3 M2 8 H6"
              class="raboti-source-stroke"/>
      </g>

      <g id="raboti-icon-document">
        <rect x="-28" y="-28" width="56" height="56" rx="17" class="raboti-icon-tile"/>
        <path d="M-10 -15 H6 L13 -8 V15 H-10 Z M6 -15 V-8 H13 M-5 -2 H7 M-5 4 H7 M-5 10 H4"
              class="raboti-source-stroke"/>
      </g>

      <g id="raboti-icon-browser">
        <rect x="-28" y="-28" width="56" height="56" rx="17" class="raboti-icon-tile"/>
        <rect x="-15" y="-12" width="30" height="24" rx="5" class="raboti-source-stroke"/>
        <path d="M-15 -5 H15 M-9 -8 H-8 M-4 -8 H-3 M1 -8 H2 M-8 1 H8 M-8 6 H4"
              class="raboti-source-stroke"/>
      </g>

      <g id="raboti-icon-mail">
        <rect x="-28" y="-28" width="56" height="56" rx="17" class="raboti-icon-tile"/>
        <rect x="-15" y="-11" width="30" height="22" rx="5" class="raboti-source-stroke"/>
        <path d="M-13 -8 L0 2 L13 -8" class="raboti-source-stroke"/>
      </g>

      <g id="raboti-icon-task">
        <rect x="-28" y="-28" width="56" height="56" rx="17" class="raboti-icon-tile"/>
        <path d="M-13 -9 L-9 -5 L-3 -12 M2 -9 H13 M-13 1 L-9 5 L-3 -2 M2 1 H13 M-13 11 L-9 15 L-3 8 M2 11 H13"
              class="raboti-source-stroke"/>
      </g>
    </defs>

    <!-- pale atmosphere tied to the actual process -->
    <path class="raboti-atmosphere raboti-atmosphere--top"
          d="M-40 40 C320 20 520 70 760 180 C980 280 1120 230 1640 110"/>
    <path class="raboti-atmosphere raboti-atmosphere--bottom"
          d="M-30 830 C310 850 550 770 790 660 C1050 540 1230 620 1640 760"/>

    <!-- VDIGA -->
    <g class="raboti-workflow is-active" data-workflow="vdiga">
      <path id="vdiga-route-top"
            class="raboti-route raboti-route--input"
            d="M230 95 C455 95 650 150 780 245 C850 295 885 350 920 430"/>
      <path id="vdiga-route-bottom"
            class="raboti-route raboti-route--input raboti-secondary"
            d="M330 800 C535 785 685 720 790 635 C855 580 895 515 920 430"/>
      <path id="vdiga-route-out"
            class="raboti-route raboti-route--output"
            d="M1100 430 C1260 420 1380 390 1585 345"/>

      <g class="raboti-source-icon" transform="translate(230 95)">
        <use href="#raboti-icon-phone"/>
      </g>
      <g class="raboti-source-icon raboti-secondary" transform="translate(330 800)">
        <use href="#raboti-icon-calendar"/>
      </g>

      <rect class="raboti-token" width="14" height="10" rx="2" x="-7" y="-5">
        <animateMotion
          dur="12s"
          repeatCount="indefinite"
          keyTimes="0;0.12;0.31;1"
          keyPoints="0;0;1;1"
          calcMode="linear"
        >
          <mpath href="#vdiga-route-top"/>
        </animateMotion>
        <animate
          attributeName="opacity"
          dur="12s"
          repeatCount="indefinite"
          values="0;0;1;1;0;0"
          keyTimes="0;0.11;0.14;0.30;0.32;1"
        />
      </rect>

      <rect class="raboti-token raboti-secondary" width="14" height="10" rx="2" x="-7" y="-5">
        <animateMotion
          dur="12s"
          repeatCount="indefinite"
          keyTimes="0;0.42;0.61;1"
          keyPoints="0;0;1;1"
          calcMode="linear"
        >
          <mpath href="#vdiga-route-bottom"/>
        </animateMotion>
        <animate
          attributeName="opacity"
          dur="12s"
          repeatCount="indefinite"
          values="0;0;1;1;0;0"
          keyTimes="0;0.41;0.44;0.60;0.62;1"
        />
      </rect>

      <g class="raboti-card-pulse" transform="translate(920 430)">
        <circle r="18"/>
        <circle r="32"/>
      </g>

      <rect class="raboti-token raboti-token--out" width="16" height="11" rx="2.5" x="-8" y="-5.5">
        <animateMotion
          dur="12s"
          repeatCount="indefinite"
          keyTimes="0;0.68;0.87;1"
          keyPoints="0;0;1;1"
          calcMode="linear"
        >
          <mpath href="#vdiga-route-out"/>
        </animateMotion>
        <animate
          attributeName="opacity"
          dur="12s"
          repeatCount="indefinite"
          values="0;0;1;1;0;0"
          keyTimes="0;0.67;0.70;0.86;0.88;1"
        />
      </rect>

      <g class="raboti-complete" transform="translate(1550 350)">
        <use href="#raboti-check-icon"/>
      </g>
    </g>

    <!-- PISHE -->
    <g class="raboti-workflow" data-workflow="pishe">
      <path id="pishe-route-top"
            class="raboti-route raboti-route--input"
            d="M260 90 C470 110 655 165 785 255 C855 305 895 360 920 430"/>
      <path id="pishe-route-bottom"
            class="raboti-route raboti-route--input raboti-secondary"
            d="M355 805 C555 775 705 705 805 620 C865 565 900 505 920 430"/>
      <path id="pishe-route-out"
            class="raboti-route raboti-route--output"
            d="M1100 430 C1250 418 1395 380 1585 320"/>

      <g class="raboti-source-icon" transform="translate(260 90)">
        <use href="#raboti-icon-document"/>
      </g>
      <g class="raboti-source-icon raboti-secondary" transform="translate(355 805)">
        <use href="#raboti-icon-browser"/>
      </g>

      <rect class="raboti-token" width="14" height="10" rx="2" x="-7" y="-5">
        <animateMotion dur="12s" repeatCount="indefinite"
          keyTimes="0;0.12;0.31;1" keyPoints="0;0;1;1" calcMode="linear">
          <mpath href="#pishe-route-top"/>
        </animateMotion>
        <animate attributeName="opacity" dur="12s" repeatCount="indefinite"
          values="0;0;1;1;0;0" keyTimes="0;0.11;0.14;0.30;0.32;1"/>
      </rect>

      <rect class="raboti-token raboti-secondary" width="14" height="10" rx="2" x="-7" y="-5">
        <animateMotion dur="12s" repeatCount="indefinite"
          keyTimes="0;0.42;0.61;1" keyPoints="0;0;1;1" calcMode="linear">
          <mpath href="#pishe-route-bottom"/>
        </animateMotion>
        <animate attributeName="opacity" dur="12s" repeatCount="indefinite"
          values="0;0;1;1;0;0" keyTimes="0;0.41;0.44;0.60;0.62;1"/>
      </rect>

      <g class="raboti-card-pulse" transform="translate(920 430)">
        <circle r="18"/>
        <circle r="32"/>
      </g>

      <rect class="raboti-token raboti-token--out" width="16" height="11" rx="2.5" x="-8" y="-5.5">
        <animateMotion dur="12s" repeatCount="indefinite"
          keyTimes="0;0.68;0.87;1" keyPoints="0;0;1;1" calcMode="linear">
          <mpath href="#pishe-route-out"/>
        </animateMotion>
        <animate attributeName="opacity" dur="12s" repeatCount="indefinite"
          values="0;0;1;1;0;0" keyTimes="0;0.67;0.70;0.86;0.88;1"/>
      </rect>

      <g class="raboti-complete" transform="translate(1550 325)">
        <use href="#raboti-check-icon"/>
      </g>
    </g>

    <!-- POMAGA -->
    <g class="raboti-workflow" data-workflow="pomaga">
      <path id="pomaga-route-top"
            class="raboti-route raboti-route--input"
            d="M235 105 C455 105 640 155 775 250 C850 305 892 360 920 430"/>
      <path id="pomaga-route-bottom"
            class="raboti-route raboti-route--input raboti-secondary"
            d="M350 795 C545 785 690 730 800 640 C865 585 900 515 920 430"/>
      <path id="pomaga-route-out"
            class="raboti-route raboti-route--output"
            d="M1100 430 C1255 425 1390 400 1585 360"/>

      <g class="raboti-source-icon" transform="translate(235 105)">
        <use href="#raboti-icon-mail"/>
      </g>
      <g class="raboti-source-icon raboti-secondary" transform="translate(350 795)">
        <use href="#raboti-icon-task"/>
      </g>

      <rect class="raboti-token" width="14" height="10" rx="2" x="-7" y="-5">
        <animateMotion dur="12s" repeatCount="indefinite"
          keyTimes="0;0.12;0.31;1" keyPoints="0;0;1;1" calcMode="linear">
          <mpath href="#pomaga-route-top"/>
        </animateMotion>
        <animate attributeName="opacity" dur="12s" repeatCount="indefinite"
          values="0;0;1;1;0;0" keyTimes="0;0.11;0.14;0.30;0.32;1"/>
      </rect>

      <rect class="raboti-token raboti-secondary" width="14" height="10" rx="2" x="-7" y="-5">
        <animateMotion dur="12s" repeatCount="indefinite"
          keyTimes="0;0.42;0.61;1" keyPoints="0;0;1;1" calcMode="linear">
          <mpath href="#pomaga-route-bottom"/>
        </animateMotion>
        <animate attributeName="opacity" dur="12s" repeatCount="indefinite"
          values="0;0;1;1;0;0" keyTimes="0;0.41;0.44;0.60;0.62;1"/>
      </rect>

      <g class="raboti-card-pulse" transform="translate(920 430)">
        <circle r="18"/>
        <circle r="32"/>
      </g>

      <rect class="raboti-token raboti-token--out" width="16" height="11" rx="2.5" x="-8" y="-5.5">
        <animateMotion dur="12s" repeatCount="indefinite"
          keyTimes="0;0.68;0.87;1" keyPoints="0;0;1;1" calcMode="linear">
          <mpath href="#pomaga-route-out"/>
        </animateMotion>
        <animate attributeName="opacity" dur="12s" repeatCount="indefinite"
          values="0;0;1;1;0;0" keyTimes="0;0.67;0.70;0.86;0.88;1"/>
      </rect>

      <g class="raboti-complete" transform="translate(1550 365)">
        <use href="#raboti-check-icon"/>
      </g>
    </g>
  </svg>
</div>
