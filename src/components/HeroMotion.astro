  <g class="rb-moving-token rb-token-primary"><use href="#rb-token-shell" /><use href="#rb-icon-doc" /><animateMotion dur="17s" begin="-1s" repeatCount="indefinite"><mpath href="#rb-lane-low" /></animateMotion><animate attributeName="opacity" values="0;.44;.44;0" keyTimes="0;.08;.9;1" dur="17s" begin="-1s" repeatCount="indefinite" /></g>
  <g class="rb-moving-token rb-token-secondary"><use href="#rb-token-shell" /><use href="#rb-icon-calendar" /><animateMotion dur="20s" begin="-11s" repeatCount="indefinite"><mpath href="#rb-lane-low" /></animateMotion><animate attributeName="opacity" values="0;.32;.32;0" keyTimes="0;.08;.9;1" dur="20s" begin="-11s" repeatCount="indefinite" /></g>
  <g class="rb-moving-token rb-result-token rb-token-primary"><use href="#rb-token-shell" /><use href="#rb-icon-check" /><animateMotion dur="11s" begin="-2s" repeatCount="indefinite"><mpath href="#rb-lane-out" /></animateMotion><animate attributeName="opacity" values="0;.62;.62;0" keyTimes="0;.1;.88;1" dur="11s" begin="-2s" repeatCount="indefinite" /></g>
  <g class="rb-moving-token rb-result-token rb-token-secondary"><use href="#rb-token-shell" /><use href="#rb-icon-check" /><animateMotion dur="13s" begin="-9s" repeatCount="indefinite"><mpath href="#rb-lane-out" /></animateMotion><animate attributeName="opacity" values="0;.38;.38;0" keyTimes="0;.1;.88;1" dur="13s" begin="-9s" repeatCount="indefinite" /></g>
  <g class="rb-packet rb-token-secondary"><circle r="4" fill="#1747ff" opacity=".5" /><animateMotion dur="9s" begin="-5s" repeatCount="indefinite"><mpath href="#rb-lane-mid" /></animateMotion></g>
  <g class="rb-packet rb-token-secondary"><circle r="3.5" fill="#6d96ff" opacity=".42" /><animateMotion dur="10s" begin="-2s" repeatCount="indefinite"><mpath href="#rb-lane-low" /></animateMotion></g>
  <g class="rb-packet rb-token-secondary"><circle r="4" fill="#1747ff" opacity=".56" /><animateMotion dur="7s" begin="-4s" repeatCount="indefinite"><mpath href="#rb-lane-out" /></animateMotion></g>
</svg>

