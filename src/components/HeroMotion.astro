    <g id="rb-icon-phone" fill="none" stroke="#5c7fd8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M-7-10C-10-7-8 1-2 7 4 13 11 13 13 9L8 4 4 7C1 6-5 0-6-3L-3-6Z" /></g>
