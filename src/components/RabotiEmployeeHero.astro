<figure class="employee-hero" aria-labelledby="employee-hero-title">
  <div class="employee-hero__halo" aria-hidden="true"></div>
  <img
    class="employee-hero__mark"
    src="/assets/raboti-employee-hero-v2.png"
    width="1254"
    height="1254"
    alt=""
    aria-describedby="employee-hero-desc"
    decoding="async"
    fetchpriority="high"
  />
  <span id="employee-hero-title" class="sr-only">AI служителят на Работи е на работа</span>
  <span id="employee-hero-desc" class="sr-only">Скулптурен знак, който съчетава човек и кирилската буква Р.</span>

  <figcaption>
    <span><i aria-hidden="true"></i> На работа</span>
    <strong>Приема задачи</strong>
  </figcaption>
</figure>

<style>
  .employee-hero { position: relative; display: grid; min-height: 570px; margin: 0; place-items: center; }
  .employee-hero__halo { position: absolute; width: 430px; height: 430px; border-radius: 50%; background: radial-gradient(circle,rgba(45,226,208,.17),rgba(102,117,255,.12) 42%,transparent 72%); filter: blur(28px); }
  .employee-hero__mark { position: relative; z-index: 1; width: min(100%,560px); height: auto; object-fit: contain; filter: drop-shadow(0 42px 52px rgba(0,0,0,.32)); animation: employee-float 7s ease-in-out infinite; }
  .employee-hero figcaption { position:absolute; z-index:2; right:8%; bottom:28px; display:grid; min-width:180px; gap:3px; padding:13px 16px; border:1px solid rgba(255,255,255,.12); border-radius:14px; background:rgba(9,13,30,.76); box-shadow:0 18px 46px -28px #000; backdrop-filter:blur(12px); }
  .employee-hero figcaption span { display:flex; align-items:center; gap:7px; color:rgba(255,255,255,.5); font-size:.72rem; }
  .employee-hero figcaption i { width:6px; height:6px; border-radius:50%; background:#2de2d0; box-shadow:0 0 12px #2de2d0; animation: employee-status 3.2s cubic-bezier(.2,.8,.2,1) infinite; }
  .employee-hero figcaption strong { color:#fff; font-size:.92rem; }
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @keyframes employee-float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-10px); } }
  @keyframes employee-status { 0%,72%,100% { transform:scale(1); } 82% { transform:scale(1.35); } }
  @media(max-width:960px){.employee-hero{min-height:500px}.employee-hero__mark{width:min(88vw,520px)}.employee-hero figcaption{right:16%;bottom:12px}}
  @media(max-width:560px){.employee-hero{min-height:390px}.employee-hero__mark{width:min(96vw,430px)}.employee-hero figcaption{right:6%;bottom:4px}}
  @media(prefers-reduced-motion:reduce){.employee-hero__mark,.employee-hero figcaption i{animation:none}}
</style>
