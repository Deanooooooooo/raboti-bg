<style>
  .employee-hero { position: relative; display: grid; min-height: 570px; margin: 0; place-items: center; }
  .employee-hero__halo { position: absolute; width: 430px; height: 430px; border-radius: 50%; background: radial-gradient(circle,rgba(45,226,208,.17),rgba(102,117,255,.12) 42%,transparent 72%); filter: blur(28px); }
  .employee-hero__mark { position: relative; z-index: 1; width: auto; max-width: min(100%,520px); height: min(72vh,700px); object-fit: contain; filter: drop-shadow(0 42px 52px rgba(0,0,0,.32)); animation: employee-float 7s ease-in-out infinite; }
