---
import Icon from "./Icon.astro";

const plans = [
  {
    name: "Старт",
    minutes: "120 минути",
    price: "97 €",
    note: "За пропуснатите входящи обаждания и по-малък месечен обем.",
    features: ["120 минути входящи разговори", "До 3 телефонни линии", "Получавате кой се е обадил и какво иска"],
    cta: "Избирам Старт",
  },
  {
    name: "Бизнес",
    minutes: "250 минути",
    price: "197 €",
    note: "За екипи, които приемат обаждания през целия работен ден.",
    features: ["250 минути входящи разговори", "До 3 телефонни линии", "Получавате обобщение и следваща задача след разговора"],
    cta: "Избирам Бизнес",
    featured: true,
  },
  {
    name: "Разширен",
    minutes: "500 минути",
    price: "297 €",
    note: "За бизнеси с входящи обаждания всеки ден.",
    features: ["500 минути входящи разговори", "До 3 телефонни линии", "27% по-ниска цена на минута спрямо Старт"],
    cta: "Избирам Разширен",
  },
  {
    name: "500+ минути",
    minutes: "Над 500 минути",
    price: "Индивидуална оферта",
    note: "За голям обем, няколко обекта или повече телефонни линии.",
    features: ["Минути според броя разговори, които получавате", "3 или повече телефонни линии", "Една настройка за няколко обекта"],
    cta: "Получавам оферта",
  },
];
---

<section class="gloria-pricing" id="planove" aria-labelledby="gloria-pricing-title">
  <header class="gloria-section-head">
    <p>Условия за назначаване</p>
    <h2 id="gloria-pricing-title">Изберете колко разговора да поема.</h2>
  </header>
  <p class="gloria-pricing__lead">Планът зависи от минутите входящи разговори. Ако не знаете колко са, ще ги изчислим с вас.</p>
<details class="plan-comparison"><summary>Сравнете плановете на едно място</summary><div class="plan-comparison__scroll" tabindex="0" role="region" aria-label="Сравнение на плановете"><table><caption>Основните разлики · Vdiga</caption><thead><tr><th scope="col">Включено</th><th scope="col">Старт</th><th scope="col">Бизнес</th><th scope="col">Разширен</th><th scope="col">500+ минути</th></tr></thead><tbody><tr><th scope="row">Месечен обем</th><td>120 минути</td><td>250 минути</td><td>500 минути</td><td>По оферта</td></tr><tr><th scope="row">Телефонни линии</th><td>До 3</td><td>До 3</td><td>До 3</td><td>3 или повече</td></tr><tr><th scope="row">Месечна цена без ДДС</th><td>€97</td><td>€197</td><td>€297</td><td>По оферта</td></tr></tbody></table></div></details>
  <div class="gloria-pricing__grid gloria-pricing__grid--four">
    {plans.map((plan) => <article class:list={["gloria-plan", plan.featured && "gloria-plan--featured"]}>
      <header><h3>{plan.name}</h3>{plan.featured && <span>За ежедневни разговори</span>}</header>
      <p class="gloria-plan__note">{plan.note}</p>
      <div class="gloria-plan__volume"><strong>{plan.minutes}</strong><span>входящи разговори месечно</span></div>
      <div class="gloria-plan__price"><strong>{plan.price}</strong>{plan.price !== "Индивидуална оферта" && <span>/месец</span>}</div>
      <p class="gloria-plan__terms">Без ДДС. Без дългосрочен договор.</p>
      <ul>{plan.features.map((feature) => <li><Icon name="check" />{feature}</li>)}</ul>
      <a class:list={["button", plan.featured ? "button--spectrum" : "button--dark"]} href="#zayavka" data-vdiga-plan={plan.name}>{plan.cta}<Icon name="arrow-right" /></a>
    </article>)}
  </div>
</section>
