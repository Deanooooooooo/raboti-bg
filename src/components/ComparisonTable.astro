---
const rows = [
  ["Месечен разход", "Заплата + осигуровки", "Фиксиран план"],
  ["Работно време", "Обикновено 8 часа", "По зададения график, включително 24/7"],
  ["Отпуск и болнични", "Да", "Не"],
  ["Паралелни задачи", "Ограничени", "Според конфигурацията"],
  ["Започване", "Подбор и обучение", "Обичайно 5–10 работни дни"],
  ["Отговорност", "Човешка преценка", "Ясни правила + човешко одобрение при риск"],
];
---

<div class="comparison-wrap">
  <table class="comparison-table">
    <caption class="sr-only">Сравнение между служител на трудов договор и AI служител</caption>
    <thead><tr><th scope="col">Сравняваме</th><th scope="col">Човек</th><th scope="col">AI служител</th></tr></thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row[0]}</th>
          <td data-label="Човек">{row[1]}</td>
          <td data-label="AI служител">{row[2]}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
