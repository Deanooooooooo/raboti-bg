---
import { site } from "../data/site";
import { organizationSchema } from "../data/schema";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/assets/brand-test/share.png",
  type = "website",
  schema = [],
  noindex = false,
  imageAlt = "",
  imageWidth,
  imageHeight,
  publishedAt,
  updatedAt,
  author,
} = Astro.props;
const canonicalUrl = new URL(canonical, site.url).toString();
const previewBase = import.meta.env.BASE_URL.replace(/\/$/, "");
const imageUrl = new URL(previewBase ? `${previewBase}${image}` : image, previewBase ? "https://deanooooooooo.github.io" : site.url).toString();
const schemas = [organizationSchema, ...(Array.isArray(schema) ? schema : [schema])].filter(Boolean);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="bg_BG" />
<meta property="og:site_name" content={site.brand} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{image.match(/\.(webp|png|jpe?g)$/i) && <meta property="og:image:width" content={String(imageWidth ?? (image === "/assets/brand-test/share.png" ? 1200 : 1600))} />}
{image.match(/\.(webp|png|jpe?g)$/i) && <meta property="og:image:height" content={String(imageHeight ?? (image === "/assets/brand-test/share.png" ? 630 : 900))} />}
{type === "article" && publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{type === "article" && (updatedAt || publishedAt) && <meta property="article:modified_time" content={(updatedAt || publishedAt)?.toISOString()} />}
{type === "article" && author && <meta name="author" content={author} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
{noindex && <meta name="robots" content="noindex,follow" />}
<script is:inline type="application/ld+json" set:html={JSON.stringify(schemas)} />
