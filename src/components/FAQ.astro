---
interface Item { question: string; answer: string }
import Icon from "./Icon.astro";
interface Props { items: Item[]; heading?: string }
const { items, heading } = Astro.props;
---

<div class="faq-list">
  {heading && <h2>{heading}</h2>}
  {items.map((item) => (
    <details>
      <summary>{item.question}<span aria-hidden="true"><Icon name="plus" /></span></summary>
      <p>{item.answer}</p>
    </details>
  ))}
</div>
