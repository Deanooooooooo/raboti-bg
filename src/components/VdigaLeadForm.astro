---
import { site } from "../data/site";
---

<section class="gloria-lead" id="zayavka" aria-labelledby="gloria-lead-title">
  <div class="gloria-lead__copy">
    <p>Разговор с екипа</p>
    <h2 id="gloria-lead-title">Вижте как Глория ще работи при вас.</h2>
    <p>Оставете телефон. Ще уточним кога изпускате обаждания, какво трябва да поема Глория и колко минути са ви нужни месечно.</p>
    <ol>
      <li><span>01</span><div><strong>Разглеждаме обажданията</strong><small>Кога звънят и какво искат клиентите.</small></div></li>
      <li><span>02</span><div><strong>Казваме какво може да поеме Глория</strong><small>Кои разговори ще приема и колко ще струва месечно.</small></div></li>
      <li><span>03</span><div><strong>Вие решавате</strong><small>Няма плащане или абонамент преди потвърждение.</small></div></li>
    </ol>
  </div>
  <form class="gloria-lead__form" data-vdiga-lead-form data-endpoint={site.formEndpoint} data-sales-phone={site.salesPhone} novalidate>
    <input type="hidden" name="intent" value="hire" />
    <input type="hidden" name="agent" value="vdiga" />
    <input type="hidden" name="selectedPlan" value="" data-selected-plan />
    <label class="honeypot" aria-hidden="true" hidden>Уебсайт<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    <header><span data-form-title>Заявете разговор</span><small>Отнема около минута</small></header>
    <div class="gloria-lead__grid">
      <label><span>Вашето име</span><input type="text" name="name" autocomplete="name" placeholder="Име и фамилия" required /></label>
      <label><span>Име на бизнеса</span><input type="text" name="businessName" autocomplete="organization" placeholder="Например Studio Forma" required /></label>
      <label><span>Телефон</span><input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+359 88 123 4567" required /></label>
      <label><span>Имейл</span><input type="email" name="email" autocomplete="email" placeholder="name@business.bg" required /></label>
      <label class="gloria-lead__wide"><span>За какво ви звънят клиентите?</span><select name="primaryNeed" required><option value="" selected disabled>Изберете най-важното</option><option>Записване на часове</option><option>Приемане на резервации</option><option>Приемане на поръчки</option><option>Запитвания и огледи</option><option>Друго</option></select></label>
      <label class="gloria-lead__wide"><span>Кога изпускате най-много обаждания? <small>по желание</small></span><textarea name="task" rows="3" placeholder="Например: когато сме с клиенти или след работно време"></textarea></label>
    </div>
    <label class="gloria-lead__consent"><input type="checkbox" name="consent" value="yes" required /><span>Желая екипът на Vdiga да се свърже с мен по заявката. Прочетох <a href="/politika-za-poveritelnost/">политиката за поверителност</a>.</span></label>
    <button class="button button--spectrum" type="submit">Заявете разговор</button>
    <p class="gloria-lead__note">Няма плащане или абонамент. Първо разговаряме.</p>
    <p class="form-status" aria-live="polite"></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-vdiga-lead-form]");
  const selectedPlan = form?.querySelector<HTMLInputElement>("[data-selected-plan]");
  const formTitle = form?.querySelector<HTMLElement>("[data-form-title]");
  document.querySelectorAll<HTMLAnchorElement>("[data-vdiga-plan]").forEach((link) => link.addEventListener("click", () => {
    const plan = link.dataset.vdigaPlan || "";
    if (selectedPlan) selectedPlan.value = plan;
    if (formTitle) formTitle.textContent = plan === "500+ минути" ? "Нека обсъдим обема ви" : `План ${plan}`;
  }));
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>(".form-status");
    const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const data = new FormData(form);
    const phone = String(data.get("phone") || "").replace(/\D/g, "");
    if (!form.checkValidity()) { form.reportValidity(); if (status) status.textContent = "Проверете задължителните полета."; return; }
    if (!(/^0\d{9}$/.test(phone) || /^359\d{9}$/.test(phone))) { if (status) status.textContent = "Въведете валиден български телефон."; return; }
    const payload = Object.fromEntries(data.entries());
    payload.source = window.location.pathname;
    if (status) status.textContent = "Изпращаме…";
    if (button) button.disabled = true;
      form.setAttribute("aria-busy", "true");
    try {
      const response = await fetch(form.dataset.endpoint || "/api/contact", { method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload) });
      if (!response.ok) throw new Error("Request failed");
      window.dispatchEvent(new CustomEvent('raboti:interaction',{detail:{action:'enquiry_success',agent:String(data.get('agent') || 'unsure')}}));
      form.reset();
      if (status) status.textContent = "Получихме заявката. Ще се свържем с вас.";
    } catch { if (status) status.textContent = `Не успяхме да изпратим. Обадете се на ${form.dataset.salesPhone || "0899 917 920"}.`; }
    finally { if (button) button.disabled = false; form.removeAttribute("aria-busy"); }
  });
</script>
