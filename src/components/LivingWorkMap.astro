---
import WorkGlyph from "./WorkGlyph.astro";

const roles = [
  { id: "vdiga", name: "Вдига", glyph: "vdiga", color: "#2de2d0", input: "Клиент звъни, но всички са заети", action: "Разбира причината и намира свободен час", output: "Часът е записан", note: "Разговорът е обобщен за екипа", meta: "разговор → записан час" },
  { id: "pomaga", name: "Помага", glyph: "pomaga", color: "#8f7cff", input: "Клиентски имейл чака отговор", action: "Създава задача и записва данните в CRM", output: "Задачата е възложена", note: "Екипът вижда имейла и записа в CRM", meta: "имейл → задача в CRM" },
  { id: "pishe", name: "Пише", glyph: "pishe", color: "#ff8d72", input: "Цената на сайта трябва да се промени", action: "Подготвя новия текст и го дава за преглед", output: "Новата цена е публикувана", note: "Човек одобрява текста преди публикуване", meta: "заявка → обновен сайт" },
  { id: "smyata", name: "Смята", glyph: "route", color: "#62a8ff", input: "Нови фактури чакат обработка", action: "Извлича номера, дати, доставчици и суми", output: "Данните са записани", note: "Неразчетените редове чакат счетоводител", meta: "фактури → записани данни" },
  { id: "prodava", name: "Продава", glyph: "result", color: "#c7f36b", input: "Изпратена оферта остава без отговор", action: "Изпраща одобрено напомняне след зададения срок", output: "Клиентът е отговорил", note: "Търговецът вижда разговора и поема клиента", meta: "оферта → отговор" },
] as const;
---

<div class="workshop" data-workshop data-active="vdiga">
  <div class="workshop__head">
    <div><span>Задачата влиза. Резултатът се записва.</span><strong>Виж какво прави всеки AI служител</strong></div>
    <span class="workshop__live"><i></i> избери служител</span>
  </div>

  <div class="workshop__stage" aria-live="polite">
    <div class="workshop__ambient" aria-hidden="true"></div>
    {roles.map((role, index) => (
      <article class="work-scene" data-scene={role.id} aria-hidden={index === 0 ? "false" : "true"} style={`--role:${role.color}`}>
        <div class="work-scene__incoming">
          <span class="work-scene__step">Пристига</span>
          <div class="paper paper--request">
            <span class="paper__pin"></span>
            <small>Нова работа</small>
            <strong>{role.input}</strong>
            <span class="paper__scribble"></span><span class="paper__scribble paper__scribble--short"></span>
          </div>
        </div>

        <div class="work-scene__desk">
          <span class="work-scene__step">{role.name} работи</span>
          <div class="desk-lamp" aria-hidden="true"><i></i><b></b></div>
          <div class="workstation">
            <div class="workstation__screen">
              <span class="workstation__role"><i><WorkGlyph name={role.glyph} /></i>{role.name}</span>
              <strong>{role.action}</strong>
              <div class="workstation__progress"><i></i><i></i><i></i></div>
            </div>
            <div class="workstation__base"></div>
          </div>
          <div class="work-scene__tools" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>

        <div class="work-scene__approval">
          <span class="work-scene__step">Човешка преценка</span>
          <div class="approval-note">
            <span class="approval-note__avatar">Д</span>
            <div><strong>Провери само важното</strong><small>{role.note}</small></div>
            <span class="approval-note__mark">✓</span>
          </div>
        </div>

        <div class="work-scene__result">
          <span class="work-scene__step">Готово</span>
          <div class="paper paper--result">
            <span class="paper__fold"></span>
            <small>Резултат</small>
            <strong>{role.output}</strong>
            <span class="result-stamp">свършено</span>
          </div>
        </div>

        <div class="work-scene__thread" aria-hidden="true"><span></span><span></span><span></span></div>
      </article>
    ))}
  </div>

  <div class="workshop__roles" role="group" aria-label="Избери AI служител, за да видиш начина му на работа">
    {roles.map((role, index) => (
      <button type="button" data-role={role.id} aria-pressed={index === 0 ? "true" : "false"} style={`--role:${role.color}`}>
        <span><WorkGlyph name={role.glyph} /></span><span><strong>{role.name}</strong><small>{role.meta}</small></span>
      </button>
    ))}
  </div>
</div>

<style>
  .workshop{position:relative;min-width:0;overflow:hidden;border:1px solid rgba(138,152,255,.24);border-radius:30px;background:#0b1023;box-shadow:0 55px 120px -48px rgba(0,0,0,.9),inset 0 1px rgba(255,255,255,.08)}
  .workshop::before{position:absolute;inset:0;background:linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px) 0 0/100% 28px,radial-gradient(circle at 72% 15%,rgba(143,124,255,.14),transparent 34%),radial-gradient(circle at 24% 80%,rgba(45,226,208,.08),transparent 30%);content:"";pointer-events:none}
  .workshop__head{position:relative;z-index:4;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:20px 22px;border-bottom:1px solid rgba(255,255,255,.09)}
  .workshop__head>div{display:grid;gap:3px}.workshop__head span{color:rgba(255,255,255,.46);font-size:13px}.workshop__head strong{color:#fff;font-size:15px}
  .workshop__live{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border:1px solid rgba(45,226,208,.2);border-radius:999px;background:rgba(45,226,208,.06);white-space:nowrap}.workshop__live i{width:6px;height:6px;border-radius:50%;background:#2de2d0;box-shadow:0 0 12px #2de2d0}
  .workshop__stage{position:relative;z-index:1;min-height:500px;overflow:hidden}.workshop__ambient{position:absolute;inset:12% 12% 4%;border-radius:50%;background:rgba(98,168,255,.09);filter:blur(70px)}
  .work-scene{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1.25fr;grid-template-rows:1fr 1fr;gap:22px;padding:42px 36px 34px;opacity:0;pointer-events:none;transform:translateY(8px);transition:opacity .35s ease,transform .45s cubic-bezier(.2,.8,.2,1)}
  .work-scene[aria-hidden="false"]{opacity:1;pointer-events:auto;transform:none}.work-scene__step{display:block;margin-bottom:11px;color:rgba(255,255,255,.4);font-size:11px;font-weight:600;letter-spacing:.02em}
  .work-scene__incoming,.work-scene__result{position:relative;z-index:2}.work-scene__desk{position:relative;z-index:2;grid-column:2;grid-row:1/3;padding-left:18px}.work-scene__approval{position:relative;z-index:3;align-self:end}
  .paper{position:relative;width:min(100%,230px);padding:20px 20px 18px;border-radius:6px 16px 8px 12px;background:#f5f0e6;color:#14192a;box-shadow:0 18px 35px -18px rgba(0,0,0,.8);transform:rotate(-1.5deg)}
  .paper::after{position:absolute;inset:6px;border:1px solid rgba(20,25,42,.07);border-radius:3px 11px 5px 8px;content:""}.paper small{display:block;margin-bottom:7px;color:#777164;font-size:10px;font-weight:600}.paper strong{position:relative;z-index:1;display:block;font-size:14px;line-height:1.35}.paper__pin{position:absolute;top:11px;right:14px;width:7px;height:7px;border-radius:50%;background:var(--role);box-shadow:0 2px 0 rgba(0,0,0,.25)}.paper__scribble{display:block;width:76%;height:2px;margin-top:13px;background:#d8d1c3}.paper__scribble--short{width:48%;margin-top:6px}
  .paper--result{margin-left:auto;background:#f7f4ec;transform:rotate(1deg)}.paper__fold{position:absolute;top:0;right:0;border-width:0 0 22px 22px;border-style:solid;border-color:transparent transparent #ded8cc transparent}.result-stamp{display:inline-block;margin-top:16px;padding:4px 7px;border:1px solid color-mix(in srgb,var(--role) 64%,#334);border-radius:4px;color:color-mix(in srgb,var(--role) 66%,#263040);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;transform:rotate(-3deg)}
  .desk-lamp{position:absolute;top:26px;right:0;width:106px;height:145px;border-right:3px solid rgba(255,255,255,.18);border-top:3px solid rgba(255,255,255,.18);border-radius:0 56px 0 0}.desk-lamp i{position:absolute;top:-12px;left:-5px;width:42px;height:22px;border-radius:20px 20px 6px 6px;background:color-mix(in srgb,var(--role) 68%,#fff);box-shadow:0 18px 40px var(--role);transform:rotate(-12deg)}.desk-lamp b{position:absolute;right:-7px;bottom:-7px;width:12px;height:12px;border-radius:50%;background:#303750}
  .workstation{position:relative;margin-top:28px}.workstation__screen{position:relative;z-index:1;min-height:215px;padding:25px 24px;border:1px solid color-mix(in srgb,var(--role) 30%,rgba(255,255,255,.12));border-radius:18px;background:linear-gradient(145deg,color-mix(in srgb,var(--role) 9%,#151b34),#10162c);box-shadow:0 25px 55px -28px #000,inset 0 1px rgba(255,255,255,.07)}.workstation__screen::after{position:absolute;right:18px;bottom:16px;width:86px;height:56px;border-right:1px solid color-mix(in srgb,var(--role) 34%,transparent);border-bottom:1px solid color-mix(in srgb,var(--role) 34%,transparent);content:"";transform:skew(-14deg)}
  .workstation__role{display:flex;align-items:center;gap:9px;color:var(--role);font-size:12px;font-weight:700}.workstation__role i{display:grid;width:30px;height:30px;place-items:center}.workstation__screen>strong{display:block;max-width:260px;margin-top:30px;color:#fff;font-size:19px;line-height:1.28}.workstation__progress{display:flex;gap:6px;margin-top:24px}.workstation__progress i{width:31px;height:4px;border-radius:999px;background:var(--role);box-shadow:0 0 9px color-mix(in srgb,var(--role) 55%,transparent)}.workstation__progress i:nth-child(2){opacity:.55}.workstation__progress i:nth-child(3){opacity:.2}.workstation__base{width:72%;height:12px;margin:0 auto;border-radius:0 0 50% 50%;background:#252c44;box-shadow:0 9px 18px rgba(0,0,0,.4)}
  .work-scene__tools{position:absolute;right:8px;bottom:12px;display:flex;align-items:flex-end;gap:5px}.work-scene__tools i{display:block;width:5px;height:44px;border-radius:3px;background:#ff8d72;transform:rotate(7deg)}.work-scene__tools i:nth-child(2){height:39px;background:#62a8ff;transform:rotate(-3deg)}.work-scene__tools i:nth-child(3){height:48px;background:#c7f36b;transform:rotate(3deg)}
  .approval-note{display:grid;grid-template-columns:30px 1fr 24px;align-items:center;gap:10px;width:min(100%,280px);padding:12px;border:1px solid rgba(255,141,114,.25);border-radius:14px;background:rgba(32,23,37,.9);box-shadow:0 15px 30px -20px #000}.approval-note__avatar{display:grid;width:30px;height:30px;place-items:center;border-radius:50%;background:#ff8d72;color:#201522;font-size:11px;font-weight:700}.approval-note div{display:grid;gap:2px}.approval-note strong{color:#fff;font-size:11px}.approval-note small{color:rgba(255,255,255,.45);font-size:9px;line-height:1.3}.approval-note__mark{display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:rgba(199,243,107,.12);color:#c7f36b;font-size:12px}
  .work-scene__thread{position:absolute;inset:65px 70px 48px;z-index:0;border:1px dashed color-mix(in srgb,var(--role) 22%,transparent);border-radius:48% 52% 45% 55%}.work-scene__thread span{position:absolute;width:7px;height:7px;border-radius:50%;background:var(--role);box-shadow:0 0 14px var(--role);animation:thread-pulse 3.8s ease-in-out infinite}.work-scene__thread span:first-child{top:-4px;left:20%}.work-scene__thread span:nth-child(2){right:-4px;top:42%;animation-delay:1.2s}.work-scene__thread span:nth-child(3){bottom:-4px;left:24%;animation-delay:2.4s}
  .workshop__roles{position:relative;z-index:4;display:grid;grid-template-columns:repeat(5,1fr);gap:7px;padding:0 14px 14px}.workshop__roles button{display:grid;min-width:0;gap:7px;justify-items:center;padding:10px 5px;border:1px solid rgba(255,255,255,.08);border-radius:14px;background:rgba(255,255,255,.035);color:rgba(255,255,255,.43);cursor:pointer;transition:border-color .2s,background .2s,color .2s,transform .2s}.workshop__roles button:hover{transform:translateY(-2px);color:#fff}.workshop__roles button[aria-pressed="true"]{border-color:color-mix(in srgb,var(--role) 42%,transparent);background:color-mix(in srgb,var(--role) 11%,rgba(255,255,255,.025));color:var(--role)}.workshop__roles button>span:first-child{display:grid;width:28px;height:28px;place-items:center}.workshop__roles button>span:last-child{display:grid;min-width:0;gap:2px}.workshop__roles strong{font-size:12px}.workshop__roles small{overflow:hidden;color:rgba(255,255,255,.34);font-size:9px;text-overflow:ellipsis;white-space:nowrap}
  @keyframes thread-pulse{0%,100%{opacity:.25;transform:scale(.7)}50%{opacity:1;transform:scale(1)}}
  @media(max-width:700px){.workshop__head{padding:16px}.workshop__live{display:none}.workshop__stage{min-height:520px}.work-scene{grid-template-columns:1fr 1fr;grid-template-rows:auto 1fr auto;gap:15px;padding:24px 16px}.work-scene__incoming{grid-column:1}.work-scene__result{grid-column:2}.work-scene__desk{grid-column:1/3;grid-row:2;padding:0 28px}.work-scene__approval{grid-column:1/3;grid-row:3}.paper{padding:14px 13px;min-height:112px}.paper strong{font-size:12px}.workstation{margin-top:5px}.workstation__screen{min-height:154px;padding:18px}.workstation__screen>strong{max-width:210px;margin-top:17px;font-size:15px}.workstation__progress{margin-top:15px}.desk-lamp{top:0;right:8px;height:105px}.work-scene__tools{display:none}.approval-note{margin:auto}.work-scene__thread{inset:62px 36px 66px}.workshop__roles{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 12px 12px}.workshop__roles button{min-width:105px;scroll-snap-align:start}.workshop__roles small{display:none}}
  @media(prefers-reduced-motion:reduce){.work-scene,.workshop__roles button{transition:none}.work-scene__thread span{animation:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-workshop]").forEach((workshop) => {
    const buttons = Array.from(workshop.querySelectorAll<HTMLButtonElement>("[data-role]"));
    const scenes = Array.from(workshop.querySelectorAll<HTMLElement>("[data-scene]"));
    buttons.forEach((button) => button.addEventListener("click", () => {
      const role = button.dataset.role || "vdiga";
      workshop.dataset.active = role;
      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item.dataset.role === role)));
      scenes.forEach((scene) => scene.setAttribute("aria-hidden", String(scene.dataset.scene !== role)));
    }));
  });
</script>
