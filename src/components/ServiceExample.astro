---
interface Props { role: string; }
const { role } = Astro.props;
const examples: Record<string,{title:string;before:string;after:string;label:string;result:string}> = {
 vdiga:{title:'Клиентът получава отговор. Екипът продължава работа.',before:'Екипът е с клиент. Телефонът звъни.',after:'Vdiga отговаря и проверява свободните часове.',label:'Резултат',result:'Часът е записан в свързания календар. Екипът получава обобщение.'},
 pishe:{title:'Бизнесът се променя. Сайтът не остава назад.',before:'В одобрения източник има ново работно време.',after:'Pishe прилага предварително разрешената актуализация.',label:'Резултат',result:'Актуална страница и запис на промяната. Останалите редакции чакат одобрение.'},
 pomaga:{title:'Заявката стига до човека, който ще я поеме.',before:'Ново запитване пристига по имейл.',after:'Pomaga записва данните и създава задача по вашите правила.',label:'Резултат',result:'Отговорникът вижда задачата и нужната информация. Не преписва имейла.'},
};
const item=examples[role] || examples.pishe;
---
<div class="service-example">
  <header><span>Примерен сценарий · не е активност на живо</span><strong>{item.title}</strong></header>
  <div class="service-example__flow"><p><small>Преди</small>{item.before}</p><p><small>Със служителя</small>{item.after}</p></div>
  <footer><strong>{item.label}</strong><span>{item.result}</span></footer>
</div>
<style>
.service-example{background:#fff;border:1px solid #dce1e8;border-radius:12px;padding:22px;color:#171c26;text-align:left;font-size:.9375rem;line-height:1.55}
.service-example header>span{display:block;font-size:.75rem;color:#596271;margin-bottom:10px}.service-example header>strong{display:block;font-size:1.125rem;font-weight:500;line-height:1.4}.service-example__flow{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:18px}.service-example__flow p{margin:0!important;display:block!important;font-size:.875rem!important;color:#394352!important}.service-example small{display:block;color:#596271;font-size:.75rem;margin-bottom:5px}.service-example footer{display:flex;gap:18px;border-top:1px solid #dce1e8;padding-top:14px;margin-top:18px;font-size:.875rem}.service-example footer strong{font-weight:500}.service-example footer span{color:#394352}
@media(max-width:600px){.service-example{padding:18px}.service-example__flow{gap:16px}.service-example footer{display:block}.service-example footer span{display:block;margin-top:5px}}
</style>
