---
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import { pricingFaqs, site } from "../data/site";
import { faqSchema, breadcrumbSchema } from "../data/schema";

const employees = [
  {
    name: "Vdiga",
    role: "AI рецепционист",
    accent: "#0b7665",
    soft: "#dff5ee",
    question: "Телефонът звъни, докато всички са заети?",
    answer: "Vdiga приема входящите обаждания, отговаря с одобрената от вас информация и записва часове или заявки.",
    measure: "Цената зависи от минутите входящи разговори.",
    plans: [
      { name: "Старт", price: "97 €", detail: "120 минути месечно" },
      { name: "Бизнес", price: "297 €", detail: "500 минути месечно" },
      { name: "Над 500 минути", price: "По оферта", detail: "За повече линии или обекти" },
    ],
    href: "/sluzhiteli/vdiga/#planove",
    cta: "Вижте плановете на Vdiga",
  },
  {
    name: "Pishe",
    role: "AI уеб мениджър",
    accent: "#a84629",
    soft: "#ffebe3",
    question: "Цените и услугите на сайта ви остават стари?",
    answer: "Pishe обновява сайта, пише нови страници и поддържа каталога. Важните промени се публикуват след ваше одобрение.",
    measure: "Избирате според това колко работа се трупа по сайта.",
    plans: [
      { name: "Актуализации", price: "197 €", detail: "Цени, услуги, оферти и контакти" },
      { name: "Съдържание и SEO", price: "297 €", detail: "Нова или пренаписана страница всяка седмица" },
      { name: "Каталог и съдържание", price: "597 €", detail: "За много продукти и постоянни промени" },
    ],
    href: "/sluzhiteli/pishe/#planove",
    cta: "Вижте плановете на Pishe",
  },
  {
    name: "Pomaga",
    role: "AI оперативен асистент",
    accent: "#6b56c9",
    soft: "#ece8ff",
    question: "Някой преписва едни и същи данни всеки ден?",
    answer: "Pomaga прехвърля договорените данни между имейл, CRM, таблици и задачи. Спира за човек преди плащане или друга необратима стъпка.",
    measure: "Цената зависи от броя стъпки и системи в работата.",
    plans: [
      { name: "Една задача", price: "297 €", detail: "Един повтарящ се път от начало до край" },
      { name: "Работен поток", price: "597 €", detail: "Няколко свързани стъпки и хора" },
      { name: "Операции", price: "По оферта", detail: "За повече процеси, обем или нестандартни системи" },
    ],
    href: "/sluzhiteli/pomaga/#planove",
    cta: "Вижте плановете на Pomaga",
  },
];
---
<BaseLayout
  title="Цени на AI служителите | Raboti"
  description="Vdiga от 97 €, Pishe от 197 € и Pomaga от 297 € месечно. Сравнете плановете и вижте каква работа поема всеки AI служител."
  canonical="/ceni/"
  image="/og/ceni.svg"
  darkOpener={true}
  schema={[faqSchema(pricingFaqs),breadcrumbSchema([{name:"Raboti",url:site.url},{name:"Цени",url:`${site.url}/ceni/`}])]}
>
  <section class="prices-hero">
    <div class="shell prices-hero__inner">
      <h1>Колко струва работата, която искате да спрете да вършите на ръка?</h1>
      <p>Vdiga започва от 97 €, Pishe от 197 €, а Pomaga от 297 € на месец. По-долу ще видите какво поема всеки служител и от какво зависи планът.</p>
      <a class="button button--spectrum" href="#sluzhiteli">Сравнете тримата служители <Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="prices-section" id="sluzhiteli" aria-labelledby="prices-title">
    <div class="shell">
      <header class="prices-head">
        <h2 id="prices-title">Започнете от работата, която се трупа.</h2>
        <p>Телефонните разговори, промените по сайта и прехвърлянето на данни се измерват по различен начин. Затова всеки служител има собствени планове.</p>
      </header>

      <div class="employee-prices">
        {employees.map((employee) => (
          <article class="employee-price" style={`--employee:${employee.accent};--employee-soft:${employee.soft}`}>
            <header class="employee-price__intro">
              <div>
                <p class="employee-price__role">{employee.role}</p>
                <h3>{employee.name}</h3>
              </div>
              <p class="employee-price__question">{employee.question}</p>
              <p>{employee.answer}</p>
            </header>

            <div class="employee-price__plans">
              <p class="employee-price__measure">{employee.measure}</p>
              <ol>
                {employee.plans.map((plan) => (
                  <li>
                    <div><strong>{plan.name}</strong><span>{plan.detail}</span></div>
                    <p><strong>{plan.price}</strong>{plan.price !== "По оферта" && <span>/месец</span>}</p>
                  </li>
                ))}
              </ol>
              <p class="employee-price__tax">Цените са без ДДС. Настройката се изчислява отделно.</p>
              <a class="button button--dark" href={employee.href}>{employee.cta} <Icon name="arrow-right" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="setup-section" aria-labelledby="setup-title">
    <div class="shell setup-grid">
      <div>
        <h2 id="setup-title">Преди месечната работа идва настройката.</h2>
        <p>Показаните цени са за месечната услуга. Преди да започнем, трябва да свържем служителя с телефона, сайта или програмите, които използвате, и да уговорим какво може да прави сам.</p>
      </div>
      <ol class="setup-steps">
        <li><span>1</span><div><strong>Показвате ни работата.</strong><p>Минаваме през един обичаен разговор, промяна по сайта или задача между програмите ви.</p></div></li>
        <li><span>2</span><div><strong>Получавате цена преди старта.</strong><p>Офертата отделя първоначалната настройка от месечния абонамент.</p></div></li>
        <li><span>3</span><div><strong>Записваме границите.</strong><p>Уточняваме кога служителят действа сам и кога чака одобрение от човек.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="faq-section">
    <div class="shell faq-grid">
      <div><h2>Въпроси за плащането и договора</h2><p>Ако не знаете кой план покрива работата ви, опишете я във формата. Ще ви кажем какво може да се поеме и колко ще струва преди да започнем.</p></div>
      <FAQ items={pricingFaqs}/>
    </div>
  </section>

  <section class="prices-cta">
    <div class="shell prices-cta__inner">
      <div><h2>Нужен ви е AI служител по поръчка?</h2><p>За работа извън готовите планове цената се определя след преглед на процеса, нужните връзки с вашите програми и обхвата. Получавате конкретна оферта преди да започнем.</p></div>
      <a class="button button--spectrum" href="/?agent=custom#naemi">Обсъдете вашия процес <Icon name="arrow-right" /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .prices-hero { padding: clamp(5.5rem, 11vw, 9rem) 0 clamp(4.5rem, 8vw, 7rem); color: #fff; background: radial-gradient(circle at 76% 18%, rgba(45,226,208,.16), transparent 31rem), #070a18; }
  .prices-hero__inner { display: grid; justify-items: start; }
  .prices-hero h1 { max-width: 980px; margin: 0; color: #fff; font-size: clamp(3rem, 6.5vw, 6rem); line-height: .98; letter-spacing: -.04em; text-wrap: balance; }
  .prices-hero p { max-width: 690px; margin: 2rem 0; color: rgba(255,255,255,.72); font-size: clamp(1.1rem, 1.8vw, 1.35rem); }
  .prices-section { padding: clamp(5rem, 9vw, 8rem) 0; background: #f4f1ec; }
  .prices-head { display: grid; grid-template-columns: 1.1fr .9fr; gap: 4rem; align-items: end; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .prices-head h2, .setup-grid h2, .faq-grid h2, .prices-cta h2 { margin: 0; font-size: clamp(2.5rem, 5vw, 4.75rem); line-height: 1.02; letter-spacing: -.038em; text-wrap: balance; }
  .prices-head p, .setup-grid > div > p, .faq-grid > div > p { max-width: 60ch; margin: 0; color: #686773; font-size: 1.125rem; }
  .employee-prices { display: grid; gap: 1.25rem; }
  .employee-price { display: grid; grid-template-columns: minmax(0,.82fr) minmax(0,1.18fr); overflow: hidden; border: 1px solid rgba(17,20,38,.11); border-radius: 16px; background: #fff; box-shadow: 0 24px 70px -50px rgba(25,20,50,.5); }
  .employee-price__intro { padding: clamp(1.75rem, 4vw, 3rem); background: var(--employee-soft); }
  .employee-price__role { margin: 0 0 .35rem; color: var(--employee); font-size: .8125rem; font-weight: 700; }
  .employee-price h3 { margin: 0 0 clamp(2.5rem, 6vw, 5rem); color: var(--employee); font-size: clamp(2.7rem, 5vw, 4.8rem); line-height: 1; letter-spacing: -.04em; }
  .employee-price__question { max-width: 24ch; margin: 0 0 1rem; color: #111426; font-size: clamp(1.35rem, 2vw, 1.7rem); font-weight: 700; line-height: 1.15; }
  .employee-price__intro > p:last-child { max-width: 45ch; margin: 0; color: #4f4f58; }
  .employee-price__plans { padding: clamp(1.75rem, 4vw, 3rem); }
  .employee-price__measure { margin: 0 0 1.5rem; font-weight: 700; }
  .employee-price__plans ol { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(17,20,38,.12); }
  .employee-price__plans li { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; align-items: center; padding: 1.25rem 0; border-bottom: 1px solid rgba(17,20,38,.12); }
  .employee-price__plans li div { display: grid; gap: .25rem; }
  .employee-price__plans li div span { color: #686773; font-size: .9rem; }
  .employee-price__plans li > p { display: flex; align-items: baseline; gap: .35rem; margin: 0; text-align: right; white-space: nowrap; }
  .employee-price__plans li > p strong { font-size: 1.35rem; }
  .employee-price__plans li > p span { color: #686773; font-size: .8rem; }
  .employee-price__tax { margin: 1.25rem 0; color: #686773; font-size: .86rem; }
  .setup-section { padding: clamp(5rem, 9vw, 8rem) 0; color: #fff; background: #0d1228; }
  .setup-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 8vw, 8rem); }
  .setup-grid h2 { color: #fff; }
  .setup-grid > div > p { margin-top: 1.5rem; color: rgba(255,255,255,.68); }
  .setup-steps { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(255,255,255,.13); }
  .setup-steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1.25rem; padding: 1.5rem 0; border-bottom: 1px solid rgba(255,255,255,.13); }
  .setup-steps li > span { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; color: #070a18; background: #2de2d0; font-size: .8rem; font-weight: 800; }
  .setup-steps strong { font-size: 1.15rem; }
  .setup-steps p { margin: .4rem 0 0; color: rgba(255,255,255,.68); }
  .faq-section { padding: clamp(5rem, 9vw, 8rem) 0; background: #fff; }
  .faq-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); align-items: start; }
  .faq-grid h2 { font-size: clamp(2.5rem, 4vw, 4rem); }
  .faq-grid > div > p { margin-top: 1.5rem; }
  .prices-cta { padding: clamp(4rem, 8vw, 7rem) 0; color: #fff; background: #070a18; }
  .prices-cta__inner { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; }
  .prices-cta h2 { max-width: 800px; color: #fff; }
  .prices-cta p { max-width: 650px; margin: 1.25rem 0 0; color: rgba(255,255,255,.68); }
  @media (max-width: 900px) {
    .prices-head, .employee-price, .setup-grid, .faq-grid, .prices-cta__inner { grid-template-columns: 1fr; }
    .prices-head { gap: 1.5rem; }
    .employee-price h3 { margin-bottom: 2.5rem; }
    .prices-cta__inner { justify-items: start; }
  }
  @media (max-width: 560px) {
    .prices-hero { padding-top: 4.5rem; }
    .prices-hero h1 { font-size: clamp(2.65rem, 13vw, 4rem); }
    .employee-price__plans li { grid-template-columns: 1fr; gap: .65rem; }
    .employee-price__plans li > p { text-align: left; }
    .employee-price .button { width: 100%; }
  }
</style>
