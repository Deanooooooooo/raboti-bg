---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import { pricingFaqs, site } from "../data/site";
import { faqSchema, breadcrumbSchema } from "../data/schema";
const agents = (await getCollection("agents")).sort((a,b)=>a.data.order-b.data.order);
const live = agents.filter((agent)=>agent.data.status==="live");
---
<BaseLayout
  title="Цени на AI служителите | Работи"
  description="Вдига от €49, Пише от €99 и Помага от €249 месечно. Виж какво включва всяка AI роля."
  canonical="/ceni/"
  image="/og/ceni.svg"
  schema={[faqSchema(pricingFaqs),breadcrumbSchema([{name:"Работи",url:site.url},{name:"Цени",url:`${site.url}/ceni/`}])]}
>
  <section class="page-hero"><div class="shell narrow"><p class="eyebrow">месечна цена по роли</p><h1>Плащаш за конкретни задачи, не за „AI проект“ без обхват.</h1><p>Всеки план описва какво поема служителят и какво остава извън услугата. Цената за настройка се показва преди да започнем.</p></div></section>
  <section class="section"><div class="shell pricing-grid">
    {live.map((agent) => <article class="price-card" style={`--agent:${agent.data.accent};--agent-soft:${agent.data.accentSoft}`}>
      <span class="status">AI служител</span><h2>{agent.data.name}</h2><p>{agent.data.role}</p>
      <div class="big-price"><strong>€{agent.data.price}</strong><span>на<br/>месец</span></div>
      <ul>{agent.data.features.map((feature)=><li><Icon name="check" /> {feature}</li>)}</ul>
      <a class="button" href={`/sluzhiteli/${agent.data.slug}/`}>Виж {agent.data.name}</a>
    </article>)}
  </div></section>
  <section class="section section--tint"><div class="shell split"><div><p class="eyebrow">за цените</p><h2>Без скрита работа между редовете.</h2></div><FAQ items={pricingFaqs}/></div></section>
</BaseLayout>
