---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { breadcrumbSchema } from "../../data/schema";
const posts = (await getCollection("blog")).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const fmt=(date:Date)=>new Intl.DateTimeFormat("bg-BG",{day:"numeric",month:"long",year:"numeric"}).format(date);
const workAreas = [
  {name:"Обаждания", text:"Какво може да поеме Vdiga и кога разговорът трябва да стигне до човек.", href:"/sluzhiteli/vdiga/", color:"cyan"},
  {name:"Работа по сайта", text:"Предстоят материали за цените, услугите и страниците, които все остават за после.", href:"/sluzhiteli/pishe/", color:"coral"},
  {name:"Задачи между програмите", text:"Предстоят материали за заявките, които се преписват от имейл в CRM, таблица или задача.", href:"/sluzhiteli/pomaga/", color:"violet"},
];
---
<BaseLayout title="Полезно за AI служители | Работи" description="Ръководства за пропуснати обаждания, работа по сайта и повтарящи се задачи в малкия бизнес." canonical="/blog/" image="/og/blog.svg" schema={breadcrumbSchema([{name:"Работи",url:site.url},{name:"Полезно",url:`${site.url}/blog/`}])} bodyClass="blog-index-page">
  <section class="blog-hero">
    <div class="shell blog-hero__grid">
      <div><h1>Преди да автоматизирате нещо, вижте какво всъщност трябва да свърши.</h1><p>Пишем за обажданията, промените по сайта и задачите между програмите. С примери кога AI служителят може да продължи сам и кога трябва да спре за човек.</p></div>
      <div class="blog-hero__list" aria-label="Теми в блога"><span><i class="signal signal--cyan"></i>Пропуснати обаждания</span><span><i class="signal signal--coral"></i>Работа по сайта</span><span><i class="signal signal--violet"></i>Повтарящи се задачи</span></div>
    </div>
  </section>

  <section class="blog-areas">
    <div class="shell">
      <h2>Изберете работата, която ви отнема време.</h2>
      <div class="blog-areas__grid">{workAreas.map((area)=><article class={`area area--${area.color}`}><span></span><h3>{area.name}</h3><p>{area.text}</p><a href={area.href}>Вижте служителя <Icon name="arrow-right" /></a></article>)}</div>
    </div>
  </section>

  <section class="blog-posts">
    <div class="shell">
      <div class="blog-posts__head"><h2>Как Vdiga поема телефона в различни бизнеси.</h2><p>Трите ни настоящи статии разглеждат разговорите в салон, стоматологичен кабинет и автосервиз. Не дават общи обещания за AI, а показват какво се пита, записва и предава на екипа.</p></div>
      <div class="blog-posts__grid">{posts.map((post,index)=><article class:list={["post-record",index===0&&"post-record--lead"]}><div class="post-record__meta"><span>{post.data.tags[0]}</span><time datetime={post.data.publishedAt.toISOString()}>{fmt(post.data.publishedAt)}</time></div><h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3><p>{post.data.description}</p><a class="post-record__link" href={`/blog/${post.id}/`}>Прочетете статията <Icon name="arrow-right" /></a></article>)}</div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(.blog-index-page){background:#f4f1ec;color:#111426}.blog-hero{padding:clamp(105px,12vw,174px) 0 clamp(76px,9vw,128px);background:radial-gradient(circle at 85% 12%,rgba(143,124,255,.2),transparent 31%),radial-gradient(circle at 8% 90%,rgba(45,226,208,.12),transparent 30%),#10142c;color:#fff}.blog-hero__grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.55fr);gap:clamp(54px,10vw,140px);align-items:end}.blog-hero h1{max-width:13ch;margin:0;color:#fff;font-size:clamp(3rem,5.5vw,5.6rem);line-height:1;letter-spacing:-.04em;text-wrap:balance}.blog-hero p{max-width:61ch;margin:28px 0 0;color:rgba(255,255,255,.72);font-size:1.08rem;line-height:1.62}.blog-hero__list{display:grid;border-top:1px solid rgba(255,255,255,.2)}.blog-hero__list span{display:flex;align-items:center;gap:12px;padding:18px 0;border-bottom:1px solid rgba(255,255,255,.13);color:#fff;font-weight:650}.signal{width:9px;height:9px;border-radius:50%}.signal--cyan{background:#2de2d0}.signal--coral{background:#ff8d72}.signal--violet{background:#8f7cff}
  .blog-areas{padding:clamp(76px,9vw,126px) 0;background:#f4f1ec}.blog-areas h2,.blog-posts h2{max-width:13ch;margin:0;color:#111426;font-size:clamp(2.5rem,4.5vw,4.5rem);line-height:1.03;letter-spacing:-.04em}.blog-areas__grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:clamp(48px,6vw,76px);border-top:1px solid rgba(17,20,38,.15);border-bottom:1px solid rgba(17,20,38,.15)}.area{position:relative;padding:32px 30px 36px 0}.area+.area{padding-left:30px;border-left:1px solid rgba(17,20,38,.15)}.area>span{display:block;width:10px;height:10px;margin-bottom:34px;border-radius:50%}.area--cyan>span{background:#0c8f81}.area--coral>span{background:#c45e44}.area--violet>span{background:#6856d8}.area h3{margin:0;color:#111426;font-size:1.45rem}.area p{max-width:36ch;margin:16px 0 24px;color:#686773;line-height:1.62}.area a,.post-record__link{display:inline-flex;align-items:center;gap:8px;color:#111426;font-weight:700;text-decoration:none}.area a:hover,.post-record__link:hover{text-decoration:underline;text-underline-offset:5px}.area :global(svg),.post-record :global(svg){width:17px}
  .blog-posts{padding:clamp(82px,10vw,140px) 0;background:#fff}.blog-posts__head{display:grid;grid-template-columns:1fr minmax(300px,.65fr);gap:60px;align-items:end}.blog-posts__head>p{max-width:52ch;margin:0;color:#686773;font-size:1.05rem;line-height:1.65}.blog-posts__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;margin-top:clamp(48px,7vw,82px)}.post-record{display:flex;min-height:360px;flex-direction:column;padding:clamp(26px,3vw,38px);border:1px solid rgba(17,20,38,.12);border-radius:16px;background:#f8f7f4}.post-record--lead{grid-row:span 2;min-height:740px;background:radial-gradient(circle at 88% 5%,rgba(45,226,208,.12),transparent 30%),#10142c}.post-record__meta{display:flex;justify-content:space-between;gap:20px;color:#686773;font-size:.78rem}.post-record--lead .post-record__meta{color:rgba(255,255,255,.56)}.post-record h3{max-width:19ch;margin:42px 0 18px;color:#111426;font-size:clamp(1.75rem,3vw,2.8rem);line-height:1.08;letter-spacing:-.03em}.post-record--lead h3{margin-top:auto;color:#fff;font-size:clamp(2.25rem,4vw,4.1rem)}.post-record h3 a{color:inherit;text-decoration:none}.post-record p{max-width:48ch;margin:0 0 28px;color:#686773;line-height:1.62}.post-record--lead p{color:rgba(255,255,255,.68)}.post-record__link{margin-top:auto}.post-record--lead .post-record__link{color:#fff}
  @media(max-width:880px){.blog-hero__grid,.blog-posts__head{grid-template-columns:1fr}.blog-hero__list{max-width:620px}.blog-areas__grid{grid-template-columns:1fr}.area{padding:26px 0}.area+.area{padding-left:0;border-top:1px solid rgba(17,20,38,.15);border-left:0}.area>span{margin-bottom:18px}.blog-posts__grid{grid-template-columns:1fr}.post-record--lead{grid-row:auto;min-height:520px}}
  @media(max-width:600px){:global(.blog-index-page main .shell){width:calc(100% - 32px)}.blog-hero{padding-top:96px}.blog-hero h1{max-width:100%;font-size:clamp(2.4rem,11vw,3.3rem);overflow-wrap:break-word;text-wrap:pretty}.post-record,.post-record--lead{min-height:0}.post-record--lead h3{margin-top:90px}}
</style>
