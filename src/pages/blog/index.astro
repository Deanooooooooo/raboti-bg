---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import {site} from '../../data/site';
import {breadcrumbSchema} from '../../data/schema';
import '../../styles/studio.css';
import '../../styles/studio-secondary.css';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const featured=posts.find(p=>p.id==='kakvo-e-ai-sluzhitel')||posts[0];
const fmt=(d:Date)=>new Intl.DateTimeFormat('bg-BG',{day:'numeric',month:'long',year:'numeric'}).format(d);
const category=(id:string)=>id.includes('sait')?'Сайт и съдържание':id.includes('cena')?'Цени':'AI служители';
const categories=[...new Set(posts.map(p=>category(p.id)))];
---
<BaseLayout title="Блог за AI служители, автоматизация и сайтове | Raboti" description="Как да изберете AI служител, какво влиза в цената и как да възложите поддръжката на сайта. Статии и ръководства от екипа на Raboti." canonical="/blog/" image="/og/blog.svg" bodyClass="studio studio-secondary journal-page" schema={breadcrumbSchema([{name:'Raboti',url:site.url},{name:'Блог',url:`${site.url}/blog/`}])}>
<header class="journal-head shell">
 <h1>Преди да възложите<br/><span>работата на AI.</span></h1>
 <p>Какво може да поеме един AI служител, как се определя цената и откъде да започнете. Статии от екипа, който изгражда Raboti.</p>
</header>
<section class="journal-opening shell" aria-label="Откъде да започнете">
 {featured && <article class="journal-feature">
  <div class="journal-meta"><span>{category(featured.id)}</span><time datetime={featured.data.publishedAt.toISOString()}>{fmt(featured.data.publishedAt)}</time></div>
  <h2><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h2>
  <p>{featured.data.description}</p>
  <a class="reading-action" href={`/blog/${featured.id}/`}>Прочетете статията <Icon name="arrow-right"/></a>
 </article>}
 <aside class="journal-paths">
  <h2>Какво обмисляте?</h2>
  <a href="/blog/ai-sluzhitel-cena-i-nastroyka/"><span>Да предвидите разходите<strong>Цена и обхват</strong></span><Icon name="arrow-right"/></a>
  <a href="/polezno/seo-geo/"><span>Да развиете сайта си<strong>Google и AI отговори</strong></span><Icon name="arrow-right"/></a>
  <a href="/sluzhiteli/"><span>Да намерите кой да поеме работата<strong>Сравнете служителите</strong></span><Icon name="arrow-right"/></a>
 </aside>
</section>
<section class="journal-library shell" aria-labelledby="library-title">
 <div class="journal-library-head"><h2 id="library-title">Всички статии</h2><p data-result-count aria-live="polite">{posts.length} статии</p></div>
 <div class="journal-filters" role="group" aria-label="Филтрирайте по тема"><button type="button" data-topic="Всички" aria-pressed="true">Всички</button>{categories.map(c=><button type="button" data-topic={c} aria-pressed="false">{c}</button>)}</div>
 <div class="journal-list">
 {posts.map(p=><article class="journal-entry" data-category={category(p.id)}>
   <div class="journal-meta"><span>{category(p.id)}</span><time datetime={p.data.publishedAt.toISOString()}>{fmt(p.data.publishedAt)}</time></div>
   <div><h3><a href={`/blog/${p.id}/`}>{p.data.title}</a></h3><p>{p.data.description}</p><span class="journal-author">{p.data.author}</span></div>
   <a class="reading-arrow" href={`/blog/${p.id}/`} aria-label={`Прочетете: ${p.data.title}`}><Icon name="arrow-right"/></a>
 </article>)}
 </div>
</section>
<aside class="journal-close shell"><div><h2>Търсите AI рецепционист?</h2><p>Ще намерите примерни разговори, записване на часове и приложения по отрасли на сайта на Vdiga.</p></div><a class="button" href="https://vdiga.bg/">Разгледайте Vdiga <Icon name="arrow-right"/></a></aside>
</BaseLayout>
<script>
const controls=document.querySelectorAll<HTMLButtonElement>('[data-topic]');
controls.forEach(control=>control.addEventListener('click',()=>{
 const selected=control.dataset.topic;let count=0;
 controls.forEach(b=>b.setAttribute('aria-pressed',String(b===control)));
 document.querySelectorAll<HTMLElement>('[data-category]').forEach(entry=>{entry.hidden=selected!=='Всички'&&entry.dataset.category!==selected;if(!entry.hidden)count++;});
 const label=document.querySelector('[data-result-count]');if(label)label.textContent=`${count} ${count===1?'статия':'статии'}`;
}));
</script>
