---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { breadcrumbSchema } from "../data/schema";
import { site } from "../data/site";
import {
  siGoogle,
  siGmail,
  siGooglecalendar,
  siHubspot,
  siWordpress,
  siWoocommerce,
  siCalendly,
  siCaldotcom,
  siSlack,
} from "simple-icons";

const integrations = [
  { name: "Google Workspace", icon: siGoogle, color: "#4285F4", y: 11 },
  { name: "Gmail", icon: siGmail, color: `#${siGmail.hex}`, y: 19 },
  { name: "HubSpot", icon: siHubspot, color: `#${siHubspot.hex}`, y: 27 },
  { name: "Google Calendar", icon: siGooglecalendar, color: `#${siGooglecalendar.hex}`, y: 35 },
  { name: "WordPress", icon: siWordpress, color: `#${siWordpress.hex}`, y: 43 },
  { name: "WooCommerce", icon: siWoocommerce, color: `#${siWoocommerce.hex}`, y: 51 },
  { name: "Calendly", icon: siCalendly, color: `#${siCalendly.hex}`, y: 59 },
  { name: "Cal.com", icon: siCaldotcom, color: `#${siCaldotcom.hex}`, y: 67 },
  { name: "Slack", icon: siSlack, color: `#${siSlack.hex}`, y: 75 },
  { name: "API / webhooks", icon: null, color: "#6B56C9", y: 83 },
];

const agents = [
  { name: "Vdiga", role: "Проверява календара и записва часа", image: "/assets/employee-vdiga-gloria-v1.webp", color: "#0b7665", soft: "#dff5ee", top: 19 },
  { name: "Pomaga", role: "Мести данните между имейл, таблици и CRM", image: "/assets/employee-pomaga-v1.webp", color: "#6b56c9", soft: "#ece8ff", top: 41 },
  { name: "Pishe", role: "Качва одобрените промени в сайта", image: "/assets/employee-pishe-v1.webp", color: "#a84629", soft: "#ffebe3", top: 63 },
];

const schemas = breadcrumbSchema([
  { name: "Raboti", url: site.url },
  { name: "Интеграции", url: `${site.url}/integracii/` },
]);
---

<BaseLayout title="Raboti се свързва с програмите, които ползвате" description="Покажете ни каква работа местите на ръка между имейл, календар, CRM и сайт. Ние настройваме и тестваме връзката вместо вас." canonical="/integracii/" image="/og/home.svg" schema={schemas} bodyClass="integrations-c">
  <section class="switchboard-hero">
    <div class="switchboard" aria-hidden="true">
      <div class="switchboard__cap"><img src="/assets/logo-mark.svg" alt="" /></div>
      <div class="switchboard__track"></div>
      {integrations.map((item) => (
        <div class="plug" style={`--y:${item.y}%;--brand:${item.color}`}>
          <span class="plug__logo">
            {item.icon ? <svg viewBox="0 0 24 24" role="img" aria-label={item.name}><path d={item.icon.path} /></svg> : <b>{`{ }`}</b>}
          </span>
          <span class="plug__lead"><i></i></span>
        </div>
      ))}
    </div>

    <div class="agent-lines" aria-hidden="true">
      {agents.map((agent) => <span style={`--top:${agent.top}%;--agent:${agent.color}`}></span>)}
    </div>

    <div class="agents">
      {agents.map((agent) => (
        <article class="agent" style={`--top:${agent.top}%;--agent:${agent.color};--soft:${agent.soft}`}>
          <div class="agent__portrait"><img src={agent.image} alt={`${agent.name}, AI служител на Raboti`} width="720" height="960" /></div>
          <div class="agent__name"><i aria-hidden="true"></i><div><strong>{agent.name}</strong><small>{agent.role}</small></div></div>
        </article>
      ))}
    </div>

    <div class="hero-copy">
      <h1>Програмите<br />са ваши.<br />Свързването<br />е наша работа.</h1>
      <p>Показвате ни как работите сега и какво искате да поеме служителят. Ние го свързваме с нужните програми, проверяваме всяка стъпка и го пускаме да работи.</p>
      <a class="connect-button" href="#kak-raboti">Вижте какво поема <Icon name="arrow-down" /></a>
    </div>
  </section>

  <section class="flow-section" id="kak-raboti">
    <div class="continuing-spine" aria-hidden="true"></div>
    <div class="content-column">
      <h2>Една задача влиза. Свършената работа излиза.</h2>
      <div class="flow-board">
        <div class="flow-list">
          <span>Пристига</span>
          <p><svg viewBox="0 0 24 24"><path d={siCalendly.path} /></svg> Клиент иска час</p>
          <p><svg viewBox="0 0 24 24"><path d={siGmail.path} /></svg> По имейл идва нов контакт</p>
          <p><svg viewBox="0 0 24 24"><path d={siWordpress.path} /></svg> Одобрявате промяна по сайта</p>
          <p><svg viewBox="0 0 24 24"><path d={siWoocommerce.path} /></svg> В магазина влиза поръчка</p>
        </div>
        <div class="flow-hub"><img src="/assets/logo-mark.svg" alt="Raboti" /></div>
        <div class="flow-list flow-list--done">
          <span>Готово</span>
          <p><img class="flow-agent" style="--mini:#dff5ee" src="/assets/employee-vdiga-gloria-v1.webp" alt="" /> Vdiga записва часа в календара</p>
          <p><img class="flow-agent" style="--mini:#ece8ff" src="/assets/employee-pomaga-v1.webp" alt="" /> Pomaga добавя контакта в CRM</p>
          <p><img class="flow-agent" style="--mini:#ffebe3" src="/assets/employee-pishe-v1.webp" alt="" /> Pishe качва промяната в WordPress</p>
          <p><img class="flow-agent" style="--mini:#ece8ff" src="/assets/employee-pomaga-v1.webp" alt="" /> Pomaga записва поръчката</p>
        </div>
      </div>
    </div>
  </section>

  <section class="result-section">
    <div class="continuing-spine" aria-hidden="true"></div>
    <div class="content-column">
      <h2>Кой служител с какво се свързва.</h2>
      <div class="result-grid">
        <article><h3 style="--c:#0b7665"><img class="result-agent" style="--mini:#dff5ee" src="/assets/employee-vdiga-gloria-v1.webp" alt="" /> Vdiga</h3><p>Google Calendar</p><p>Microsoft Outlook</p><p>Calendly</p><p>Cal.com</p></article>
        <article><h3 style="--c:#6b56c9"><img class="result-agent" style="--mini:#ece8ff" src="/assets/employee-pomaga-v1.webp" alt="" /> Pomaga</h3><p>Gmail и Outlook</p><p>Google Sheets и Excel</p><p>HubSpot и Pipedrive</p><p>Slack</p></article>
        <article><h3 style="--c:#a84629"><img class="result-agent" style="--mini:#ffebe3" src="/assets/employee-pishe-v1.webp" alt="" /> Pishe</h3><p>WordPress</p><p>WooCommerce</p><p>Google Drive</p><p>Microsoft OneDrive</p></article>
        <article><h3 style="--c:#57A87A">Ползвате друга?</h3><p>Изпращате ни името ѝ</p><p>Проверяваме дали има API</p><p>Казваме какво може да поеме Raboti</p><p>Настройваме връзката вместо вас</p></article>
      </div>
    </div>
  </section>

  <section class="access-section">
    <div class="continuing-spine" aria-hidden="true"></div>
    <div class="content-column">
      <h2>От вас искаме само<br />нужния достъп.</h2>
      <div class="access-grid">
        <article><span><svg viewBox="0 0 32 32"><path d="M11 4v9M21 4v9M7 13h18v3a9 9 0 0 1-7 8.8V29h-4v-4.2A9 9 0 0 1 7 16z" /></svg></span><h3>Вие потвърждавате</h3><p>Отваряте профила си и разрешавате връзката. Не правите сценарии и не настройвате автоматизации.</p></article>
        <article><span><svg viewBox="0 0 32 32"><path d="M16 3l10 4v8c0 7-4.2 11.3-10 14-5.8-2.7-10-7-10-14V7zM12 16l3 3 6-7" /></svg></span><h3>Ние настройваме</h3><p>Даваме на служителя само достъпа, който му трябва за уговорената работа, и тестваме връзката.</p></article>
        <article><span><svg viewBox="0 0 32 32"><circle cx="14" cy="14" r="8"/><path d="M20 20l7 7" /></svg></span><h3>Вие запазвате контрола</h3><p>Плащане, договор или публикуване чакат вашето потвърждение, когато сте го задали като правило.</p></article>
      </div>
    </div>
  </section>

  <section class="closing-section">
    <div class="closing-spine" aria-hidden="true"><div><img src="/assets/logo-mark.svg" alt="" /></div></div>
    <div class="content-column closing-copy"><h2>Коя работа местите<br />на ръка всеки ден?</h2><p>Опишете една задача и програмите, между които я прехвърляте. До един работен ден ще ви кажем дали Raboti може да я поеме и какво ще е нужно.</p><a class="connect-button connect-button--light" href="/kontakti/">Опишете задачата <Icon name="arrow-right" /></a></div>
  </section>
</BaseLayout>

<style>
  :global(.integrations-c){--spine-x:clamp(140px,19.2vw,308px);--ink:#07372e;background:#f7f7f4;color:var(--ink)}
  :global(.integrations-c main){overflow:hidden}.switchboard-hero{position:relative;min-height:920px;border-bottom:1px solid #dde2de;background:#fbfbf8}
  .switchboard{position:absolute;z-index:3;left:var(--spine-x);top:0;bottom:0;width:70px;transform:translateX(-50%)}
  .switchboard__track,.continuing-spine,.closing-spine{background:linear-gradient(90deg,#071f1a 0 12%,#264c42 12% 24%,#0a2d25 24% 45%,#557269 45% 48%,#061b16 48% 63%,#21483e 63% 87%,#071f1a 87%);box-shadow:10px 0 24px rgba(5,35,28,.18),inset 0 0 18px rgba(0,0,0,.45)}
  .switchboard__track{position:absolute;inset:0}.switchboard__track::after{position:absolute;left:50%;top:0;bottom:0;width:7px;transform:translateX(-50%);border-inline:1px solid #6b827b;background:#03140f;content:""}
  .switchboard__cap{position:absolute;z-index:4;left:50%;top:42px;display:grid;width:66px;height:76px;transform:translateX(-50%);place-items:center;border:1px solid #526d65;border-radius:10px;background:#0a3027;box-shadow:0 8px 20px rgba(0,0,0,.35)}
  .switchboard__cap img{width:33px;height:33px;filter:brightness(0) invert(1)}
  .plug{position:absolute;right:35px;top:var(--y);display:flex;align-items:center}.plug__logo{position:absolute;right:72px;display:grid;width:54px;height:54px;place-items:center;border:1px solid #e5e8e5;border-radius:11px;background:#fff;box-shadow:0 6px 16px rgba(10,35,28,.1);color:var(--brand)}.plug__logo svg{width:29px;height:29px;fill:currentColor}.plug__logo b{font:700 .8rem/1 Inter,sans-serif}.plug__lead{position:relative;width:73px;height:6px;border-radius:6px;background:#17231f;box-shadow:inset 0 0 0 1px #4b5d57}.plug__lead::before{position:absolute;left:5px;top:-3px;width:18px;height:12px;border-radius:2px;background:#263732;content:""}.plug__lead i{position:absolute;right:-4px;top:-3px;width:12px;height:12px;border-radius:50%;background:var(--brand);box-shadow:0 0 8px var(--brand)}
  .agent-lines{position:absolute;z-index:2;left:var(--spine-x);top:0;bottom:0;width:29vw}.agent-lines span{position:absolute;left:32px;top:var(--top);width:100%;height:88px;border-top:3px dotted color-mix(in srgb,var(--agent) 55%,transparent);border-radius:0 55% 0 0;transform:translateY(25px);opacity:.72}.agent-lines span:nth-child(2){width:83%;transform:translateY(12px)}.agent-lines span:nth-child(3){width:90%;transform:translateY(4px)}
  .agents{position:absolute;z-index:4;left:calc(var(--spine-x) + 12.5vw);top:0;bottom:0;width:280px}.agent{position:absolute;top:var(--top);display:flex;align-items:center;gap:18px;transform:translateY(-50%)}.agent__portrait{width:128px;height:128px;overflow:hidden;border-radius:50%;background:var(--soft);box-shadow:0 8px 22px rgba(7,55,46,.12)}.agent__portrait img{width:100%;height:100%;object-fit:cover;object-position:center 10%}.agent__name{display:flex;align-items:center;gap:10px;color:var(--agent)}.agent__name i{display:grid;width:28px;height:28px;place-items:center;border:1.5px solid currentColor;border-radius:50%}.agent__name i::after{content:"↗";font-style:normal}.agent__name strong,.agent__name small{display:block}.agent__name strong{font-size:1.08rem}.agent__name small{max-width:120px;margin-top:3px;color:#60716b;font-size:.7rem;line-height:1.25}
  .hero-copy{position:absolute;z-index:5;left:61.5%;top:92px}.hero-copy h1{max-width:440px;margin:0 0 24px;font-size:clamp(4.8rem,7.2vw,7.2rem);font-weight:700;letter-spacing:-.04em;line-height:.86}.hero-copy>p{max-width:440px;margin:0 0 26px;color:#556760;font-size:.93rem;line-height:1.55}.connect-button{display:inline-flex;min-height:52px;align-items:center;gap:26px;padding:0 24px;border-radius:7px;background:#07372e;color:#fff;font-size:.84rem;font-weight:650;box-shadow:0 8px 18px rgba(7,55,46,.16)}.connect-button :global(svg){width:16px}
  .flow-section,.result-section,.access-section{position:relative;border-bottom:1px solid #dde2de;background:#fbfbf8}.continuing-spine,.closing-spine{position:absolute;left:var(--spine-x);top:0;bottom:0;width:70px;transform:translateX(-50%)}.content-column{width:min(900px,calc(100% - var(--spine-x) - 90px));margin-left:max(calc(var(--spine-x) + 100px),calc((100% - 700px)/2));padding:72px 0}.content-column h2{margin:0 0 46px;font-size:2rem;letter-spacing:-.03em}
  .flow-board{display:grid;grid-template-columns:1fr 118px 1fr;align-items:center}.flow-list{border:1px solid #dfe3df;border-radius:7px;background:#fff;box-shadow:0 8px 24px rgba(10,35,28,.06)}.flow-list>span{display:block;padding:0 10px 14px;border:0;background:#fbfbf8;transform:translateY(-30px);font-size:.68rem;font-weight:700;text-transform:uppercase}.flow-list p{display:flex;align-items:center;gap:12px;min-height:48px;margin:0;padding:0 18px;border-top:1px solid #e8eae8;color:#35443f;font-size:.78rem}.flow-list p:first-of-type{border-top:0}.flow-list svg{width:20px;height:20px;fill:#4285f4}.flow-list p:nth-of-type(2) svg{fill:#5e5e5e}.flow-list p:nth-of-type(3) svg{fill:#ff5c35}.flow-list p:nth-of-type(4) svg{fill:#006bff}.flow-list p:nth-of-type(5) svg{fill:#4a154b}.flow-list i{display:grid;width:25px;height:25px;place-items:center;border-radius:7px;background:var(--i);color:#fff;font-style:normal}.flow-hub{position:relative;display:grid;place-items:center}.flow-hub::before{position:absolute;z-index:-1;left:-20px;right:-20px;height:1px;background:#b8c5c0;content:""}.flow-hub img{width:58px;height:58px;padding:15px;border-radius:50%;background:#07372e;filter:brightness(0) invert(1)}
  .result-section{background:#f8f8f5}.result-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #d7dcda}.result-grid article{padding:24px 22px 8px 0;border-right:1px solid #d7dcda}.result-grid article+article{padding-left:22px}.result-grid article:last-child{border-right:0}.result-grid h3{display:flex;align-items:center;gap:8px;margin:0 0 18px;padding-bottom:14px;border-bottom:2px solid color-mix(in srgb,var(--c,#07372e) 45%,transparent);font-size:.9rem}.result-grid h3 i{display:grid;width:26px;height:26px;place-items:center;border:1px solid var(--c);border-radius:50%;color:var(--c);font-style:normal}.result-grid p{margin:0 0 12px;color:#34443e;font-size:.76rem}
  .access-grid{display:grid;grid-template-columns:repeat(3,1fr)}.access-grid article{padding-right:34px}.access-grid article+article{padding-left:34px;border-left:1px solid #d7dcda}.access-grid span{display:grid;width:64px;height:64px;margin-bottom:22px;place-items:center;border-radius:50%;background:#e3f3e9}.access-grid article:nth-child(2) span{background:#e8f0ff}.access-grid article:nth-child(3) span{background:#f1eafd}.access-grid svg{width:31px;height:31px;fill:none;stroke:#07372e;stroke-width:1.5}.access-grid h3{margin:0 0 9px;font-size:.9rem}.access-grid p{max-width:220px;margin:0;color:#5d6b66;font-size:.78rem;line-height:1.5}
  .closing-section{position:relative;min-height:310px;background:#07372e;color:#fff}.closing-spine{box-shadow:10px 0 24px rgba(0,0,0,.25)}.closing-spine>div{position:absolute;left:50%;top:50%;display:grid;width:72px;height:82px;transform:translate(-50%,-50%);place-items:center;border:1px solid #536f67;border-radius:10px;background:#082b24}.closing-spine img{width:34px;filter:brightness(0) invert(1)}.closing-copy{padding-top:58px}.closing-copy h2{margin-bottom:16px;color:#fff;font-size:2.5rem}.closing-copy p{margin:0 0 24px;color:#c8d6d2}.connect-button--light{background:#fff;color:#07372e;box-shadow:none}
  @media(max-width:1050px){:global(.integrations-c){--spine-x:135px}.agents{left:215px}.hero-copy{left:60%;}.hero-copy h1{font-size:5.2rem}.agent__portrait{width:105px;height:105px}.agent-lines{width:27vw}.content-column{width:calc(100% - 260px);margin-left:230px}}
  @media(max-width:760px){:global(.integrations-c){--spine-x:38px}.switchboard-hero{min-height:980px}.switchboard,.continuing-spine,.closing-spine{width:44px}.switchboard__cap{top:24px;width:42px;height:54px}.switchboard__cap img{width:24px}.plug{display:none}.agents{left:72px;width:auto}.agent{gap:10px}.agent:nth-child(1){top:16%!important}.agent:nth-child(2){top:31%!important}.agent:nth-child(3){top:46%!important}.agent__portrait{width:82px;height:82px}.agent__name small{max-width:100px}.agent-lines{left:38px;width:150px}.agent-lines span:nth-child(1){top:16%!important}.agent-lines span:nth-child(2){top:31%!important}.agent-lines span:nth-child(3){top:46%!important}.hero-copy{left:72px;top:560px}.hero-copy h1{font-size:3.9rem;line-height:.9}.content-column{width:auto;margin-left:0;padding:64px 20px 64px 78px}.content-column h2{font-size:1.75rem}.flow-board{grid-template-columns:1fr}.flow-hub{height:88px}.flow-hub::before{top:-10px;bottom:-10px;left:50%;right:auto;width:1px;height:auto}.result-grid,.access-grid{grid-template-columns:1fr 1fr}.result-grid article:nth-child(2){border-right:0}.result-grid article:nth-child(3){padding-left:0}.access-grid article{padding:0 20px 30px 0}.access-grid article+article{padding-left:20px}.access-grid article:nth-child(3){padding-top:30px;padding-left:0;border-left:0;border-top:1px solid #d7dcda}.closing-section{min-height:380px}.closing-copy{padding-top:60px}.closing-copy h2{font-size:2.2rem}}
  @media(max-width:430px){.result-grid{grid-template-columns:1fr}.result-grid article,.result-grid article+article{padding:20px 0;border-right:0;border-bottom:1px solid #d7dcda}.access-grid{grid-template-columns:1fr}.access-grid article,.access-grid article+article{padding:24px 0;border-left:0;border-top:1px solid #d7dcda}.access-grid article:first-child{border-top:0}.hero-copy h1{font-size:3.55rem}}
  @media(min-width:1051px){.switchboard-hero{min-height:820px}.agent__portrait{width:145px;height:145px}.agent-lines span{border-top-width:4px;opacity:.92;filter:drop-shadow(0 0 3px color-mix(in srgb,var(--agent) 35%,transparent))}}
  @media(max-width:760px){:global(.integrations-c){--spine-x:56px}.switchboard-hero{min-height:1050px}.plug{display:flex;right:auto;left:22px}.plug__lead{width:28px;height:4px}.plug__lead::before{display:none}.plug__lead i{top:-2px;width:8px;height:8px}.plug__logo{right:auto;left:30px;width:34px;height:34px;border-radius:8px}.plug__logo svg{width:19px;height:19px}.plug__logo b{font-size:.56rem}.agents{left:136px}.agent:nth-child(1){top:17%!important}.agent:nth-child(2){top:33%!important}.agent:nth-child(3){top:49%!important}.agent__portrait{width:76px;height:76px}.agent__name small{max-width:92px}.agent-lines{left:56px;width:118px}.agent-lines span:nth-child(1){top:17%!important}.agent-lines span:nth-child(2){top:33%!important}.agent-lines span:nth-child(3){top:49%!important}.hero-copy{left:116px;right:18px;top:635px}.hero-copy>p{max-width:none;font-size:.88rem}.content-column{padding-left:96px}.closing-copy{padding-left:96px}}
  .hero-copy{right:clamp(28px,5vw,80px)}.hero-copy h1{max-width:560px;font-size:clamp(4.2rem,5.5vw,5.4rem);line-height:.9}.hero-copy>p{max-width:500px}
  @media(max-width:1050px){.hero-copy h1{font-size:4.2rem}}
  @media(max-width:760px){.hero-copy{right:auto;width:calc(100vw - 134px);max-width:256px}.hero-copy h1{max-width:100%;font-size:2.2rem;letter-spacing:-.03em;line-height:.96}.hero-copy>p{max-width:100%;overflow-wrap:anywhere}.content-column{box-sizing:border-box;width:100vw;max-width:100vw;padding-right:16px}.content-column h2{max-width:260px;font-size:1.5rem;line-height:1.08;overflow-wrap:anywhere}}
  .flow-agent,.result-agent{display:block;flex:0 0 auto;object-fit:cover;object-position:center top;background:var(--mini)}.flow-agent{width:31px;height:31px;border-radius:50%}.result-agent{width:36px;height:36px;border-radius:50%}
</style>
