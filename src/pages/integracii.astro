---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/studio.css";
import Icon from "../components/Icon.astro";
import { breadcrumbSchema } from "../data/schema";
import { site } from "../data/site";
import { siGoogle, siGmail, siGooglecalendar, siHubspot, siWordpress, siWoocommerce, siCalendly, siCaldotcom, siSlack } from "simple-icons";
const tools = [
 {name:"Google Calendar",icon:siGooglecalendar,roles:"vdiga",use:"Проверка на свободни часове и записване в календара.",category:"Календар"},
 {name:"Microsoft Outlook",icon:null,roles:"vdiga pomaga",use:"Часовете и входящите писма стават част от уговорения процес.",category:"Имейл и календар"},
 {name:"Calendly",icon:siCalendly,roles:"vdiga",use:"Записване според наличните часове и правилата ви.",category:"Резервации"},
 {name:"Cal.com",icon:siCaldotcom,roles:"vdiga",use:"Работа с графика за срещи и записвания.",category:"Резервации"},
 {name:"WordPress",icon:siWordpress,roles:"pishe",use:"Обновяване на страници и съдържание по вашите правила.",category:"Сайт"},
 {name:"WooCommerce",icon:siWoocommerce,roles:"pishe pomaga",use:"Промени в магазина и обработване на данни за поръчки.",category:"Онлайн магазин"},
 {name:"Google Drive",icon:siGoogle,roles:"pishe",use:"Материалите за сайта идват от файловете, които споделяте.",category:"Файлове"},
 {name:"Microsoft OneDrive",icon:null,roles:"pishe",use:"Достъп до определените документи и материали за сайта.",category:"Файлове"},
 {name:"Gmail",icon:siGmail,roles:"pomaga",use:"От входящо запитване до контакт или задача за екипа.",category:"Имейл"},
 {name:"Google Sheets / Excel",icon:null,roles:"pomaga",use:"Подреждане на данни и подготовка на справки без преписване.",category:"Таблици"},
 {name:"HubSpot / Pipedrive",icon:siHubspot,roles:"pomaga",use:"Добавяне на контакти и актуализиране на клиентски записи.",category:"CRM"},
 {name:"Slack",icon:siSlack,roles:"pomaga",use:"Важната информация стига до съответния човек в екипа.",category:"Комуникация"},
];
const roles=[{id:"all",name:"Всички",label:"програми"},{id:"vdiga",name:"Vdiga",label:"Обаждания"},{id:"pishe",name:"Pishe",label:"Сайт"},{id:"pomaga",name:"Pomaga",label:"Администрация"}];
const examples=[
 {role:"Vdiga",slug:"vdiga",title:"От обаждането до записания час.",input:"Клиент пита за свободен час.",work:"Vdiga проверява календара и уточнява подходящо време.",result:"Уговореният час е в календара, а екипът получава обобщение.",systems:"Телефон + календар"},
 {role:"Pishe",slug:"pishe",title:"Сайтът следва промените в бизнеса.",input:"Имате нова услуга или промяна в цените.",work:"Pishe подготвя съдържанието от предоставените материали.",result:"Промяната се публикува по уговорените правила — автоматично или след ново одобрение.",systems:"Документи + сайт"},
 {role:"Pomaga",slug:"pomaga",title:"Запитването не остава само в пощата.",input:"Получавате имейл от нов клиент.",work:"Pomaga извлича нужните данни и ги прехвърля в CRM.",result:"Контактът е записан и има задача за следващата стъпка.",systems:"Имейл + CRM + задачи"},
];
const schemas=breadcrumbSchema([{name:"Raboti",url:site.url},{name:"Интеграции",url:`${site.url}/integracii/`}]);
---
<BaseLayout title="Интеграции с календар, CRM и сайт | Raboti" description="Свързваме AI служителите на Raboti с вашите програми: календар, имейл, CRM и сайт. Вижте примерите и как проверяваме връзката преди старт." canonical="/integracii/" image="/og/home.svg" schema={schemas} bodyClass="studio studio-integrations">
<header class="i-hero s-wrap">
 <h1>Програмите са ваши.<br/><span>Свързването е наша работа.</span></h1>
 <div><p>Не сменяте програмите си, за да наемете AI служител. Показвате ни къде работите и какво прехвърляте на ръка. Ние проверяваме връзките и настройваме уговорения процес.</p><a class="s-primary" href="#programi">Намерете вашите програми <Icon name="arrow-down"/></a></div>
</header>
<section class="i-catalog s-wrap" id="programi" aria-labelledby="catalog-title">
 <div class="i-section-head"><h2 id="catalog-title">С какво работи<br/><span>вашият AI служител?</span></h2><p>Това са програмите, за които можем да обсъдим връзка. Проверяваме конкретния ви план, достъп и задача преди да потвърдим обхвата.</p></div>
 <div class="i-filter" role="group" aria-label="Филтър по AI служител">{roles.map(role=><button type="button" data-filter={role.id} aria-pressed={role.id==='all'?'true':'false'}>{role.name}<span>{role.label}</span></button>)}</div>
 <p class="i-count" aria-live="polite" aria-atomic="true">Всички програми · {tools.length} връзки за обсъждане</p>
 <div class="i-tool-grid">{tools.map(tool=><article class="i-tool" data-roles={tool.roles}>
 <div class="i-tool-heading"><span class="i-logo" aria-hidden="true">{tool.icon?<svg viewBox="0 0 24 24"><path d={tool.icon.path}/></svg>:<Icon name="database"/>}</span><div><h3>{tool.name}</h3><span class="i-category">{tool.category}</span></div></div><p>{tool.use}</p><div class="i-owners">{tool.roles.split(' ').map(role=><a href={`/sluzhiteli/${role}/`}>{roles.find(r=>r.id===role)?.name}<Icon name="arrow-right"/></a>)}</div>
 </article>)}</div>
 <div class="i-other"><div><h3>Вашата програма не е тук?</h3><p>Изпратете ни името ѝ и какво искате да се случва. Проверяваме дали има подходящ API или друг начин за свързване. Ако е нужен различен процес, обсъждаме AI служител по поръчка.</p></div><a class="s-primary" href="/?agent=custom#naemi">Проверете възможностите <Icon name="arrow-right"/></a></div>
</section>
<section class="i-examples" aria-labelledby="examples-title"><div class="s-wrap">
 <div class="i-section-head"><h2 id="examples-title">Какво се случва<br/><span>между програмите ви?</span></h2><p>Примерни процеси, не активност на живо. Точните стъпки зависят от вашите програми и правилата, които уточняваме заедно.</p></div>
 <div class="i-stories">{examples.map((example,index)=><details open={index===0} class="i-story"><summary><span>{example.role}</span><h3>{example.title}</h3><Icon name="plus"/></summary><div class="i-story-body"><p class="i-systems">{example.systems}</p><ol><li><strong>Как започва</strong><p>{example.input}</p></li><li><strong>Какво поемаме</strong><p>{example.work}</p></li><li><strong>Какво получавате</strong><p>{example.result}</p></li></ol><a class="s-text-link" href={`/sluzhiteli/${example.slug}/`}>Вижте услугата {example.role} <Icon name="arrow-right"/></a></div></details>)}</div>
</div></section>
<section class="i-access s-wrap"><div><h2>Вие определяте<br/><span>до какво има достъп.</span></h2><p>Не е нужно да правите сценарии или да настройвате автоматизации. От вас е разрешението за достъп; от нас — настройката и проверката.</p><a class="s-text-link" href="/ceni/">Как се определят обхватът и цената <Icon name="arrow-right"/></a></div><dl><div><dt>Вие разрешавате връзката</dt><dd>Уточняваме кои профили, файлове и действия са нужни. Не давате достъп до всичко по подразбиране.</dd></div><div><dt>Ние проверяваме процеса</dt><dd>Тестваме уговорените стъпки преди старта. Определяме кога служителят действа сам и кога търси човек.</dd></div><div><dt>Важните решения остават ваши</dt><dd>Плащане, договор или публикуване чакат потвърждение, когато това е зададено като правило.</dd></div></dl></section>
<section class="i-contact s-wrap"><h2>Коя работа прехвърляте<br/><span>на ръка всеки ден?</span></h2><div><p>Кажете ни кои програми използвате и какво трябва да се случва между тях. До един работен ден ще ви отговорим дали можем да поемем процеса и какво ще е нужно.</p><a class="s-primary" href="/?agent=custom#naemi">Обсъдете вашия процес <Icon name="arrow-right"/></a></div></section>
</BaseLayout>
<script>
 const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
 const items=document.querySelectorAll<HTMLElement>('[data-roles]');
 const count=document.querySelector<HTMLElement>('.i-count');
 filters.forEach(button=>button.addEventListener('click',()=>{
  const role=button.dataset.filter;let total=0;
  filters.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
  items.forEach(item=>{item.hidden=role!=='all'&&!item.dataset.roles?.split(' ').includes(role||'');if(!item.hidden)total++});
  if(count) count.textContent=`${role==='all'?'Всички програми':button.firstChild?.textContent} · ${total} връзки за обсъждане`;
 }));
</script>
<style>
.i-hero{display:grid;grid-template-columns:1.15fr 1fr;align-items:center;gap:64px;padding-block:140px 60px}.i-hero h1{font-size:var(--type-display);line-height:1.08;letter-spacing:-.035em}.i-hero h1 span{color:#3157c8}.i-hero p,.i-section-head p,.i-other p,.i-access p,.i-contact p{font-size:var(--type-body);line-height:1.7;color:var(--muted)}.i-hero .s-primary,.i-contact .s-primary{margin-top:26px;width:fit-content}:global(.studio-integrations) :global(.s-primary svg),:global(.studio-integrations) :global(.s-text-link svg){width:20px;height:20px;flex-shrink:0}
.i-section-head{display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:end;margin-bottom:32px}.i-filter{display:flex;gap:10px;flex-wrap:wrap}.i-filter button{display:flex;align-items:center;gap:10px;padding:13px 22px;border:1px solid var(--line);border-radius:999px;background:transparent;color:var(--ink);font:inherit;cursor:pointer;min-height:48px}.i-filter button span{font-size:var(--type-label)}.i-filter button[aria-pressed=true]{background:#5154cc;color:#fff;border-color:#5154cc}.i-filter button:hover{border-color:#5154cc}.i-filter button:focus-visible,summary:focus-visible{outline:3px solid #3157c8;outline-offset:4px}.i-count{font-size:var(--type-label);color:var(--muted);padding-block:20px 14px}.i-tool-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);gap:0 32px}.i-tool{padding:26px 0;border-bottom:1px solid var(--line);display:flex;flex-direction:column;gap:18px}.i-tool[hidden]{display:none}.i-tool-heading{display:flex;gap:16px;align-items:center}.i-tool h3{font-size:1.125rem;line-height:1.4;letter-spacing:0}.i-category{font-size:var(--type-label);color:var(--muted)}.i-logo{width:44px;height:44px;flex-shrink:0;display:grid;place-items:center;background:#eef0f8;border-radius:12px;color:#344467}.i-logo svg,.i-logo :global(svg){width:24px;height:24px}.i-logo svg{fill:currentColor}.i-tool>p{font-size:var(--type-body);line-height:1.6;color:var(--muted);max-width:36ch}.i-owners{display:flex;gap:20px;margin-top:auto}.i-owners a{display:flex;align-items:center;gap:6px;color:#5154cc;font-size:var(--type-label);min-height:32px}.i-owners :global(svg){width:16px;height:16px}.i-other{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center;padding-block:36px 64px}.i-other h3{font-size:var(--type-title);margin-bottom:12px}.i-other p{max-width:70ch}.i-other .s-primary{white-space:nowrap}
.i-examples{background:#f0f3f9;padding-block:64px}.i-story{border-top:1px solid #d6deeb}.i-story:last-child{border-bottom:1px solid #d6deeb}.i-story summary{display:grid;grid-template-columns:100px 1fr 24px;gap:20px;align-items:center;padding:26px 0;cursor:pointer;list-style:none}.i-story summary::-webkit-details-marker{display:none}.i-story summary>span{font-size:var(--type-body);color:#5154cc}.i-story h3{font-size:var(--type-title);line-height:1.3}.i-story summary :global(svg){width:24px;height:24px;transition:transform .2s}.i-story[open] summary :global(svg){transform:rotate(45deg)}.i-story-body{padding:0 0 30px 120px}.i-systems{font-size:var(--type-label);color:var(--muted);margin-bottom:20px!important}.i-story ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;list-style:none;padding:0;margin:0 0 26px}.i-story li{border-top:2px solid #bcc5e0;padding-top:16px}.i-story strong{font-size:var(--type-body);font-weight:600}.i-story li p{font-size:var(--type-body);line-height:1.6;color:var(--muted);margin-top:10px}.i-story .s-text-link{display:inline-flex;align-items:center;gap:8px}
.i-access{display:grid;grid-template-columns:1fr 1fr;gap:80px;padding-block:72px}.i-access p{margin-block:22px}.i-access dl{margin:0}.i-access dl>div{padding-block:22px;border-bottom:1px solid var(--line)}.i-access dl>div:first-child{padding-top:0}.i-access dt{font-size:var(--type-title);line-height:1.3;margin-bottom:12px}.i-access dd{margin:0;font-size:var(--type-body);line-height:1.7;color:var(--muted)}.i-contact{display:grid;grid-template-columns:1fr 1fr;gap:64px;border-top:1px solid var(--line);padding-block:50px 72px}
@media(max-width:900px){.i-tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.i-hero,.i-section-head,.i-access,.i-contact{gap:32px}.i-other{grid-template-columns:1fr;gap:22px}.i-other .s-primary{justify-self:start}.i-story-body{padding-left:0}.i-story ol{gap:20px}}
@media(max-width:650px){.i-hero{grid-template-columns:1fr;padding-block:112px 40px;gap:22px}.i-section-head,.i-access,.i-contact{grid-template-columns:1fr;gap:24px}.i-filter{display:grid;grid-template-columns:1fr 1fr;gap:8px}.i-filter button{justify-content:center;flex-direction:column;min-width:0;padding:10px 6px;gap:3px}.i-filter button span{font-size:var(--type-meta)}.i-tool-grid{grid-template-columns:1fr}.i-tool{padding-block:22px;gap:12px}.i-tool>p{max-width:none}.i-other{padding-block:30px 44px}.i-other .s-primary{white-space:normal}.i-examples{padding-block:40px}.i-story summary{grid-template-columns:1fr 24px;gap:8px;padding-block:22px}.i-story summary>span{grid-column:1}.i-story h3{grid-column:1;font-size:var(--type-title)}.i-story summary :global(svg){grid-column:2;grid-row:1/3}.i-story ol{grid-template-columns:1fr;gap:22px}.i-access{padding-block:44px}.i-contact{padding-block:36px 48px}}
@media(prefers-reduced-motion:reduce){.i-story summary :global(svg){transition:none}}
</style>
