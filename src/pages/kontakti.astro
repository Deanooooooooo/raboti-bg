---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
import { breadcrumbSchema } from "../data/schema";
---
<BaseLayout title="Наемете AI служител | Работи" description="Изберете AI служител и опишете една задача от работата си. Ще получите отговор по имейл до един работен ден." canonical="/kontakti/" image="/og/kontakti.svg" schema={breadcrumbSchema([{name:"Работи",url:site.url},{name:"Контакти",url:`${site.url}/kontakti/`}])}>
  <section class="page-hero contact-page"><div class="shell final-grid"><div><p class="eyebrow">наемете AI служител</p><h1>Кое остава несвършено всеки ден?</h1><p>Изберете служител и опишете един случай от работата си. До един работен ден ще получите отговор по имейл дали може да го поеме, как ще започнем и колко ще струва.</p><p class="contact-direct"><span>Предпочитате да говорим?</span><a href={`tel:${site.salesPhoneHref}`}>{site.salesPhone}</a><small>{site.salesHours}</small></p></div><ContactForm title="Изпратете запитване" enquiry={true} /></div></section>
</BaseLayout>
