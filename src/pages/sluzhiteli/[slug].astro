const profile = profiles[data.slug as keyof typeof profiles];
const schemas = [
  faqSchema(profile.interview.map(([question, answer]) => ({ question, answer }))),
  breadcrumbSchema([{name:"Raboti",url:site.url},{name:"AI служители",url:`${site.url}/sluzhiteli/`},{name:data.name,url:pageUrl}]),
  { "@context": "https://schema.org", "@type": "Service", "@id": `${pageUrl}#service`, name: `${data.name}: ${data.role}`, description: data.description, provider: { "@id": `${site.url}/#organization` }, url: pageUrl, areaServed: { "@type": "Country", name: "България" },
    offers: (data.slug === "pishe"
      ? [{ price:197, description:"Еднократно изграждане на фирмен сайт без ДДС." }, { price:297, description:"Месечна поддръжка на сайт без ДДС." }, { price:497, description:"Месечна поддръжка на онлайн магазин без ДДС." }]
      : data.slug === "vdiga"
        ? [97,197,297].map(price => ({ price, description:"Месечен абонамент без ДДС." }))
        : [297,597].map(price => ({ price, description:"Месечен абонамент за локални AI агенти без ДДС." })))
      .map(offer => ({ "@type":"Offer", price:String(offer.price), priceCurrency:"EUR", url:`${pageUrl}#planove`, description:offer.description }))
  },
];
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} canonical={`/sluzhiteli/${data.slug}/`} image={`/og/${data.slug}.svg`} schema={schemas} bodyClass={`studio studio-secondary candidate-page candidate-page--${data.slug}`}>
  <>
  <section class="gloria-hero" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="gloria-hero__inner">
      <div class="gloria-hero__copy">
        <span class="gloria-role">{data.role}</span>
        <AgentWordmark slug={data.slug} tone="dark" class="gloria-agent-wordmark" loading="eager" fetchpriority="high" />
        <h1>{profile.position}</h1>
        <p class="gloria-hero__position">{profile.hello}</p>
        <p class="gloria-hero__intro">{profile.intro}</p>
        <div class="gloria-hero__actions">
          <a class="button button--spectrum" href="#razgovor"><Icon name={data.slug === "vdiga" ? "phone" : "arrow-right"} /> {data.slug === "vdiga" ? "Чуйте примерен разговор" : "Вижте как работи"}</a>
          <a class="gloria-text-link" href="#planove">Вижте цените <span aria-hidden="true">↓</span></a>
        </div>
        <ul class="gloria-facts" aria-label="Основни условия">
          {profile.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
      <figure class="gloria-portrait">
        <div class="gloria-portrait__frame"><img src={profile.image} alt={profile.imageAlt} width="780" height="900" loading="eager" fetchpriority="high" decoding="sync" /></div>
        <figcaption><span class="gloria-live-dot" aria-hidden="true"></span>{profile.availability}</figcaption>
      </figure>
    </div>
  </section>

  <nav class="agent-nav" aria-label="На тази страница"><a href="#razgovor">Как работи</a><a href="#umenia">Обхват</a><a href="#planove">Цени</a><a href="#vuprosi">Въпроси</a><a href="#zayavka">Запитване</a></nav>

  <section class="gloria-demo" id="razgovor" aria-labelledby="gloria-demo-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div>
      <p>{data.slug === "vdiga" ? "Примерен разговор" : "Примерен работен процес"}</p><h2 id="gloria-demo-title">{data.slug === "vdiga" ? "Чуйте как Vdiga приема обаждане." : profile.closing}</h2>
      {data.slug === "vdiga" ? (
        <>
          <span class="gloria-demo__intro">Записът показва как AI асистентът се представя, задава уточняващи въпроси и стига до записан час. Това е примерен разговор, а не обаждане на живо.</span>
          <audio class="gloria-demo__audio" controls preload="metadata" src="/assets/vdiga-mdsolution-demo-v35.mp3">
            Вашият браузър не може да пусне аудиозаписа.
          </audio>
        </>
      ) : (
        <><ServiceExample role={data.slug} /><a class="agent-inline-link" href="#umenia">Вижте пълния обхват <Icon name="arrow-right" /></a></>
      )}
    </div>
  </section>

  <section class="gloria-skills" id="umenia" aria-labelledby="gloria-skills-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><p>Какво мога</p><h2 id="gloria-skills-title">{profile.skillsHeadline}</h2></header>
    <div class="gloria-skills__list reveal-group">
      {profile.capabilities.map(([title, description], index) => <article class="gloria-skill reveal-row">
        <span>{String(index + 1).padStart(2,"0")}</span>
        <div><h3>{title}</h3><p>{description}</p></div>
      </article>)}
    </div>
  </section>

  {data.slug === "pishe" && <SearchDiscovery />}

  {data.slug === "vdiga" ? <VdigaPricing /> : data.slug === "pishe" ? <PishePricing /> : <PomagaPricing />}

  <section class="gloria-file" aria-labelledby="gloria-file-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><p>Служебно досие</p><h2 id="gloria-file-title">Условията ми за работа.</h2></header>
    <div class="gloria-file__card reveal-group">
      <header>
        <img src={profile.image} alt="" width="112" height="112" loading="lazy" />
        <div><p>Кандидат № {profile.fileNumber}</p><h3>{profile.person}</h3><span>{data.role}</span></div>
      </header>
      <dl>
        {profile.fileRows.map(([label, value]) => <div class="reveal-row"><dt>{label}</dt><dd>{value}</dd></div>)}
        <div class="gloria-file__price reveal-row"><dt>{data.slug === "pishe" ? "Начална услуга" : "Месечен абонамент"}</dt><dd>{data.priceLabel}</dd></div>
      </dl>
    </div>
  </section>

  <section class="gloria-honesty" aria-labelledby="gloria-honesty-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <span aria-hidden="true"></span>
    <p>Да сме честни от началото</p>
    <h2 id="gloria-honesty-title">{profile.honestyHeadline}</h2>
    <div>{profile.honesty.map((paragraph) => <p>{paragraph}</p>)}</div>
  </section>

  <section class="gloria-chat" id="vuprosi" aria-labelledby="gloria-chat-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><h2 id="gloria-chat-title">{profile.interviewHeadline}</h2></header>
    <div class="agent-questions">
      {profile.interview.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}
    </div>
  </section>

  {data.slug === "vdiga" ? <VdigaLeadForm /> : data.slug === "pishe" ? <PisheLeadForm /> : <PomagaLeadForm />}
  <section class="gloria-team" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><h2>Запознайте се с моите колеги</h2></header>
    <div class="gloria-team__grid">{colleagues.map((item) => {
      const colleague = item.data;
      const colleagueProfile = colleagueProfiles[colleague.slug];
      return <a class:list={["roster-card", `roster-card--${colleague.slug}`]} href={`/sluzhiteli/${colleague.slug}/`} aria-label={`${colleague.name}, ${colleague.role}: ${colleagueProfile.cta}`} style={`--agent:${colleague.accent};--agent-soft:${colleague.accentSoft}`}>
        <header><div class="roster-card__heading"><p>{colleague.role}</p><h3>{colleague.name}</h3></div></header>
        <div class="roster-card__portrait"><img src={colleagueProfile.image} width="720" height="960" alt={colleagueProfile.imageAlt} loading="lazy" decoding="async" /></div>
        <div class="roster-card__body"><span>{colleague.summary}</span></div>
        <footer><strong>{colleague.priceLabel}</strong><span class="roster-card__action"><span>{colleagueProfile.cta}</span><Icon name="arrow-right" /></span></footer>
      </a>;
    })}</div>
    <a class="button button--spectrum" href={data.slug === "vdiga" ? "/kontakti/?agent=vdiga" : "#zayavka"}>Назначете {profile.person}</a>
  </section>
  <script>
    const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.agent-nav a')];
    navLinks.forEach(link => link.addEventListener('click', () => navLinks.forEach(item => { if(item===link)item.setAttribute('aria-current','location');else item.removeAttribute('aria-current'); })));
    if ('IntersectionObserver' in window) {
      const navObserver = new IntersectionObserver(entries => {
        const current = entries.find(entry => entry.isIntersecting);
        if (!current) return;
        navLinks.forEach(link => { if (link.hash === `#${current.target.id}`) link.setAttribute('aria-current','location'); else link.removeAttribute('aria-current'); });
      }, {rootMargin:'-20% 0px -60% 0px'});
      navLinks.forEach(link => {const section = document.querySelector(link.hash);if(section)navObserver.observe(section);});
    }
    const revealItems = document.querySelectorAll<HTMLElement>(".candidate-page .reveal-row");
    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const item = entry.target as HTMLElement;
        const siblings = Array.from(item.parentElement?.children || []);
        item.style.setProperty("--reveal-delay", `${Math.max(0, siblings.indexOf(item)) * 70}ms`);
        item.classList.add("is-visible"); observer.unobserve(item);
      }), { threshold: .16 });
      revealItems.forEach((item) => observer.observe(item));
    } else revealItems.forEach((item) => item.classList.add("is-visible"));
  </script>
  </>
</BaseLayout>
