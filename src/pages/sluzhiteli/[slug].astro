---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentAvatar from "../../components/AgentAvatar.astro";
import AgentCard from "../../components/AgentCard.astro";
import FAQ from "../../components/FAQ.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { faqSchema, breadcrumbSchema } from "../../data/schema";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents.map((agent) => ({ params: { slug: agent.data.slug }, props: { agent, agents } }));
}
interface Props { agent: CollectionEntry<"agents">; agents: CollectionEntry<"agents">[] }
const { agent, agents } = Astro.props;
const { Content } = await render(agent);
const data = agent.data;
const colleagues = agents.filter((item) => item.id !== agent.id).sort((a,b) => a.data.order - b.data.order).slice(0,3);
const pageUrl = `${site.url}/sluzhiteli/${data.slug}/`;
const schemas = [
  faqSchema(data.faqs),
  breadcrumbSchema([{name:"Работи",url:site.url},{name:"AI служители",url:`${site.url}/sluzhiteli/`},{name:data.name,url:pageUrl}]),
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: `${data.name} — ${data.role}`,
    description: data.description,
    brand: { "@type": "Brand", name: site.brand },
    url: pageUrl,
    offers: data.price ? {
      "@type": "Offer",
      price: data.price,
      priceCurrency: data.currency,
      availability: "https://schema.org/InStock",
      url: pageUrl,
    } : {
      "@type": "Offer",
      availability: "https://schema.org/PreOrder",
      url: pageUrl,
    },
  },
];
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} canonical={`/sluzhiteli/${data.slug}/`} image={`/og/${data.slug}.svg`} schema={schemas}>
  <section class="agent-hero" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`} data-hero>
    <div class="shell agent-hero__grid">
      <div>
        <div class="profile-label"><span class="pulse"></span>{data.status === "live" ? "Свободен AI служител" : "Позицията отваря скоро"}</div>
        <h1>{data.name}</h1>
        <p class="agent-role">{data.role}</p>
        <p class="agent-lead">{data.description}</p>
        <div class="agent-meta">
          <div><span>Месечна цена</span><strong>{data.priceLabel}</strong></div>
          <div><span>Започва</span><strong>{data.startTime}</strong></div>
        </div>
        <div class="hero-actions">
          {data.status === "live" ? (
            data.demoUrl ? <a class="button" href={data.demoUrl}>Чуй демото</a> : <a class="button" href="#naemi">Наеми {data.name}</a>
          ) : <a class="button" href="#spisak">Извести ме</a>}
          {data.externalUrl && <a class="text-link" href={data.externalUrl}>Подробно на vdiga.bg <Icon name="external-link" /></a>}
        </div>
      </div>
      <div class="agent-portrait">
        <AgentAvatar name={data.name} slug={data.slug} accent={data.accent} accentSoft={data.accentSoft} size="large" />
        <div class="agent-quote">„{data.summary}“</div>
      </div>
    </div>
  </section>

  <section class="section"><div class="shell detail-grid">
    <div><p class="eyebrow">длъжностна характеристика</p><h2>Какво върши.</h2><div class="prose"><Content /></div></div>
    <ul class="duty-list">{data.duties.map((duty) => <li><span><Icon name="check" /></span>{duty}</li>)}</ul>
  </div></section>

  <section class="section section--tint"><div class="shell">
    <div class="section-head"><div><p class="eyebrow">работи с</p><h2>Влиза в сегашния ти начин на работа.</h2></div><p>Свързваме само системи, до които има надежден и разрешен достъп.</p></div>
    <div class="integration-grid">{data.integrations.map((item) => <span>{item}</span>)}</div>
  </div></section>

  <section class="section"><div class="shell split">
    <div><p class="eyebrow">какво влиза в услугата</p><h2>Какво получаваш.</h2><p>{data.status === "live" ? `${data.name} има месечна цена ${data.priceLabel.toLowerCase()} и изпълнява само предварително одобрените действия.` : `${data.name} още не се предлага. Записването в списъка не е поръчка и не създава задължение.`}</p></div>
    <ul class="feature-list">{data.features.map((feature) => <li>{feature}</li>)}</ul>
  </div></section>

  <section class="section section--tint"><div class="shell split">
    <div><p class="eyebrow">въпроси за ролята</p><h2>Преди да добавиш {data.name}.</h2></div>
    <FAQ items={data.faqs} />
  </div></section>

  <section class="section"><div class="shell">
    <div class="section-head"><div><p class="eyebrow">колегите</p><h2>Виж и останалата част от екипа.</h2></div></div>
    <div class="agent-grid agent-grid--three">{colleagues.map((item) => <AgentCard agent={item} compact />)}</div>
  </div></section>

  <section class="section final-cta" id={data.status === "live" ? "naemi" : "spisak"}>
    <div class="shell final-grid">
      <div><p class="eyebrow">{data.status === "live" ? "добави към екипа" : "ранен достъп"}</p><h2>{data.status === "live" ? `Искаш ли ${data.name} да поеме това?` : `Да ти пишем, когато ${data.name} е готов/а?`}</h2></div>
      <ContactForm selectedAgent={data.slug} intent={data.status === "live" ? "hire" : "waitlist"} />
    </div>
  </section>
</BaseLayout>
