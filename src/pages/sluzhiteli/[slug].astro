---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import VdigaPricing from "../../components/VdigaPricing.astro";
import VdigaLeadForm from "../../components/VdigaLeadForm.astro";
import PishePricing from "../../components/PishePricing.astro";
import PisheLeadForm from "../../components/PisheLeadForm.astro";
import PomagaPricing from "../../components/PomagaPricing.astro";
import PomagaLeadForm from "../../components/PomagaLeadForm.astro";
import { site } from "../../data/site";
import { faqSchema, breadcrumbSchema } from "../../data/schema";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents.filter((agent) => agent.data.status === "live").map((agent) => ({ params: { slug: agent.data.slug }, props: { agent, agents } }));
}

const { agent, agents } = Astro.props;
const data = agent.data;
const colleagues = agents.filter((item) => item.id !== agent.id && item.data.status === "live").sort((a,b) => a.data.order - b.data.order);
const colleagueProfiles: Record<string, { image: string; imageAlt: string; cta: string }> = {
  vdiga: { image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Глория — образът на телефонния рецепционист Vdiga", cta: "Как мога да съм полезна?" },
  pishe: { image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Как мога да съм полезен?" },
  pomaga: { image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Как мога да съм полезна?" },
};
const pageUrl = `${site.url}/sluzhiteli/${data.slug}/`;

const profiles = {
  vdiga: {
    person: "Глория",
    image: "/assets/employee-vdiga-gloria-v1.webp",
    imageAlt: "Глория — образът на телефонния рецепционист Vdiga",
    hello: "Здравейте, аз съм Глория.",
    headline: "Кандидатствам за рецепционист във вашия бизнес.",
    intro: "Вдигам телефона, отговарям на обичайните въпроси и записвам часове. За да започна, трябва да ми разкажете как работи бизнесът ви и какво да правя при всеки тип обаждане.",
    firstQuestion: "Защо да назначим вас?",
    firstAnswer: "Защото телефонът звъни точно когато сте с клиент, шофирате или работният ден вече е свършил. Аз мога да поема тези разговори, без да прекъсвам работата ви.",
    position: "Кандидатствам за рецепционист във вашия бизнес.",
    facts: ["Вдигам 24/7", "Говоря български", "от €97/месец"],
    fileNumber: "001",
    availability: "Свободна за работа",
    fileRows: [["Работно време", "24/7, включително празници"], ["Болнични", "0 дни"], ["Отпуск", "Не ползвам"], ["Изпитателен срок", "С удоволствие"], ["Език", "Български"]],
    interview: [
      ["Глория, защо да назначим вас, а не човек?", "Не е нужно да е или едното, или другото. Ако имате рецепционист, мога да поема вечерите, почивните дни и часовете, в които телефонът звъни повече. Ако нямате, мога да започна от €97 на месец."],
      ["Клиентите няма ли да се дразнят, че говорят с AI?", "Още в началото казвам, че съм AI асистент. След това питам защо се обаждат и върша това, за което сте ме подготвили. Чуйте примерен разговор и преценете сами."],
      ["А ако не знаете отговора?", "Няма да си измисля. Ще взема име, телефон и причината за обаждането, после ще ви изпратя всичко, за да върнете разговора."],
      ["Колко време ви трябва, за да започнете?", "Давате ми услугите, цените, работното време и правилата за записване. Настройваме номера, правим пробни разговори и до пет работни дни мога да съм на телефона."],
      ["Какво става с обажданията, докато спите?", "Аз не спя. Това беше лесен въпрос."],
    ],
    capabilities: [
      ["Вдигам, преди клиентът да затвори.", "Поемам телефона, когато сте с клиент, шофирате или работният ден вече е приключил. Така обаждането не остава без отговор."],
      ["Записвам часове директно в календара ви.", "Проверявам свободните часове и записвам клиента в свързан календар или система за резервации. Вие получавате известие за новия час."],
      ["Отговарям на обичайните въпроси.", "Работно време, цени, адрес и подготовка за посещение — използвам само информацията, която сте одобрили предварително."],
      ["Хващам случаите, които искат човек.", "Вземам име, телефон и причина за обаждането. После предавам разговора или изпращам информацията на правилния човек."],
      ["Помня какво се случи.", "Всяко обаждане остава записано и обобщено. Виждате кой е звънял, какво е поискал и какво съм направила."],
    ],
    honesty: ["Не мога да направя кафе на колегите. Не мога да преместя масата в ъгъла.", "Ако клиент попита нещо, което не знам, няма да си измислям. Ще взема името, телефона и въпроса му и ще ви ги изпратя."],
    skillsHeadline: "Работата, за която кандидатствам.",
    honestyHeadline: "Какво не мога",
    interviewHeadline: "Въпросите, които вероятно вече си задавате.",
    closing: "Готова съм за интервю. Вие?",
    cta: "Поканете ме на интервю",
  },
  pishe: {
    person: "Pishe",
    image: "/assets/employee-pishe-v1.webp",
    imageAlt: "Pishe — уеб мениджър за сайт, съдържание, SEO и GEO",
    hello: "Здравейте, аз съм Pishe.",
    headline: "Кандидатствам да поема сайта ви.",
    intro: "Когато човек потърси бизнеса ви, сайтът трябва да му каже какво предлагате, защо да избере вас и как да се свърже. Ако още нямате сайт, ще го изградим. Ако имате, ще пренапиша неясните страници, ще добавя липсващите и ще поддържам цените, услугите и каталога. Ще работя и по SEO/GEO, за да ви намират, когато търсят точно това, което предлагате.",
    firstQuestion: "Защо да ви наемем?",
    firstAnswer: "Защото клиентът не знае, че новата цена още чака програмиста или че нямате време да напишете страницата за новата услуга. Той вижда стар, неясен или празен сайт и продължава към следващия. Аз поемам работата по сайта, за да не губите такива клиенти.",
    position: "Кандидатствам да изградя сайта ви и да продължа да работя по него след пускането.",
    facts: ["Нов или съществуващ сайт", "Съдържание + SEO/GEO", "от €197/месец"],
    fileNumber: "002",
    availability: "Свободен за работа",
    fileRows: [["Работно място", "Вашият сайт"], ["Ако нямате сайт", "Изграждаме го"], ["Съдържание", "Пиша и публикувам"], ["Откриваемост", "SEO + GEO"], ["Старт", "До 7 работни дни"]],
    capabilities: [
      ["Изграждам нов сайт, ако още нямате.", "Не започвам от цветове и ефекти. Първо изясняваме какво продавате, кой е добрият клиент за вас и какво трябва да направи на сайта — да се обади, да изпрати запитване или да поръча. После подреждам страниците, пиша текстовете и подготвям сайта за пускане."],
      ["Сменям цените и поддържам каталога.", "Пускате нов продукт, спирате стар модел, сменяте цена или правите сезонна оферта. Изпращате ми информацията, а аз поправям засегнатите страници, категории, текстове и бутони. Накрая проверявам сайта на телефон и компютър."],
      ["Пиша страниците вместо вас.", "Разказвате ми за услугата така, както бихте я обяснили на клиент. Аз задавам допълнителните въпроси, изваждам важните факти и подготвям страницата. Същото важи за завършен проект, често задаван въпрос, нов обект или полезна статия. Вие одобрявате преди публикуване."],
      ["Работя по SEO и GEO.", "Проверявам как хората търсят услугата по проблем, продукт и град и кои страници липсват. После пиша отговорите, които наистина им трябват: какво предлагате, за кого е, колко струва или как се определя цената, къде работите и каква е следващата стъпка. Това помага и на търсачките, и на AI системите да разберат бизнеса ви."],
      ["Проверявам какво показват конкурентите.", "Гледам как представят услугите, цените, сроковете, гаранциите и завършените проекти. После изваждаме вашите реални предимства и ги показваме с факти, вместо с „качество и професионализъм“."],
      ["Търся защо хората разглеждат, но не питат.", "Проверявам дали още в началото се разбира какво предлагате, има ли причина да ви повярват, намира ли се лесно цената или начинът за оферта и работят ли формата и бутоните. После ви показвам какво бих променил и защо."],
      ["Продължавам да работя и след пускането.", "Следя данните в Search Console, обновявам страниците, които губят посещения, и добавям новите услуги, продукти, обекти и въпроси. Така след година сайтът още показва бизнеса ви такъв, какъвто е тогава."],
    ],
    honesty: ["Не мога да обещая първо място в Google. Мога да проуча търсенията, да поправя структурата и съдържанието и да следя какво се променя. Резултатите зависят и от конкуренцията, историята на домейна и много неща извън сайта.", "Ако ви трябва сложна платформа, нестандартна интеграция или голяма нова функционалност, ще включим разработчик и ще я оферираме отделно. Ще го уточним преди да започнем."],
    skillsHeadline: "Вие движите бизнеса. Аз се грижа сайтът да го показва.",
    honestyHeadline: "Какво няма да ви обещая",
    interviewHeadline: "Преди да ми дадете достъп до сайта.",
    interview: [
      ["Нямам сайт. Можете ли да започнете от нулата?", "Да. Първо изясняваме услугите, клиентите и действието, което сайтът трябва да носи. После определяме обхвата и цената за изграждането. Месечната работа започва след това: съдържание, SEO/GEO, подобрения и актуализация."],
      ["Вече имам сайт. Трябва ли нов?", "Не непременно. Първо гледаме какво пречи на сегашния: неясна оферта, липсващи страници, слаб текст, технически проблеми или грешна структура. Ако може да се развие, не ви продаваме нов сайт само защото е по-голям проект."],
      ["Имам много продукти и цените се сменят. Може ли Pishe да поддържа каталога?", "Да, ако платформата дава надежден достъп и процесът е ясен. Уточняваме откъде идват одобрените данни, кои полета и страници се обновяват и как се проверява резултатът. При голям каталог обхватът се определя отделно — не го скриваме зад обещание за неограничени промени."],
      ["Как ще покажете защо да изберат нас, а не конкурент?", "Първо събирам фактите: как работите, какво включва услугата, срокове, гаранции, цени, завършени проекти и за кои клиенти сте най-подходящи. После ги сравнявам с това, което конкурентите показват. Ако имате реално предимство, го казваме ясно и го доказваме на правилната страница."],
      ["SEO и GEO гарантират ли първа позиция?", "Не. Работя по страниците, структурата и техническите сигнали, следя какво се показва и обновявам съдържанието. Никой не може честно да гарантира къде Google или една AI система ще ви постави."],
      ["Какво получавам за €197?", "Това е началната цена за текущата работа на Pishe, не за цял нов сайт. След кратък преглед уточняваме конкретния месечен обхват. Нов сайт или голям редизайн се оферира отделно."],
    ],
    closing: "Покажете ми къде сайтът ви изпуска клиенти.",
    cta: "Покажете ми сайта",
  },
  pomaga: {
    person: "Pomaga",
    image: "/assets/employee-pomaga-v1.webp",
    imageAlt: "Pomaga — служител за повтаряща се офис работа",
    hello: "Здравейте, аз съм Pomaga.",
    headline: "Дайте ми работата, която изяжда деня на екипа.",
    intro: "Заявката е дошла по имейл. После някой трябва да я препише в CRM-а, да обнови таблицата, да създаде задача и да уведоми колега. Когато денят стане натоварен, една от тези стъпки се пропуска. Аз поемам целия повтарящ се път.",
    firstQuestion: "Защо да ви наемем?",
    firstAnswer: "Защото добрите ви хора не трябва да прекарват сутринта в копиране от един екран в друг. Покажете ми повторението веднъж и аз ще го поема всеки следващ път.",
    position: "Кандидатствам за оперативния асистент, който не оставя задачите между два стола.",
    facts: ["Работя в програмите ви", "Спирам и питам при изключение", "от €297/месец"],
    fileNumber: "003",
    availability: "Свободна за работа",
    fileRows: [["Работно място", "Между системите ви"], ["Задачи", "Повтарящи се и проверими"], ["Режим", "По график или събитие"], ["Рискови действия", "Само след одобрение"], ["Старт", "До 10 работни дни"]],
    capabilities: [
      ["Не оставям заявката да потъне във входящата поща.", "Когато дойде договореният тип имейл, вземам името, номера, поръчката или другите нужни данни. Създавам задачата там, където екипът ви реално работи."],
      ["Спирам двойното и тройното преписване.", "Един и същ клиент не трябва да се въвежда на ръка в CRM, таблица и вътрешна система. Прехвърлям данните по правилата ви и отбелязвам, ако липсва нещо задължително."],
      ["Напомням на правилния човек, не на всички.", "Когато задачата стигне до счетоводство, търговец или управител, изпращам нужната информация на него. Екипът не губи време да пита кой трябва да поеме случая."],
      ["Показвам какво е свършено и какво чака.", "Вместо да събирате статуса от имейли и разговори, получавате запис на изпълнените задачи и ясен списък с тези, които чакат решение."],
      ["Спирам преди скъпа грешка.", "Ако липсват данни, има необичаен случай или следва плащане и друга необратима стъпка, не продължавам на сляпо. Изпращам случая на човек с точната причина."],
    ],
    honesty: ["Не мога да оправя объркан процес, като го изпълнявам по-бързо. Първо трябва да видим коя стъпка кой решава и как изглежда правилният резултат.", "Не правя плащане, не подписвам договор и не вземам решение вместо вас. Мога да подготвя всичко дотам; последното „да“ остава при човек."],
    skillsHeadline: "Една заявка влиза. Свършената работа излиза.",
    honestyHeadline: "Къде спирам и ви викам",
    interviewHeadline: "Преди да ме пуснете в системите си.",
    interview: [
      ["Как да разбера дали една задача е за вас?", "Ако човек я върши често по едни и същи стъпки — от имейл към CRM, от CRM към таблица, от документ към задача — струва си да я видим."],
      ["Ще трябва ли да описвам целия си бизнес?", "Не. Покажете една истинска задача от началото до края. Ще извадим правилата, нужните данни и местата, на които трябва да се чака човек."],
      ["А ако объркате клиент или сума?", "Преди старт тестваме процеса с реални примери. Задължителните полета се проверяват, а необичаен случай се спира. Рисковите действия не минават без одобрение."],
      ["Ще трябва ли да сменим CRM-а?", "Не, ако сегашните ви програми могат да се свържат надеждно. Първо проверяваме това, което вече използвате. Ако не става, ще го кажем преди да обещаем резултат."],
    ],
    closing: "Покажете ми задачата, която екипът ви повтаря всяка седмица.",
    cta: "Покажете една задача",
  },
} as const;

const profile = profiles[data.slug as keyof typeof profiles];
const schemas = [
  faqSchema(profile.interview.map(([question, answer]) => ({ question, answer }))),
  breadcrumbSchema([{name:"Работи",url:site.url},{name:"AI служители",url:`${site.url}/sluzhiteli/`},{name:data.name,url:pageUrl}]),
  { "@context": "https://schema.org", "@type": "Product", name: `${data.name} — ${data.role}`, description: data.description, brand: { "@type": "Brand", name: site.brand }, url: pageUrl,
    offers: data.slug === "vdiga"
      ? { "@type": "AggregateOffer", lowPrice: "97", highPrice: "297", priceCurrency: "EUR", offerCount: "3", availability: "https://schema.org/InStock", url: `${pageUrl}#planove` }
      : data.slug === "pishe"
        ? { "@type": "AggregateOffer", lowPrice: "197", highPrice: "597", priceCurrency: "EUR", offerCount: "3", availability: "https://schema.org/InStock", url: `${pageUrl}#planove` }
        : { "@type": "AggregateOffer", lowPrice: "297", highPrice: "597", priceCurrency: "EUR", offerCount: "3", availability: "https://schema.org/InStock", url: `${pageUrl}#planove` } },
];
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} canonical={`/sluzhiteli/${data.slug}/`} image={`/og/${data.slug}.svg`} schema={schemas} bodyClass={`candidate-page candidate-page--${data.slug}`}>
  <>
  <section class="gloria-hero" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="gloria-hero__inner">
      <div class="gloria-hero__copy">
        <span class="gloria-role">{data.role}</span>
        <h1>{profile.hello}</h1>
        <p class="gloria-hero__position">{profile.position}</p>
        <p class="gloria-hero__intro">{profile.intro}</p>
        <div class="gloria-hero__actions">
          <a class="button button--spectrum" href={data.slug === "vdiga" ? data.demoUrl : "#zayavka"}><Icon name={data.slug === "vdiga" ? "phone" : "arrow-right"} /> {data.slug === "vdiga" ? "Поканете ме на интервю" : profile.cta}</a>
          <a class="gloria-text-link" href="#umenia">Вижте какво мога <span aria-hidden="true">↓</span></a>
        </div>
        <ul class="gloria-facts" aria-label="Основни условия">
          {profile.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </div>
      <figure class="gloria-portrait">
        <div class="gloria-portrait__frame"><img src={profile.image} alt={profile.imageAlt} width="780" height="900" loading="eager" fetchpriority="high" decoding="sync" /></div>
        <figcaption><span class="gloria-live-dot" aria-hidden="true"></span>{profile.availability}</figcaption>
      </figure>
    </div>
  </section>

  <section class="gloria-file" aria-labelledby="gloria-file-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><p>Служебно досие</p><h2 id="gloria-file-title">Условията ми за работа.</h2></header>
    <div class="gloria-file__card reveal-group">
      <header>
        <img src={profile.image} alt="" width="112" height="112" loading="lazy" />
        <div><p>Кандидат № {profile.fileNumber}</p><h3>{profile.person}</h3><span>{data.role}</span></div>
      </header>
      <dl>
        {profile.fileRows.map(([label, value]) => <div class="reveal-row"><dt>{label}</dt><dd>{value}</dd></div>)}
        <div class="gloria-file__price reveal-row"><dt>Заплата</dt><dd>{data.priceLabel}, без осигуровки</dd></div>
      </dl>
    </div>
  </section>

  <section class="gloria-skills" id="umenia" aria-labelledby="gloria-skills-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><p>Какво мога</p><h2 id="gloria-skills-title">{profile.skillsHeadline}</h2></header>
    <div class="gloria-skills__list reveal-group">
      {profile.capabilities.map(([title, description], index) => <article class="gloria-skill reveal-row">
        <span>{String(index + 1).padStart(2,"0")}</span>
        <div><h3>{title}</h3><p>{description}</p></div>
      </article>)}
    </div>
  </section>

  <section class="gloria-honesty" aria-labelledby="gloria-honesty-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <span aria-hidden="true"></span>
    <p>Да сме честни от началото</p>
    <h2 id="gloria-honesty-title">{profile.honestyHeadline}</h2>
    <div>{profile.honesty.map((paragraph) => <p>{paragraph}</p>)}</div>
  </section>

  <section class="gloria-chat" aria-labelledby="gloria-chat-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><p>Интервюто</p><h2 id="gloria-chat-title">{profile.interviewHeadline}</h2></header>
    <div class="gloria-chat__thread reveal-group">
      {profile.interview.map(([question, answer]) => <div class="gloria-chat__exchange reveal-row">
        <p class="gloria-chat__question">— {question}</p>
        <div class="gloria-chat__answer"><img src={profile.image} alt="" width="48" height="48" loading="lazy" /><p>{answer}</p></div>
      </div>)}
    </div>
  </section>

  <section class="gloria-demo" id="razgovor" aria-labelledby="gloria-demo-title" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div>
      <p>{data.slug === "vdiga" ? "Живо демо" : "Пробна задача"}</p><h2 id="gloria-demo-title">{data.slug === "vdiga" ? "Интервюирайте ме. Сега." : profile.closing}</h2>
      <a class="gloria-demo__call" href={data.slug === "vdiga" ? data.demoUrl : "#zayavka"}>{data.slug === "vdiga" ? "Започнете интервюто" : profile.cta} <Icon name="arrow-right" /></a>
      <span>{data.slug === "vdiga" ? "Ще ви отговоря в браузъра. Питайте ме каквото искате." : data.slug === "pishe" ? "Пратете сайта си — или опишете бизнеса, ако още нямате сайт. До един работен ден ще кажем откъде има смисъл да започнем." : "Опишете откъде идва задачата и къде трябва да стигне. До един работен ден ще кажем дали Pomaga може да я поеме."}</span>
    </div>
  </section>

  {data.slug === "vdiga" ? <><VdigaPricing /><VdigaLeadForm /></> : data.slug === "pishe" ? <><PishePricing /><PisheLeadForm /></> : <><PomagaPricing /><PomagaLeadForm /></>}
  <section class="gloria-team" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="gloria-section-head"><h2>Запознайте се с моите колеги</h2></header>
    <div class="gloria-team__grid">{colleagues.map((item) => {
      const colleague = item.data;
      const colleagueProfile = colleagueProfiles[colleague.slug];
      return <a class:list={["roster-card", `roster-card--${colleague.slug}`]} href={`/sluzhiteli/${colleague.slug}/`} aria-label={`${colleague.name}, ${colleague.role}: ${colleagueProfile.cta}`} style={`--agent:${colleague.accent};--agent-soft:${colleague.accentSoft}`}>
        <header><div class="roster-card__heading"><p>{colleague.role}</p><h3>{colleague.name}</h3></div></header>
        <div class="roster-card__portrait"><img src={colleagueProfile.image} width="720" height="960" alt={colleagueProfile.imageAlt} loading="lazy" decoding="async" /></div>
        <div class="roster-card__body"><span>{colleague.summary}</span></div>
        <footer><strong>{colleague.priceLabel}</strong><span class="roster-card__action"><span>{colleagueProfile.cta}</span><Icon name="arrow-right" /></span></footer>
      </a>;
    })}</div>
    <a class="button button--spectrum" href={data.slug === "vdiga" ? "/kontakti/?agent=vdiga" : "#zayavka"}>Назначете {profile.person}</a>
  </section>
  <script>
    const revealItems = document.querySelectorAll<HTMLElement>(".candidate-page .reveal-row");
    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const item = entry.target as HTMLElement;
        const siblings = Array.from(item.parentElement?.children || []);
        item.style.setProperty("--reveal-delay", `${Math.max(0, siblings.indexOf(item)) * 70}ms`);
        item.classList.add("is-visible"); observer.unobserve(item);
      }), { threshold: .16 });
      revealItems.forEach((item) => observer.observe(item));
    } else revealItems.forEach((item) => item.classList.add("is-visible"));
  </script>
  </>
</BaseLayout>
