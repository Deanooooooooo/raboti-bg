---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentCard from "../../components/AgentCard.astro";
import FAQ from "../../components/FAQ.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { faqSchema, breadcrumbSchema } from "../../data/schema";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents.filter((agent) => agent.data.status === "live").map((agent) => ({ params: { slug: agent.data.slug }, props: { agent, agents } }));
}

const { agent, agents } = Astro.props;
const data = agent.data;
const colleagues = agents.filter((item) => item.id !== agent.id && item.data.status === "live").sort((a,b) => a.data.order - b.data.order).slice(0,2);
const pageUrl = `${site.url}/sluzhiteli/${data.slug}/`;

const profiles = {
  vdiga: {
    person: "Глория",
    image: "/assets/employee-vdiga-gloria-v1.webp",
    imageAlt: "Глория — образът на телефонния рецепционист Vdiga",
    hello: "Здравейте, аз съм Глория.",
    pitch: "Когато телефонът звънне, аз вдигам. Отговарям на обичайните въпроси, записвам часове и не оставям клиента да чака някой да се освободи.",
    proof: "Няма да импровизирам от ваше име. Преди да започна, ще ми покажете как разговаряте с клиентите си, какво мога да казвам и кога да ви потърся.",
    fit: "Най-полезна съм, ако губите обаждания, докато работите с клиент, шофирате или вече сте затворили.",
    question: "Телефонът звъни, а няма кой да вдигне?",
    answer: "Дайте ми номера и правилата. Аз ще поема разговора, а вие ще получите човека, часа и причината да се обади.",
  },
  pishe: {
    person: "Pishe",
    image: "/assets/employee-pishe-v1.webp",
    imageAlt: "Pishe — уеб служител за поддръжка на фирмен сайт",
    hello: "Здравейте, аз съм Pishe.",
    pitch: "Пазя сайта ви актуален. Сменям цени, услуги, работно време, снимки и текстове, вместо всяка малка промяна да чака свободен програмист.",
    proof: "Работя само по уговорените промени. Показвам ви какво съм подготвил и не публикувам нещо важно, преди да го одобрите.",
    fit: "Най-полезен съм, ако сайтът ви изостава от бизнеса и все някой трябва да напомня какво още не е обновено.",
    question: "Сайтът още показва стара цена или услуга?",
    answer: "Изпратете ми промяната както бихте я написали на колега. Ще я подготвя, ще я проверя и ще ви я дам за одобрение.",
  },
  pomaga: {
    person: "Pomaga",
    image: "/assets/employee-pomaga-v1.webp",
    imageAlt: "Pomaga — оперативен служител за повтаряща се офис работа",
    hello: "Здравейте, аз съм Pomaga.",
    pitch: "Поемам досадната работа между имейла, таблиците, CRM-а и програмите ви. Прехвърлям данни, обновявам статуси и подготвям справки.",
    proof: "Първо ми показвате една задача от начало до край. Повтарям я по същите правила, записвам какво съм направила и ви питам преди плащане или необратима промяна.",
    fit: "Най-полезна съм, ако човек от екипа губи часове в копиране, проверяване и местене на една и съща информация.",
    question: "Някой още мести данни на ръка всеки ден?",
    answer: "Покажете ми веднъж откъде идват и къде трябва да стигнат. После ще върша повторението, без да ви прекъсвам за всяка стъпка.",
  },
} as const;

const profile = profiles[data.slug as keyof typeof profiles];
const schemas = [
  faqSchema(data.faqs),
  breadcrumbSchema([{name:"Работи",url:site.url},{name:"AI служители",url:`${site.url}/sluzhiteli/`},{name:data.name,url:pageUrl}]),
  { "@context": "https://schema.org", "@type": "Product", name: `${data.name} — ${data.role}`, description: data.description, brand: { "@type": "Brand", name: site.brand }, url: pageUrl,
    offers: { "@type": "Offer", price: data.price, priceCurrency: data.currency, availability: "https://schema.org/InStock", url: pageUrl } },
];
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} canonical={`/sluzhiteli/${data.slug}/`} image={`/og/${data.slug}.svg`} schema={schemas} bodyClass={`agent-profile agent-profile--${data.slug}`}>
  <section class="interview-hero" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="interview-hero__inner">
      <div class="interview-hero__copy">
        <p class="interview-hello">{profile.hello}</p>
        <h1>{profile.pitch}</h1>
        <p class="interview-intro">{profile.proof}</p>
        <div class="interview-actions">
          <a class="button interview-button" href="#naemi">Поканете ме на разговор</a>
          {data.demoUrl && <a class="interview-link" href={data.demoUrl}>Чуйте как говоря <Icon name="arrow-right" /></a>}
        </div>
      </div>
      <figure class="interview-portrait">
        <img src={profile.image} alt={profile.imageAlt} width="780" height="900" loading="eager" fetchpriority="high" decoding="sync" />
        <figcaption>
          <strong>{profile.person}</strong>
          <span>{data.role}</span>
          <small>{data.priceLabel} · започва {data.startTime}</small>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="candidate-fit" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="candidate-fit__question">
      <h2>{profile.question}</h2>
      <p>{profile.answer}</p>
    </div>
    <p class="candidate-fit__note">{profile.fit}</p>
  </section>

  <section class="interview-section interview-duties" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="interview-section__heading">
      <h2>Какво мога да поема още от първия месец</h2>
      <p>Това са задачите, за които можете да разчитате на мен.</p>
    </div>
    <ol class="interview-duty-list">
      {data.duties.map((duty, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{duty}</p></li>)}
    </ol>
  </section>

  <section class="interview-section interview-work" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="interview-work__copy">
      <h2>Как ще работим заедно</h2>
      <p>В началото ми показвате истинска задача. Уточняваме какво мога да правя сама, кога да питам и как да ви върна резултата.</p>
      <div class="interview-price"><span>Месечно</span><strong>{data.priceLabel}</strong><small>Точната цена зависи от работата и нужните връзки.</small></div>
    </div>
    <div class="interview-boundaries">
      <h3>От мен можете да очаквате</h3>
      <ul>{data.features.map((feature) => <li><Icon name="check" /><span>{feature}</span></li>)}</ul>
      <h3>Мога да работя с</h3>
      <div class="interview-tools">{data.integrations.map((item) => <span>{item}</span>)}</div>
    </div>
  </section>

  <section class="interview-section interview-faq" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div><h2>Какво бихте ме попитали на интервю?</h2><p>Ето честните отговори на най-важното преди да започнем.</p></div>
    <FAQ items={data.faqs} />
  </section>

  <section class="interview-colleagues">
    <div class="interview-colleagues__head"><h2>Запознайте се и с колегите ми</h2><p>Ако задачата е друга, може би един от тях е точният човек.</p></div>
    <div class="agent-grid agent-grid--three">{colleagues.map((item) => <AgentCard agent={item} compact />)}</div>
  </section>

  <section class="interview-hire" id="naemi" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="interview-hire__copy"><h2>Имате ли работа за мен?</h2><p>Опишете една задача както бихте я обяснили на нов служител. Ще ви кажем направо дали мога да я поема.</p></div>
    <ContactForm selectedAgent={data.slug} intent="hire" />
  </section>
</BaseLayout>
