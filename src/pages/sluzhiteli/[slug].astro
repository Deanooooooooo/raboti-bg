---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentCard from "../../components/AgentCard.astro";
import FAQ from "../../components/FAQ.astro";
import ContactForm from "../../components/ContactForm.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";
import { faqSchema, breadcrumbSchema } from "../../data/schema";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents.filter((agent) => agent.data.status === "live").map((agent) => ({ params: { slug: agent.data.slug }, props: { agent, agents } }));
}

const { agent, agents } = Astro.props;
const data = agent.data;
const colleagues = agents.filter((item) => item.id !== agent.id && item.data.status === "live").sort((a,b) => a.data.order - b.data.order);
const pageUrl = `${site.url}/sluzhiteli/${data.slug}/`;

const profiles = {
  vdiga: {
    person: "Глория",
    image: "/assets/employee-vdiga-gloria-v1.webp",
    imageAlt: "Глория — образът на телефонния рецепционист Vdiga",
    hello: "Здравейте, аз съм Глория.",
    headline: "Кандидатствам за рецепционист във вашия бизнес.",
    intro: "Вдигам телефона, отговарям на обичайните въпроси и записвам часове. За да започна, трябва да ми разкажете как работи бизнесът ви и какво да правя при всеки тип обаждане.",
    firstQuestion: "Защо да назначим вас?",
    firstAnswer: "Защото телефонът звъни точно когато сте с клиент, шофирате или работният ден вече е свършил. Аз мога да поема тези разговори, без да прекъсвам работата ви.",
    interview: [
      ["Глория, защо да назначим вас, а не човек?", "Не е нужно да е или едното, или другото. Ако имате рецепционист, мога да поема вечерите, почивните дни и часовете, в които телефонът звъни повече. Ако нямате, мога да започна от €97 на месец."],
      ["Клиентите няма ли да се дразнят, че говорят с AI?", "Още в началото казвам, че съм AI асистент. След това питам защо се обаждат и върша това, за което сте ме подготвили. Чуйте примерен разговор и преценете сами."],
      ["А ако не знаете отговора?", "Няма да си измисля. Ще взема име, телефон и причината за обаждането, после ще ви изпратя всичко, за да върнете разговора."],
      ["Колко време ви трябва, за да започнете?", "Давате ми услугите, цените, работното време и правилата за записване. Настройваме номера, правим пробни разговори и до пет работни дни мога да съм на телефона."],
      ["Какво става с обажданията, докато спите?", "Аз не спя. Това беше лесен въпрос."],
    ],
    closing: "Готова съм за интервю. Вие?",
    cta: "Поканете ме на интервю",
  },
  pishe: {
    person: "Pishe",
    image: "/assets/employee-pishe-v1.webp",
    imageAlt: "Pishe — служител за поддръжка на фирмен сайт",
    hello: "Здравейте, аз съм Pishe.",
    headline: "Сайтът ви не бива да чака.",
    intro: "Сменям цени, услуги, работно време, снимки и текстове. Малката промяна приключва днес, вместо да чака свободен програмист две седмици.",
    firstQuestion: "Защо да ви наемем?",
    firstAnswer: "Защото клиентът вярва на това, което вижда на сайта. Стара цена, несъществуваща услуга или грешно работно време ви излагат точно когато човек решава дали да ви се обади.",
    interview: [
      ["Как да ви дам промяна?", "Напишете ми я както бихте я пратили на колега: „Сменете цената на тази услуга“ или „Качете тези три снимки“. Не ви трябва техническо задание."],
      ["Ще публикувате ли без мен?", "Само ако предварително сте разрешили точно този вид промяна. Нова цена, важна оферта или нещо необичайно първо идва при вас за одобрение."],
      ["А ако нещо се счупи?", "Преди промяната пазя предишната версия. Проверявам страницата след публикуване и ако има проблем, връщам работещото състояние."],
      ["Какво не е ваша работа?", "Не се представям за дизайнер или програмист на голям проект. Поемам ежедневната поддръжка и малките подобрения, които иначе все остават за после."],
    ],
    closing: "Ако сайтът ви изостава от бизнеса, изпратете ми промяната, която отлагате най-дълго.",
    cta: "Дайте ми една промяна",
  },
  pomaga: {
    person: "Pomaga",
    image: "/assets/employee-pomaga-v1.webp",
    imageAlt: "Pomaga — служител за повтаряща се офис работа",
    hello: "Здравейте, аз съм Pomaga.",
    headline: "Дайте ми работата, която никой не иска да повтаря.",
    intro: "Чета определени имейли, местя данни в CRM-а, обновявам таблици и подготвям справки. Тихата офис работа се свършва, без да изяжда деня на човек от екипа.",
    firstQuestion: "Защо да ви наемем?",
    firstAnswer: "Защото добрите ви хора не трябва да прекарват сутринта в копиране от един екран в друг. Покажете ми повторението веднъж и аз ще го поема всеки следващ път.",
    interview: [
      ["Каква работа можете да поемете?", "Работа с ясни стъпки: имейлът пристига, данните се проверяват, записват се на правилното място и някой получава известие или справка."],
      ["Как ще знаете кое къде отива?", "Вие ми показвате една истинска задача от начало до край. Записваме правилата и изключенията. После следвам тях, вместо да налучквам."],
      ["Можете ли да правите плащания?", "Не сама. Мога да подготвя данните, но плащане, договор или друга необратима стъпка чака човек да я одобри."],
      ["Ще трябва ли да сменим програмите си?", "Не, ако сегашните ви системи позволяват надеждна връзка. Първо проверяваме какво вече използвате и чак тогава казваме какво е възможно."],
    ],
    closing: "Ако някой мести едни и същи данни всеки ден, покажете ми задачата. Ще ви кажем направо дали мога да я поема.",
    cta: "Покажете ми повторението",
  },
} as const;

const profile = profiles[data.slug as keyof typeof profiles];
const schemas = [
  faqSchema(data.faqs),
  breadcrumbSchema([{name:"Работи",url:site.url},{name:"AI служители",url:`${site.url}/sluzhiteli/`},{name:data.name,url:pageUrl}]),
  { "@context": "https://schema.org", "@type": "Product", name: `${data.name} — ${data.role}`, description: data.description, brand: { "@type": "Brand", name: site.brand }, url: pageUrl,
    offers: { "@type": "Offer", price: data.price, priceCurrency: data.currency, availability: "https://schema.org/InStock", url: pageUrl } },
];
---
<BaseLayout title={data.seoTitle} description={data.seoDescription} canonical={`/sluzhiteli/${data.slug}/`} image={`/og/${data.slug}.svg`} schema={schemas} bodyClass={`candidate-page candidate-page--${data.slug}`}>
  {data.slug === "vdiga" ? <>
  <section class="gloria-hero" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="gloria-hero__inner">
      <div class="gloria-hero__copy">
        <span class="gloria-role">AI рецепционист</span>
        <h1>{profile.hello}</h1>
        <p class="gloria-hero__position">Кандидатствам за рецепционист във вашия бизнес.</p>
        <p class="gloria-hero__intro">{profile.intro}</p>
        <div class="gloria-hero__actions">
          <a class="button button--spectrum" href={data.demoUrl}><Icon name="phone" /> Поканете ме на интервю</a>
          <a class="gloria-text-link" href="#umenia">Вижте какво мога <span aria-hidden="true">↓</span></a>
        </div>
        <ul class="gloria-facts" aria-label="Основни условия">
          <li>Вдигам 24/7</li><li>Говоря български</li><li>{data.priceLabel}</li>
        </ul>
      </div>
      <figure class="gloria-portrait">
        <div class="gloria-portrait__frame"><img src={profile.image} alt={profile.imageAlt} width="780" height="900" loading="eager" fetchpriority="high" decoding="sync" /></div>
        <figcaption><span class="gloria-live-dot" aria-hidden="true"></span>На линия сега</figcaption>
      </figure>
    </div>
  </section>

  <section class="gloria-file" aria-labelledby="gloria-file-title">
    <div class="gloria-file__card reveal-group">
      <header>
        <img src={profile.image} alt="" width="112" height="112" loading="lazy" />
        <div><p>Служебно досие</p><h2 id="gloria-file-title">Глория</h2><span>Кандидат № 001 · AI рецепционист</span></div>
      </header>
      <dl>
        <div class="reveal-row"><dt>Работно време</dt><dd>24/7, включително празници</dd></div>
        <div class="reveal-row"><dt>Болнични</dt><dd>0 дни</dd></div>
        <div class="reveal-row"><dt>Отпуск</dt><dd>Не ползвам</dd></div>
        <div class="reveal-row"><dt>Изпитателен срок</dt><dd>С удоволствие</dd></div>
        <div class="reveal-row"><dt>Език</dt><dd>Български</dd></div>
        <div class="gloria-file__price reveal-row"><dt>Заплата</dt><dd>{data.priceLabel}, без осигуровки</dd></div>
      </dl>
    </div>
  </section>

  <section class="gloria-skills" id="umenia" aria-labelledby="gloria-skills-title">
    <header><p>Какво мога</p><h2 id="gloria-skills-title">Работата, за която кандидатствам.</h2></header>
    <div class="gloria-skills__list reveal-group">
      {data.duties.map((duty, index) => <article class:list={["gloria-skill", index % 2 && "gloria-skill--reverse", "reveal-row"]}>
        <img src={profile.image} alt="" width="64" height="64" loading="lazy" />
        <div><span>{String(index + 1).padStart(2,"0")}</span><h3>{duty}</h3></div>
      </article>)}
    </div>
  </section>

  <section class="gloria-honesty" aria-labelledby="gloria-honesty-title">
    <span aria-hidden="true"></span>
    <p>Да сме честни от началото</p>
    <h2 id="gloria-honesty-title">Какво не мога</h2>
    <div><p>Не мога да направя кафе на колегите. Не мога да преместя масата в ъгъла.</p><p>И ако клиент попита нещо, което не знам, няма да си измислям. Ще взема името, телефона и въпроса му и ще ви ги изпратя.</p></div>
  </section>

  <section class="gloria-chat" aria-labelledby="gloria-chat-title">
    <header><p>Интервюто</p><h2 id="gloria-chat-title">Въпросите, които вероятно вече си задавате.</h2></header>
    <div class="gloria-chat__thread reveal-group">
      {profile.interview.map(([question, answer], index) => <div class="gloria-chat__exchange reveal-row">
        <p class="gloria-chat__question">— {question}</p>
        <div class="gloria-chat__answer">{index === 0 && <img src={profile.image} alt="Глория" width="48" height="48" loading="lazy" />}<p>{answer}</p></div>
      </div>)}
    </div>
  </section>

  <section class="gloria-demo" id="razgovor" aria-labelledby="gloria-demo-title">
    <div>
      <p>Живо демо</p><h2 id="gloria-demo-title">Интервюирайте ме. Сега.</h2>
      <a class="gloria-demo__call" href={data.demoUrl}>Започнете интервюто <Icon name="arrow-right" /></a>
      <span>Ще ви отговоря в браузъра. Питайте ме каквото искате.</span>
    </div>
  </section>

  <section class="gloria-team">
    <header><p>Моите колеги</p><h2>Работя най-добре в екип.</h2></header>
    <div class="agent-grid">{colleagues.map((item) => <AgentCard agent={item} compact />)}</div>
    <a class="button button--spectrum" href="/kontakti/?agent=vdiga">Назначете Глория</a>
  </section>
  <script>
    const revealItems = document.querySelectorAll<HTMLElement>(".candidate-page--vdiga .reveal-row");
    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const item = entry.target as HTMLElement;
        const siblings = Array.from(item.parentElement?.children || []);
        item.style.setProperty("--reveal-delay", `${Math.max(0, siblings.indexOf(item)) * 70}ms`);
        item.classList.add("is-visible"); observer.unobserve(item);
      }), { threshold: .16 });
      revealItems.forEach((item) => observer.observe(item));
    } else revealItems.forEach((item) => item.classList.add("is-visible"));
  </script>
  </> : <>
  <section class="candidate-hero" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="candidate-hero__portrait">
      <img src={profile.image} alt={profile.imageAlt} width="780" height="900" loading="eager" fetchpriority="high" decoding="sync" />
      <p><strong>{profile.person}</strong><span>{data.role}</span></p>
    </div>
    <div class="candidate-hero__pitch">
      <p class="candidate-hello">{profile.hello}</p>
      <h1>{profile.headline}</h1>
      <p class="candidate-opening">{profile.intro}</p>
      <div class="candidate-hero__action">
        <a class="button" href={data.demoUrl || "#razgovor"}>{profile.cta}</a>
        <p><strong>{data.priceLabel}</strong><span>Мога да започна {data.startTime}</span></p>
      </div>
    </div>
    {data.slug === "vdiga" && <aside class="candidate-cv" aria-label="Визитка на Глория">
      <p>Кандидатура за работа</p>
      <dl>
        <div><dt>Позиция</dt><dd>AI рецепционист</dd></div>
        <div><dt>Работно време</dt><dd>24/7, включително празници</dd></div>
        <div><dt>Болнични</dt><dd>0 дни</dd></div>
        <div><dt>Отпуск</dt><dd>Не ползвам</dd></div>
        <div><dt>Изпитателен срок</dt><dd>С удоволствие</dd></div>
        <div><dt>Език</dt><dd>Български</dd></div>
        <div class="candidate-cv__price"><dt>Заплата</dt><dd>{data.priceLabel}, без осигуровки</dd></div>
      </dl>
    </aside>}
  </section>

  <article class="candidate-interview" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <header class="candidate-interview__lead">
      <p>{profile.firstQuestion}</p>
      <h2>„{profile.firstAnswer}“</h2>
    </header>
    <dl class="candidate-interview__questions">
      {profile.interview.map(([question, answer]) => <div><dt>{question}</dt><dd>{answer}</dd></div>)}
    </dl>
  </article>

  <section class="candidate-scope" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="candidate-scope__heading"><h2>{data.slug === "vdiga" ? "Какво мога" : "Това мога да сваля от бюрото ви"}</h2><p>{data.slug === "vdiga" ? "Работата, за която кандидатствам." : "Не всичко. Точно тази работа."}</p></div>
    <ul>{data.duties.map((duty) => <li><Icon name="check" /><span>{duty}</span></li>)}</ul>
  </section>

  {data.slug === "vdiga" && <section class="candidate-honesty" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <p>Да сме честни от началото</p>
    <div>
      <h2>Какво не мога</h2>
      <p>Не мога да направя кафе на колегите. Не мога да преместя масата в ъгъла. И ако клиент попита нещо, което не знам, няма да си измислям. Ще взема името, телефона и въпроса му и ще ви ги изпратя.</p>
    </div>
  </section>}

  <section class="candidate-details" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div class="candidate-details__price"><p>Заплата</p><strong>{data.priceLabel}</strong><span>Точната цена зависи от обема работа и нужните връзки.</span></div>
    <div class="candidate-details__tools"><p>Мога да работя с</p><ul>{data.integrations.map((item) => <li>{item}</li>)}</ul></div>
  </section>

  <section class="candidate-faq" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div><h2>Още въпроси, преди да ме наемете</h2><p>Кратките отговори са тук. За вашата задача ще говорим конкретно.</p></div>
    <FAQ items={data.faqs} />
  </section>

  <section class="candidate-close" id="razgovor" style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
    <div><h2>{profile.closing}</h2><p>{data.slug === "vdiga" ? "Чуйте ме в примерен разговор. После ми кажете какво трябва да поема във вашия бизнес." : "Не подготвяйте задание. Напишете какво остава несвършено."}</p>{data.slug === "vdiga" && <a class="button candidate-demo-button" href={data.demoUrl}>Чуйте интервюто с Глория</a>}</div>
    <ContactForm selectedAgent={data.slug} intent="hire" />
  </section>

  <section class="candidate-team">
    <div><h2>{data.slug === "vdiga" ? "Моите колеги" : "Може би търсите друг човек"}</h2><p>{data.slug === "vdiga" ? "Другите хора в AI екипа на Работи." : "Запознайте се с останалите двама."}</p></div>
    <div class="agent-grid">{colleagues.map((item) => <AgentCard agent={item} compact />)}</div>
  </section>
  </>}
</BaseLayout>
