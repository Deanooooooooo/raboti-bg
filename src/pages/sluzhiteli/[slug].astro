---
import "../../styles/studio.css";
import "../../styles/studio-secondary.css";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentWordmark from "../../components/AgentWordmark.astro";
import ServiceExample from "../../components/ServiceExample.astro";
import SearchDiscovery from "../../components/SearchDiscovery.astro";
import "../../styles/agent-refinement.css";
import Icon from "../../components/Icon.astro";
import VdigaPricing from "../../components/VdigaPricing.astro";
import VdigaLeadForm from "../../components/VdigaLeadForm.astro";
import PishePricing from "../../components/PishePricing.astro";
import PisheLeadForm from "../../components/PisheLeadForm.astro";
import PomagaPricing from "../../components/PomagaPricing.astro";
import PomagaLeadForm from "../../components/PomagaLeadForm.astro";
import { site } from "../../data/site";
import { faqSchema, breadcrumbSchema } from "../../data/schema";

export async function getStaticPaths() {
  const agents = await getCollection("agents");
  return agents.filter((agent) => agent.data.status === "live").map((agent) => ({ params: { slug: agent.data.slug }, props: { agent, agents } }));
}

const { agent, agents } = Astro.props;
const data = agent.data;
const colleagues = agents.filter((item) => item.id !== agent.id && item.data.status === "live").sort((a,b) => a.data.order - b.data.order);
const colleagueProfiles: Record<string, { image: string; imageAlt: string; cta: string }> = {
  vdiga: { image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Глория, образът на телефонния рецепционист Vdiga", cta: "Как мога да съм полезна?" },
  pishe: { image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Как мога да съм полезен?" },
  pomaga: { image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Как мога да съм полезна?" },
};
const pageUrl = `${site.url}/sluzhiteli/${data.slug}/`;

const profiles = {
  vdiga: {
    person: "Глория",
    image: "/assets/employee-vdiga-gloria-v1.webp",
    imageAlt: "Глория, образът на телефонния рецепционист Vdiga",
    hello: "Здравейте, аз съм Глория.",
    headline: "Кандидатствам за рецепционист във вашия бизнес.",
    intro: "Не трябва да избирате между човека пред вас и телефона. Поемам разговорите, отговарям на въпроси и записвам часове по вашите правила. Клиентите получават внимание, а вие и екипът ви можете да продължите работата си.",
    firstQuestion: "Защо да назначим вас?",
