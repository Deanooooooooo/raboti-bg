---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AgentCard from "../../components/AgentCard.astro";
import { breadcrumbSchema } from "../../data/schema";
import { site } from "../../data/site";
const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title="AI служители за бизнеса | Работи"
  description="Разгледай Вдига, Помага и Пише — AI служители за телефон, оперативна работа и поддръжка на сайт."
  canonical="/sluzhiteli/"
  image="/og/sluzhiteli.svg"
  schema={breadcrumbSchema([{name:"Работи",url:site.url},{name:"AI служители",url:`${site.url}/sluzhiteli/`}])}
>
  <section class="page-hero"><div class="shell narrow"><p class="eyebrow">екипът</p><h1>AI служители с ясна работа.</h1><p>Избери роля, виж какво поема и какви граници има. Ако задачата ти не пасва на никоя позиция, ще ти кажем честно.</p></div></section>
  <section class="section"><div class="shell agent-grid">{agents.map((agent) => <AgentCard agent={agent} />)}</div></section>
</BaseLayout>
