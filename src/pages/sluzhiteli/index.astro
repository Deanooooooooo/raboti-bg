---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { breadcrumbSchema } from "../../data/schema";
import { site } from "../../data/site";

const roleOrder = ["vdiga", "pishe", "pomaga"];
const agents = (await getCollection("agents"))
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => roleOrder.indexOf(a.data.slug) - roleOrder.indexOf(b.data.slug));
const profiles: Record<string, { image: string; alt: string; problem: string; action: string; examples: string[] }> = {
  vdiga: { image: "/assets/employee-vdiga-gloria-v1.webp", alt: "Глория, образът на AI рецепциониста Vdiga", problem: "Телефонът звъни, докато всички са заети.", action: "Поема обажданията", examples: ["Отговаря на обичайни въпроси", "Записва часове и заявки", "Изпраща обобщение към екипа"] },
  pishe: { image: "/assets/employee-pishe-v1.webp", alt: "Pishe, AI уеб мениджър за сайт, съдържание и SEO", problem: "Сайтът изостава от това, което бизнесът вече предлага.", action: "Поема работата по сайта", examples: ["Изгражда или развива сайта", "Пише страници и обновява цени", "Работи по SEO и GEO"] },
  pomaga: { image: "/assets/employee-pomaga-v1.webp", alt: "Pomaga, AI оперативен асистент за повтаряща се работа", problem: "Информацията се преписва между имейл, CRM и таблици.", action: "Поема повтарящия се процес", examples: ["Прехвърля данни между системи", "Създава задачи и справки", "Спира за одобрение преди риск"] },
};
const schemas = [
  breadcrumbSchema([{ name: "Raboti", url: site.url }, { name: "AI служители", url: `${site.url}/sluzhiteli/` }]),
  { "@context": "https://schema.org", "@type": "ItemList", name: "AI служители от Raboti", numberOfItems: agents.length, itemListElement: agents.map((agent, index) => ({ "@type": "ListItem", position: index + 1, url: `${site.url}/sluzhiteli/${agent.data.slug}/`, name: agent.data.name })) },
];
---
<BaseLayout title="Изберете AI служител | Raboti" description="Vdiga поема телефона, Pishe се грижи за сайта, а Pomaga върши повтарящата се работа между системите. Сравнете задачите, границите и началните цени." canonical="/sluzhiteli/" image="/og/sluzhiteli.svg" schema={schemas} bodyClass="team-page">
  <section class="team-hero">
    <div class="shell team-hero__grid">
      <div><h1>Коя работа остава несвършена?</h1><p>Изберете какво ви бави най-често. Vdiga поема телефона, Pishe работи по сайта, а Pomaga свързва повтарящите се стъпки между програмите ви.</p></div>
      <div class="team-hero__guide" aria-label="Как да изберете служител"><strong>Тръгнете от работата, която чака.</strong><span><i style="--signal:#16bfa7"></i> Изпускате обаждания → Vdiga</span><span><i style="--signal:#e86c52"></i> Сайтът чака промени → Pishe</span><span><i style="--signal:#7560ec"></i> Данните се преписват на ръка → Pomaga</span></div>
    </div>
  </section>
  <section class="team-roster" aria-label="Налични AI служители">
    <div class="shell team-roster__list">
      {agents.map((agent) => { const data = agent.data; const profile = profiles[data.slug]; return (
        <article class:list={["team-role", `team-role--${data.slug}`]} style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
          <div class="team-role__portrait"><img src={profile.image} width="720" height="960" alt={profile.alt} loading="eager" decoding="async" /><span><i></i> Приема нови задачи</span></div>
          <div class="team-role__content"><p class="team-role__problem">{profile.problem}</p><h2>{data.name}</h2><strong class="team-role__action">{profile.action}</strong><p>{data.summary}</p><ul>{profile.examples.map((example) => <li><Icon name="check" /> <span>{example}</span></li>)}</ul></div>
          <footer><div><span>Начална цена</span><strong>{data.priceLabel}</strong></div><a href={`/sluzhiteli/${data.slug}/`} aria-label={`Вижте задачите, плановете и кандидатурата на ${data.name}`}>Вижте кандидатурата <Icon name="arrow-right" /></a></footer>
        </article>
      ); })}
    </div>
  </section>
  <section class="team-close"><div class="shell team-close__grid"><div><h2>Имате друга повтаряща се задача?</h2><p>Опишете как я вършите сега. Ще проверим дали някой от тримата може да я поеме и ще ви отговорим по имейл до един работен ден.</p></div><a class="button button--spectrum" href="/#naemi">Опишете задачата <Icon name="arrow-right" /></a></div></section>
</BaseLayout>
<style>
  :global(.team-page){background:#f4f1ec;color:#111426}.team-hero{position:relative;overflow:hidden;padding:clamp(88px,10vw,148px) 0 clamp(68px,8vw,108px);background:radial-gradient(circle at 88% 4%,rgba(143,124,255,.2),transparent 30%),radial-gradient(circle at 8% 86%,rgba(45,226,208,.12),transparent 30%),#10142c;color:#fff}.team-hero__grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(320px,.62fr);gap:clamp(52px,9vw,130px);align-items:end}.team-hero h1{max-width:11ch;margin:0;color:#fff;font-size:clamp(3.25rem,6vw,6rem);line-height:1;letter-spacing:-.04em;text-wrap:balance}.team-hero p{max-width:59ch;margin:30px 0 0;color:rgba(255,255,255,.78);font-size:clamp(1.08rem,1.5vw,1.3rem);line-height:1.58}.team-hero__guide{display:grid;padding:8px 0;border-top:1px solid rgba(255,255,255,.24);border-bottom:1px solid rgba(255,255,255,.24)}.team-hero__guide strong{padding:18px 0 16px;color:#fff}.team-hero__guide span{display:flex;align-items:center;gap:12px;padding:13px 0;border-top:1px solid rgba(255,255,255,.1);color:rgba(255,255,255,.78);font-size:.92rem}.team-hero__guide i{width:8px;height:8px;border-radius:50%;background:var(--signal);box-shadow:0 0 16px color-mix(in srgb,var(--signal) 70%,transparent)}
  .team-roster{padding:clamp(72px,8vw,120px) 0}.team-roster__list{display:grid;gap:24px}.team-role{display:grid;grid-template-columns:minmax(250px,.72fr) minmax(330px,1.1fr) minmax(235px,.55fr);min-height:430px;overflow:hidden;border:1px solid rgba(17,20,38,.11);border-radius:16px;background:#fff;box-shadow:0 28px 70px -54px rgba(25,20,50,.55)}.team-role__portrait{position:relative;min-height:430px;overflow:hidden;background:var(--agent-soft)}.team-role__portrait::after{position:absolute;inset:55% 0 0;background:linear-gradient(transparent,color-mix(in srgb,var(--agent-soft) 82%,white));content:""}.team-role__portrait img{width:100%;height:100%;object-fit:cover;object-position:center 20%}.team-role--vdiga .team-role__portrait img{transform:scale(1.1);transform-origin:center 20%}.team-role__portrait>span{position:absolute;z-index:2;bottom:22px;left:22px;display:inline-flex;align-items:center;gap:8px;padding:8px 11px;border-radius:999px;background:#fff;color:#41414c;font-size:.75rem;font-weight:600;box-shadow:0 10px 28px -20px #111426}.team-role__portrait>span i{width:7px;height:7px;border-radius:50%;background:var(--agent)}
  .team-role__content{display:flex;flex-direction:column;justify-content:center;padding:clamp(32px,4vw,58px)}.team-role__problem{max-width:42ch!important;margin:0 0 26px!important;color:var(--agent)!important;font-size:.92rem!important;font-weight:650!important}.team-role h2{margin:0;color:#111426;font-size:clamp(3rem,4vw,4.7rem);line-height:.95;letter-spacing:-.04em}.team-role__action{display:block;margin-top:13px;color:#111426;font-size:clamp(1.18rem,1.6vw,1.45rem);line-height:1.25}.team-role__content>p:not(.team-role__problem){max-width:46ch;margin:18px 0 24px;color:#62616c;font-size:1rem;line-height:1.55}.team-role ul{display:grid;gap:10px;margin:0;padding:0;list-style:none}.team-role li{display:flex;gap:10px;align-items:center;color:#34343d;font-size:.9rem}.team-role li :global(svg){width:17px;color:var(--agent)}
  .team-role footer{display:flex;flex-direction:column;justify-content:flex-end;gap:26px;padding:32px;border-left:1px solid rgba(17,20,38,.09);background:color-mix(in srgb,var(--agent-soft) 36%,white)}.team-role footer>div{display:grid;gap:7px}.team-role footer span{color:#6b6a74;font-size:.76rem}.team-role footer strong{color:#111426;font-size:1.18rem;line-height:1.25}.team-role footer a{display:flex;min-height:56px;align-items:center;justify-content:space-between;gap:12px;padding:0 19px;border-radius:999px;background:#111426;color:#fff;font-size:.9rem;font-weight:650;text-decoration:none;transition:background-color .18s ease,transform .18s ease}.team-role footer a:hover{background:var(--agent);transform:translateY(-2px)}.team-role footer a:focus-visible{outline:3px solid var(--agent);outline-offset:3px}.team-role footer a :global(svg){width:18px}
  .team-close{margin:0 12px 12px;padding:clamp(72px,8vw,112px) 0;border-radius:16px;background:radial-gradient(circle at 78% 16%,rgba(45,226,208,.13),transparent 32%),#202652;color:#fff}.team-close__grid{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:48px;align-items:end}.team-close h2{max-width:13ch;margin:0;color:#fff;font-size:clamp(2.8rem,5vw,5rem);line-height:1.02;letter-spacing:-.04em}.team-close p{max-width:60ch;margin:24px 0 0;color:rgba(255,255,255,.78);font-size:1.08rem;line-height:1.58}.team-close a{white-space:nowrap}
  @media(max-width:960px){.team-hero__grid{grid-template-columns:1fr}.team-hero__guide{max-width:620px}.team-role{grid-template-columns:minmax(220px,.7fr) 1.3fr}.team-role footer{grid-column:1/-1;flex-direction:row;align-items:center;justify-content:space-between;border-top:1px solid rgba(17,20,38,.09);border-left:0}.team-role footer a{min-width:250px}.team-close__grid{grid-template-columns:1fr;align-items:start}.team-close a{width:max-content}}
  @media(max-width:650px){.team-hero{padding-top:72px}.team-hero h1{font-size:clamp(2.85rem,13vw,4rem)}.team-role{grid-template-columns:1fr}.team-role__portrait{min-height:350px}.team-role__content{padding:30px 24px 34px}.team-role h2{font-size:3.2rem}.team-role footer{grid-column:auto;align-items:stretch;flex-direction:column;padding:24px}.team-role footer a{min-width:0}.team-close{margin:0 8px 8px;padding-inline:8px}.team-close a{width:100%;justify-content:center}}@media(prefers-reduced-motion:reduce){.team-role footer a{transition:none}}
</style>
