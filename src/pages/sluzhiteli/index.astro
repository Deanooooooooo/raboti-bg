---

import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/studio.css";
import Icon from "../../components/Icon.astro";
import AgentWordmark from "../../components/AgentWordmark.astro";
import { breadcrumbSchema } from "../../data/schema";
import { site } from "../../data/site";

const roleOrder = ["vdiga", "pishe", "pomaga"];
const agents = (await getCollection("agents"))
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => roleOrder.indexOf(a.data.slug) - roleOrder.indexOf(b.data.slug));
const profiles: Record<string, { image: string; alt: string; problem: string; action: string; examples: string[] }> = {
  vdiga: { image: "/assets/employee-vdiga-gloria-v1.webp", alt: "Глория, образът на AI рецепциониста Vdiga", problem: "Телефонът звъни, докато всички са заети.", action: "Поема обажданията", examples: ["Отговаря на обичайни въпроси", "Записва часове и заявки", "Изпраща обобщение към екипа"] },
  pishe: { image: "/assets/employee-pishe-v1.webp", alt: "Pishe, AI уеб мениджър за сайт, съдържание и SEO", problem: "Сайтът изостава от това, което бизнесът вече предлага.", action: "Поема работата по сайта", examples: ["Изгражда или развива сайта", "Пише страници и обновява цени", "Работи по SEO и GEO"] },
  pomaga: { image: "/assets/employee-pomaga-v1.webp", alt: "Pomaga, AI оперативен асистент за повтаряща се работа", problem: "Информацията се преписва между имейл, CRM и таблици.", action: "Поема повтарящия се процес", examples: ["Прехвърля данни между системи", "Създава задачи и справки", "Спира за одобрение преди риск"] },
};
const schemas = [
  breadcrumbSchema([{ name: "Raboti", url: site.url }, { name: "AI служители", url: `${site.url}/sluzhiteli/` }]),
  { "@context": "https://schema.org", "@type": "ItemList", name: "AI служители от Raboti", numberOfItems: agents.length, itemListElement: agents.map((agent, index) => ({ "@type": "ListItem", position: index + 1, url: `${site.url}/sluzhiteli/${agent.data.slug}/`, name: agent.data.name })) },
];
---
<BaseLayout title="Изберете AI служител | Raboti" description="Vdiga поема телефона, Pishe се грижи за сайта, а Pomaga върши повтарящата се работа между системите. Готови роли или AI служител по поръчка." canonical="/sluzhiteli/" image="/og/sluzhiteli.svg" schema={schemas} bodyClass="studio studio-directory">
<section class="s-directory-hero s-wrap"><h1>Коя работа искате<br/><span>да поемем?</span></h1><div><p>Vdiga поема телефона, Pishe се грижи за сайта, а Pomaga свързва повтарящите се стъпки между програмите ви. Сравнете услугите и изберете откъде да започнем.</p><a class="s-text-link" href="#directory-custom">Имате друг процес? Обсъдете служител по поръчка.</a></div></section>
<nav class="s-directory-nav s-wrap" aria-label="Към услугата"><a href="#directory-vdiga">Vdiga <span>Обаждания</span></a><a href="#directory-pishe">Pishe <span>Сайт и откриваемост</span></a><a href="#directory-pomaga">Pomaga <span>Администрация</span></a><a href="#directory-custom">По поръчка</a></nav>
<section class="s-directory-roster s-wrap" aria-label="Налични AI служители">{agents.map(agent=>{const data=agent.data;const profile=profiles[data.slug];return <article id={`directory-${data.slug}`} class={`s-service-panel s-agent-${data.slug}`}>
<div class="s-profile-visual"><img src={profile.image} width="720" height="960" alt={profile.alt} loading="lazy"/><div><span>{data.role}</span><AgentWordmark slug={data.slug} tone="light" alt="" class="s-profile-wordmark" loading="eager"/></div></div>
<div class="s-profile-content"><h2>{profile.problem}</h2><p>{data.summary}</p><ul class="s-directory-scope">{profile.examples.map(example=><li><Icon name="check"/><span>{example}</span></li>)}</ul><div class="s-service-facts"><div><span>Месечна услуга</span><strong>{data.priceLabel}</strong></div><div><span>Преди старта</span><strong>Обхват, срок и цена</strong></div></div><small>Без ДДС. Настройката се заплаща отделно.</small><div class="s-actions"><a class="s-primary" href={`/sluzhiteli/${data.slug}/`}>Как работи {data.name} <Icon name="arrow-right"/></a><a class="s-text-link" href="/ceni/">Сравнете плановете</a></div></div>
</article>})}</section>
<section class="s-directory-custom s-wrap" id="directory-custom"><div><h2>Работата ви не се побира<br/><span>в тези три роли?</span></h2><p>Обсъдете AI служител по поръчка. Първо проверяваме дали готова роля покрива нуждата ви. Ако не, уточняваме вашия процес, възможностите за автоматизация и цената, преди да решите.</p></div><a class="s-primary" href="/?agent=custom#naemi">Обсъдете вашия процес <Icon name="arrow-right"/></a></section>
</BaseLayout>
<style>
.s-directory-hero{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding-block:140px 44px}
.s-directory-hero h1{font-size:var(--type-display);line-height:1.08}.s-directory-hero h1 span{color:#3157c8}
.s-directory-hero p,.s-directory-custom p{font-size:var(--type-body);line-height:1.7;color:var(--muted);max-width:62ch}.s-directory-hero .s-text-link{display:inline-block;margin-top:20px}
.s-directory-nav{display:flex;flex-wrap:wrap;gap:12px;padding-bottom:32px}.s-directory-nav a{display:flex;gap:10px;align-items:center;padding:13px 20px;border-radius:999px;background:#edf1f8;color:var(--ink);font-size:var(--type-body)}.s-directory-nav a:hover{background:#e2e7f4}.s-directory-nav span{font-size:var(--type-label);color:var(--muted)}
.s-directory-roster{display:grid;gap:28px}.s-directory-roster h2{font-size:var(--type-heading);line-height:1.15}.s-directory-scope{list-style:none;padding:0;margin:24px 0;display:grid;gap:12px}.s-directory-scope li{display:flex;gap:12px;font-size:var(--type-body);line-height:1.6;color:var(--ink)}.s-directory-scope :global(svg){width:18px;height:18px;flex:0 0 18px;color:#5154cc;margin-top:4px}.s-actions :global(svg),.s-directory-custom :global(svg){width:20px;height:20px;flex-shrink:0}
.s-directory-custom{display:grid;grid-template-columns:1fr auto;gap:50px;align-items:center;padding-block:68px}.s-directory-custom p{margin-top:22px}.s-directory-custom .s-primary{white-space:nowrap}
@media(max-width:900px){.s-directory-hero{gap:30px}.s-directory-custom{grid-template-columns:1fr;gap:26px}.s-directory-custom .s-primary{justify-self:start}.s-directory-roster h2{font-size:var(--type-title)}}
@media(max-width:650px){.s-directory-hero{grid-template-columns:1fr;padding-block:112px 28px;gap:22px}.s-directory-nav{display:grid;grid-template-columns:1fr 1fr;gap:8px}.s-directory-nav a{padding:12px;justify-content:center}.s-directory-nav span{display:none}.s-directory-roster{gap:24px}.s-directory-custom{padding-block:44px}.s-directory-custom .s-primary{white-space:normal}.s-directory-scope{margin-block:20px}}
</style>
