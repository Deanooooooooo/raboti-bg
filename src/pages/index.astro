---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentCard from "../components/AgentCard.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import FAQ from "../components/FAQ.astro";
import ContactForm from "../components/ContactForm.astro";
import { faqSchema, breadcrumbSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Работи", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Работи",
    itemListElement: agents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="Работи — наеми AI служител за бизнеса"
  description="Наеми AI служител, който вдига телефона, поддържа сайта или поема ръчната работа между системите ти. От 97 лв. месечно."
  schema={schemas}
>
  <section class="hero" data-hero>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI служители за българския бизнес</p>
        <h1 class="verb-line" aria-label="Вдига. Помага. Пише. Смята. Работи.">
          <span style="--delay:0">Вдига. </span>
          <span style="--delay:1">Помага. </span>
          <span style="--delay:2">Пише. </span>
          <span style="--delay:3">Смята. </span>
          <span class="verb-brand" style="--delay:4">Работи.</span>
        </h1>
        <p class="hero-lead">Наеми AI служител, който поема ясна работа и я върши по правилата на твоя бизнес.</p>
        <div class="hero-actions">
          <a class="button" href={`tel:${site.salesPhoneHref}`} data-track="tel">Обади се за демо</a>
          <a class="text-link" href="#ekip">Разгледай екипа <span>↓</span></a>
        </div>
        <p class="hero-phone"><span>Телефон за демонстрация</span><a href={`tel:${site.salesPhoneHref}`}>{site.salesPhone}</a></p>
      </div>
      <aside class="hire-note" aria-label="Какво наемате">
        <div class="hire-note__head"><span class="pulse"></span> Нов начин да добавиш човек към екипа</div>
        <blockquote>„Не търся още една система. Търся някой да поеме работата.“</blockquote>
        <p>Точно това прави Работи: настройва AI служител за конкретна роля, с ясни задачи, граници и месечна цена.</p>
        <a href="/kontakti/">Кажи ни какво искаш да поеме →</a>
      </aside>
    </div>
  </section>

  <section class="pain-strip" aria-label="Проблеми, които Работи поема">
    <div class="shell pain-grid">
      <p><strong>Телефонът звъни,</strong> а всички са заети.</p>
      <p><strong>Сайтът чака,</strong> защото никой няма време.</p>
      <p><strong>Една и съща информация</strong> се въвежда на три места.</p>
    </div>
  </section>

  <section class="section" id="ekip">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">свободни AI служители</p><h2>Кого искаш да добавиш към екипа?</h2></div>
        <p>Всеки служител има конкретна роля. Не купуваш „AI решение“, а работа, която вече не остава за после.</p>
      </div>
      <div class="agent-grid">
        {agents.map((agent) => <AgentCard agent={agent} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">как започва</p><h2>От задача до нов колега в три стъпки.</h2></div>
      </div>
      <ol class="steps">
        <li data-step="1"><div><h3>Избираш роля</h3><p>Казваш кое отнема време, къде се губят заявки и какво не бива да се прави без човек.</p></div></li>
        <li data-step="2"><div><h3>Настройваме я</h3><p>Даваме на AI служителя информация, достъпи и правила. Тестваме с реални случаи.</p></div></li>
        <li data-step="3"><div><h3>Започва работа</h3><p>Следиш какво е свършено. Рисковите действия чакат одобрение, вместо да се изпълняват на сляпо.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="section comparison-section">
    <div class="shell">
      <div class="section-head">
        <div><p class="eyebrow">човек и AI служител</p><h2>Човешката преценка остава. Рутината вече има кой да я поеме.</h2></div>
        <p>AI служителят е силен в повтарящата се работа. Хората остават там, където са нужни отговорност, емпатия и решение.</p>
      </div>
      <ComparisonTable />
    </div>
  </section>

  <section class="section demo-section">
    <div class:list={["shell", "demo-grid", !site.showCaseStudy && "demo-grid--single"]}>
      <div>
        <p class="eyebrow">първото интервю е по телефона</p>
        <h2>Чуй как говори Вдига.</h2>
        <p>Отвори демото на Vdiga и чуй примерен разговор. После се обади, за да обсъдим какви въпроси трябва да поема за твоя бизнес.</p>
        <div class="hero-actions">
          <a class="button button--light" href="https://vdiga.bg/demo/" target="_blank" rel="noopener">Чуй примерен разговор</a>
          <a class="text-link text-link--light" href={`tel:${site.salesPhoneHref}`}>{site.salesPhone}</a>
        </div>
      </div>
      {site.showCaseStudy && <div class="proof-card">
        <span class="status">Място за първия казус</span>
        <h3>Верига студиа в търговски центрове</h3>
        <p>Компонентът е готов за реалните резултати след пилота. Няма да публикуваме измислени числа.</p>
        <div class="metric-grid">
          <div><strong>—</strong><span>поети обаждания</span></div>
          <div><strong>—</strong><span>записани часове</span></div>
        </div>
      </div>}
    </div>
  </section>

  <section class="section">
    <div class="shell split">
      <div><p class="eyebrow">чести въпроси</p><h2>Преди да наемеш AI служител.</h2></div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section class="section final-cta">
    <div class="shell final-grid">
      <div><p class="eyebrow">кажи ни какво остава несвършено</p><h2>Нека намерим първата работа, която да поеме.</h2><p>Три полета. Без плащане. Ще се обадим до един работен ден.</p></div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
