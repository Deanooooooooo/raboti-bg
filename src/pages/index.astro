---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentAvatar from "../components/AgentAvatar.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import WorkforceConsole from "../components/WorkforceConsole.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Работи", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Работи",
    itemListElement: agents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="Работи — наеми AI служител за бизнеса"
  description="Наеми AI служител за телефонни разговори, сайт, операции и повтаряща се работа. Избираш роля, правила и човешки контрол."
  canonical="/"
  schema={schemas}
  bodyClass="home-art"
>
  <section class="home-hero" data-hero>
    <div class="home-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="home-noise" aria-hidden="true"></div>
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="spectrum-label"><span></span> AI екип за реалната работа</p>
        <h1>Наеми <em>AI служител.</em><br />Освободи човешкия екип.</h1>
        <p class="home-hero__lead">Работи събира AI служители с конкретни роли, граници и месечна цена. Те поемат телефона, сайта и повтарящата се работа между системите ти.</p>
        <div class="home-hero__actions">
          <a class="button button--spectrum" href="#ekip">Разгледай екипа <Icon name="arrow-down" /></a>
          <a class="home-link" href="#proces">Виж как започват <Icon name="arrow-right" /></a>
        </div>
        <div class="home-hero__signals" aria-label="Основни характеристики">
          <span><i></i> Конкретна роля</span>
          <span><i></i> Човешки контрол</span>
          <span><i></i> Дневник на работата</span>
        </div>
      </div>
      <WorkforceConsole />
    </div>
  </section>

  <section class="home-facts" aria-label="Как се наема AI служител">
    <div class="shell home-facts__grid">
      <div><span>01</span><strong>Избираш роля</strong><p>Не купуваш общ „AI пакет“, а конкретна работа.</p></div>
      <div><span>02</span><strong>Задаваш граници</strong><p>Определяш кое прави сам и кое чака човек.</p></div>
      <div><span>03</span><strong>Виждаш резултата</strong><p>Задачите, решенията и следващите стъпки остават видими.</p></div>
    </div>
  </section>

  <section class="home-section roster-section" id="ekip">
    <div class="shell">
      <div class="home-heading">
        <div><p class="spectrum-label spectrum-label--dark"><span></span> AI служители</p><h2>Един екип.<br /><em>Различни таланти.</em></h2></div>
        <p>Всеки служител има собствена роля, работна среда и правила. Добавяш само този, за когото вече имаш истинска работа.</p>
      </div>

      <div class="roster-grid">
        {agents.map((agent) => {
          const data = agent.data;
          return (
            <article class:list={["roster-card", `roster-card--${data.slug}`, data.status === "soon" && "roster-card--soon"]} style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
              <div class="roster-card__halo" aria-hidden="true"></div>
              <header>
                <AgentAvatar name={data.name} slug={data.slug} accent={data.accent} accentSoft={data.accentSoft} size="small" />
                <span class="roster-status"><i></i>{data.status === "live" ? "може да започне" : "подготвя се"}</span>
              </header>
              <div class="roster-card__body">
                <p>{data.role}</p>
                <h3>{data.name}</h3>
                <span>{data.summary}</span>
              </div>
              <footer>
                <div><small>{data.status === "live" ? "Месечна цена" : "Достъп"}</small><strong>{data.priceLabel}</strong></div>
                <a href={`/sluzhiteli/${data.slug}/`} aria-label={`Виж ${data.name}`}><Icon name="arrow-right" /></a>
              </footer>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="home-section process-section" id="proces">
    <div class="shell process-layout">
      <div class="process-copy">
        <p class="spectrum-label"><span></span> Един процес, видим докрай</p>
        <h2>Работата се движи.<br /><em>Контролът остава.</em></h2>
        <p>AI служителят не получава неограничен достъп. Той работи по одобрени правила, пази контекст и спира там, където е нужна човешка преценка.</p>
        <ul class="process-principles">
          <li><span>01</span><div><strong>Събитие започва задачата</strong><small>Обаждане, имейл, формуляр или график.</small></div></li>
          <li><span>02</span><div><strong>Ролята изпълнява разрешеното</strong><small>С конкретна информация, системи и граници.</small></div></li>
          <li><span>03</span><div><strong>Човекът поема изключението</strong><small>Рискът, неяснотата и необратимите действия чакат.</small></div></li>
        </ul>
      </div>
      <WorkflowVisual />
    </div>
  </section>

  <section class="home-section workmap-section" id="karta">
    <div class="shell">
      <div class="home-heading home-heading--center">
        <div><p class="spectrum-label spectrum-label--dark"><span></span> Карта на работата</p><h2>Не още един чат.<br /><em>Система, която върши.</em></h2></div>
        <p>Работи свързва входящата работа с подходяща роля, човешко решение и отчетим резултат.</p>
      </div>
      <div class="workmap">
        <div class="workmap__orbit" aria-hidden="true"></div>
        <div class="workmap__core"><span>raboti.bg</span><strong>AI екип</strong><small>роли · правила · отчет</small></div>
        <div class="workmap__node workmap__node--phone"><Icon name="phone" /><div><strong>Телефон</strong><span>разговори и записвания</span></div></div>
        <div class="workmap__node workmap__node--mail"><Icon name="mail" /><div><strong>Имейл</strong><span>заявки и задачи</span></div></div>
        <div class="workmap__node workmap__node--web"><Icon name="globe" /><div><strong>Сайт</strong><span>съдържание и форми</span></div></div>
        <div class="workmap__node workmap__node--systems"><Icon name="database" /><div><strong>Системи</strong><span>CRM, таблици, календар</span></div></div>
        <div class="workmap__node workmap__node--human"><Icon name="user-check" /><div><strong>Човек</strong><span>решение при риск</span></div></div>
      </div>
    </div>
  </section>

  <section class="home-section boundaries-section" id="kontrol">
    <div class="shell boundaries-grid">
      <div class="boundary-intro">
        <p class="spectrum-label"><span></span> Замислено за реален бизнес</p>
        <h2>Автоматизация без<br /><em>загуба на контрол.</em></h2>
      </div>
      <div class="boundary-card boundary-card--cyan"><span>01</span><h3>Започва с ясна длъжност</h3><p>Роля, задачи, цена и очакван резултат преди настройката.</p></div>
      <div class="boundary-card boundary-card--violet"><span>02</span><h3>Работи само в позволеното</h3><p>Достъпите и действията следват предварително одобрени правила.</p></div>
      <div class="boundary-card boundary-card--coral"><span>03</span><h3>Ескалира, вместо да измисля</h3><p>Неясният или рисков случай отива при човек с наличния контекст.</p></div>
      <div class="boundary-card boundary-card--lime"><span>04</span><h3>Оставя следа след всяка задача</h3><p>Виждаш какво е направено и къде е нужна следваща стъпка.</p></div>
    </div>
  </section>

  <section class="home-section home-faq-section">
    <div class="shell home-faq-grid">
      <div><p class="spectrum-label spectrum-label--dark"><span></span> Преди първия работен ден</p><h2>Въпросите, които имат значение.</h2><p>Не ти трябва технически екип, за да започнеш. Трябва ни конкретна работа, която днес остава несвършена или отнема твърде много време.</p></div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section class="home-contact" id="naemi">
    <div class="home-contact__aurora" aria-hidden="true"></div>
    <div class="shell home-contact__grid">
      <div>
        <p class="spectrum-label"><span></span> Добави първата роля</p>
        <h2>Каква работа чака<br /><em>своя AI служител?</em></h2>
        <p>Опиши бизнеса и задачата. Ще ти кажем коя роля пасва, какво трябва да се свърже и къде ще остане човешкият контрол.</p>
        <div class="contact-spectrum" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <ContactForm title="Разкажи ни за работата" />
    </div>
  </section>
</BaseLayout>
