---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import AgentWordmark from "../components/AgentWordmark.astro";
import "../styles/studio.css";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs as originalFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgentOrder = ["vdiga", "pishe", "pomaga"];
const liveAgents = agents
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => liveAgentOrder.indexOf(a.data.slug) - liveAgentOrder.indexOf(b.data.slug));
const agentProfiles: Record<string, { name: string; image: string; imageAlt: string; cta: string; promise: string; summary: string; fit: string }> = {
  vdiga: { name: "Vdiga", fit: "За екипи, които не смогват да вдигат", image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Gloria, образът на AI рецепциониста Vdiga", cta: "Вижте как работи Vdiga", promise: "Докато сте с един клиент, другият получава отговор.", summary: "Vdiga приема обаждания, отговаря на въпроси и записва часове. Клиентите могат да се свържат с бизнеса, без телефонът постоянно да прекъсва работата ви." },
  pishe: { name: "Pishe", fit: "За бизнеси, чийто сайт има нужда от постоянна грижа", image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Вижте как работи Pishe", promise: "Бизнесът се променя. Сайтът ви е в крак с него.", summary: "Pishe обновява сегашния ви сайт автоматично по уговорени правила, развива съдържанието за Google и AI отговорите и изгражда нов сайт, ако нямате." },
  pomaga: { name: "Pomaga", fit: "За екипи с повтаряща се администрация", image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Вижте как работи Pomaga", promise: "От имейла до CRM, без да преписвате данните.", summary: "Pomaga обработва запитвания и прехвърля данни между имейла, CRM и задачите. Повтарящите се стъпки не зависят от това кой ще намери време да ги свърши." },
};
const homeFaqs = [
 {question: "Мога ли да поръчам AI служител за друга работа?", answer: "Да. Ако работата ви не се покрива от Vdiga, Pishe или Pomaga, обсъждаме AI служител по поръчка. Покажете ни как протича процесът, кои програми използвате и какъв резултат ви трябва. Първо проверяваме дали можем да го поемем надеждно. След това получавате предложение с конкретен обхват, цена и правила за човешко одобрение. Ако съществуващ служител е подходящ, ще ви предложим него."},
 {question: "Какво получавам, когато наема AI служител?", answer: "Услуга за конкретна работа във вашия бизнес, а не само достъп до AI програма. Уточняваме задачите, подготвяме служителя и го свързваме с необходимата информация и системи. Вие знаете какво поема и в кои случаи трябва да ви попита."},
 {question: "Колко струва и има ли такса за настройка?", answer: "Месечните планове започват от €97 за Vdiga, €197 за Pishe и €297 за Pomaga, без ДДС. Първоначалната настройка се плаща отделно. Получавате точен обхват и обща цена преди да започнем. Нов сайт или голям редизайн също се оферира отделно."},
 {question: "Pishe може ли да обновява сегашния ми сайт автоматично?", answer: "Да, ако сайтът позволява надежден достъп за редакция и връщане на предишна версия. Pishe прилага предварително разрешените актуализации. Нови цени, оферти и важни обещания към клиентите първо се потвърждават от вас. Ако нямате сайт, може да изгради нов."},
 {question: "Как помагате за откриването на бизнеса в Google и AI отговорите?", answer: "Pishe подобрява страниците за услугите, актуализира информацията и подготвя полезни отговори на въпросите на клиентите. Работи по техническата достъпност за търсачките и структурираното описание на бизнеса. Това подпомага SEO и откриваемостта в AI отговори, но не гарантира позиция или препоръка от Google или ChatGPT."},
 ...originalFaqs.filter(item => ["Трябва ли да сменим програмите, които използваме?", "Може ли AI служителят да действа без човешки контрол?", "Кой стои зад Raboti?"].includes(item.question))
];
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Raboti", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Raboti",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "97",
      highPrice: "297",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Raboti",
    itemListElement: liveAgents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---
<BaseLayout title="AI служители за бизнеса — телефон, сайт и администрация | Raboti" description="Наемете AI служител за обаждания, автоматична поддръжка на сайт, SEO и ежедневна администрация. Готови роли или AI агент по поръчка за вашия процес. Вижте цените и как започваме." canonical="/" image="/assets/brand/social/raboti-home-social.jpg" imageAlt="Raboti — AI служители за българския бизнес. Не вършете работата сами." imageWidth={1200} imageHeight={675} schema={schemas} bodyClass="studio">
<section class="s-hero s-wrap">

 <div class="s-intro"><h1>AI служители за бизнеса.<br/><span>Не вършете всичко сами.</span></h1><p class="s-lead">Raboti настройва и поддържа AI агенти за конкретна работа: входящи обаждания, актуализации по сайта и задачи между имейл и CRM. Получавате управлявана услуга с уговорен обхват и правила за човешко одобрение — не просто достъп до AI програма.</p><div class="s-actions"><a class="s-primary" href="#ekip">Вижте услугите и цените <span>↗︎</span></a><a class="s-text-link" href="#naemi">Разкажете ни как работите</a></div><p class="s-caption">Избирате една услуга или комбинирате няколко. <a href="#ekip" data-show-custom>Имате друга работа? Обсъдете AI служител по поръчка.</a></p></div>
 <div class="s-stage" aria-label="Илюстративен пример за работа на AI служител">

  
  
  <div class="s-work-window"><div class="s-window-bar"><small>Пример за работа</small><i></i></div><div class="s-person"><img src="/assets/employee-vdiga-gloria-v1.webp" width="64" height="64" alt="Глория — образът на Vdiga"/><div><AgentWordmark slug="vdiga" tone="dark" class="s-demo-wordmark" loading="eager" fetchpriority="high"/><span data-demo-role>AI рецепционист</span></div><span class="s-person-icon" aria-hidden="true">↗︎</span></div><p class="s-request-label">Работа за служителя</p><p class="s-demo-question" data-demo-question>„Може ли час за утре следобед?“</p><div class="s-result" aria-live="polite" aria-atomic="true"><span class="s-result-icon" aria-hidden="true">✓</span><div><small data-demo-state>Резултат за екипа</small><strong data-demo-result>Часът е записан.</strong><span data-demo-detail>Утре, 14:30 · Обобщението е готово.</span></div></div><a class="s-demo-link" data-demo-link href="/sluzhiteli/vdiga/">Как работи Vdiga <span>↗︎</span></a></div>
  <div class="s-stage-tabs" aria-label="Изберете пример"><button type="button" data-role="vdiga" aria-pressed="true">Vdiga</button><button type="button" data-role="pishe" aria-pressed="false">Pishe</button><button type="button" data-role="pomaga" aria-pressed="false">Pomaga</button></div><p class="s-stage-caption">Илюстративен пример, не активност на живо.</p>
 </div>
</section>
<div class="s-service-strip" aria-label="Услуги и начални месечни цени"><svg class="s-strip-mark" viewBox="0 0 300 300" aria-hidden="true" focusable="false"><path d="M0 300V96Q0 84 10 76L85 9Q94 0 107 0H300V86H211Q130 86 130 167V300Z"/></svg><div class="s-wrap">{liveAgents.map(agent => <a href={`/sluzhiteli/${agent.data.slug}/`}><div class="s-strip-offer"><AgentWordmark slug={agent.data.slug} tone="dark" class="s-strip-wordmark"/><span>{agent.data.slug === "vdiga" ? "Приемане на обаждания" : agent.data.slug === "pishe" ? "Актуализации и грижа за сайта" : "Задачи между имейл и CRM"}</span><small>{agent.data.priceLabel}</small></div><b aria-hidden="true">↗︎</b></a>)}</div><p class="s-wrap s-strip-terms">Месечни цени без ДДС. Настройката се заплаща отделно и се уточнява преди старта.</p></div>
<section class="s-team s-wrap" id="ekip"><div class="s-section-heading"><div><h2>Коя работа искате<br/><span>да поемем?</span></h2></div><p>Изберете това, което бави бизнеса ви. Вижте какво поема служителят и от каква цена започва услугата.</p></div><div class="s-service-choice" aria-label="Разгледайте AI служителите">{liveAgents.map((agent,i)=><button type="button" data-service-choice={agent.data.slug} aria-pressed={i===0?'true':'false'} aria-controls={`service-${agent.data.slug}`}><span>{agent.data.name}</span><small>{agent.data.slug==='vdiga'?'Обаждания':agent.data.slug==='pishe'?'Сайт и откриваемост':'Администрация'}</small></button>)}<button type="button" data-service-choice="custom" aria-pressed="false" aria-controls="service-custom"><span>По поръчка</span><small>Вашият процес</small></button></div>
<div class="s-service-panels">{liveAgents.map(agent=>{const p=agentProfiles[agent.data.slug];return <article id={`service-${agent.data.slug}`} data-service-panel={agent.data.slug} class={`s-service-panel s-agent-${agent.data.slug}`}><div class="s-profile-visual"><img src={p.image} width="720" height="960" alt={p.imageAlt} loading="lazy"/><div><span>{agent.data.role}</span><AgentWordmark slug={agent.data.slug} tone="light" alt="" class="s-profile-wordmark" loading="eager"/></div></div><div class="s-profile-content"><p class="s-fit">{p.fit}</p><h3>{p.promise}</h3><p>{p.summary}</p><div class="s-service-facts"><div><span>Месечна услуга</span><strong>{agent.data.priceLabel}</strong></div><div><span>Преди старта</span><strong>Обхват, срок и цена</strong></div></div><small>Без ДДС. Настройката се заплаща отделно.</small><div class="s-actions"><a href="#naemi" class="s-primary" data-pick-service={agent.data.slug}>Обсъдете {p.name} <span aria-hidden="true">↗︎</span></a><a class="s-text-link" href={`/sluzhiteli/${agent.data.slug}/`}>Какво включва услугата</a></div></div></article>})}
<article id="service-custom" data-service-panel="custom" class="s-service-panel s-custom-panel" aria-labelledby="custom-title">
 <div class="s-custom-brief"><h3>AI служител за друг процес.</h3><p>Не е нужно да нагласяте работата си към готова услуга.</p><dl><div><dt>Работата</dt><dd>Какво отнема време на екипа ви?</dd></div><div><dt>Вашите програми</dt><dd>Къде е информацията и кой работи с нея?</dd></div><div><dt>Резултатът</dt><dd>Какво трябва да е свършено накрая?</dd></div></dl></div>
 <div class="s-profile-content"><h3 id="custom-title">Работата ви не се побира в тези три роли?</h3><p>Обсъдете AI служител по поръчка. Започваме от процеса, който бави екипа ви, и проверяваме каква част можем да поемем — с вашите програми, правила и нужния човешки контрол.</p><div class="s-service-facts"><div><span>Първата стъпка</span><strong>Проверка на процеса</strong></div><div><span>Цената</span><strong>Оферта според обхвата</strong></div></div><p>Ако Vdiga, Pishe или Pomaga вече върши тази работа, ще ви предложим него. Не е нужно да изграждаме нов служител, когато има подходящ.</p><div class="s-actions"><a href="#naemi" class="s-primary" data-pick-service="custom">Обсъдете вашия AI служител <span aria-hidden="true">↗︎</span></a></div></div>
</article></div><div class="s-compare-link"><span>Все още избирате?</span><a href="/ceni/">Сравнете плановете и включената работа <span aria-hidden="true">↗︎</span></a></div></section>
<section class="s-start"><div class="s-wrap s-start-layout"><div class="s-start-editorial"><div class="s-start-heading"><h2>Знаете какво поемаме.<br/><span>Преди да започнете да плащате.</span></h2><p>Не купувате достъп до още една програма. Уговаряме конкретна работа за вашия бизнес, настройваме AI служителя и тестваме стъпките и случаите, в които трябва да се намеси човек.</p></div><div class="s-journey" aria-label="Как започваме">
<button type="button" data-journey="brief" aria-pressed="true" aria-controls="journey-example"><span>1</span><strong>Показвате ни работата.</strong><small>Разглеждаме как я вършите сега.</small></button>
<button type="button" data-journey="scope" aria-pressed="false" aria-controls="journey-example"><span>2</span><strong>Получавате обхват и цена.</strong><small>Обхват, настройка и месечна цена.</small></button>
<button type="button" data-journey="check" aria-pressed="false" aria-controls="journey-example"><span>3</span><strong>Проверяваме преди старта.</strong><small>Обичайните случаи и изключенията.</small></button></div><a class="s-text-link" href="/integracii/">Проверете връзката с вашите програми ↗︎</a></div>
<div class="s-project-stage" id="journey-example"><div class="s-project-top"><span>Примерен проект · Vdiga</span></div>
<div data-project="brief"><div class="s-project-title"><span>Работата днес</span><h3>Телефонът звъни.<br/>Всички са с клиенти.</h3></div><blockquote>„Искаме клиентите да получават отговор, дори когато не можем да вдигнем.“</blockquote><dl class="s-project-facts"><div><dt>Какво поемаме</dt><dd>Входящите обаждания</dd></div><div><dt>Какво получавате</dt><dd>Записан час и обобщение</dd></div><div><dt>Какво уточняваме</dt><dd>Работно време, услуги, календар</dd></div></dl></div>
<div data-project="scope" hidden><div class="s-project-title"><span>Преди да решите</span><h3>Какво включва услугата<br/>и колко струва.</h3></div><dl class="s-project-facts"><div><dt>Включена работа</dt><dd>Разговори, въпроси и часове по уговорени правила</dd></div><div><dt>Месечна услуга</dt><dd>От €97 / месец без ДДС</dd></div><div><dt>Първоначална настройка</dt><dd>Отделна цена след уточняване на процеса</dd></div><div><dt>Решения за човек</dt><dd>Случаите извън зададените правила</dd></div></dl></div>
<div data-project="check" hidden><div class="s-project-title"><span>Преди включването</span><h3>Проверяваме и<br/>неудобните случаи.</h3></div><ul class="s-test-cases"><li><span>01</span><div><strong>Клиентът иска свободен час.</strong><p>Проверка на календара и записване.</p></div></li><li><span>02</span><div><strong>Желаният час е зает.</strong><p>Предлагане на налична алтернатива.</p></div></li><li><span>03</span><div><strong>Въпросът е извън правилата.</strong><p>Предаване към човек от екипа.</p></div></li></ul></div>
<div class="s-project-bottom"><span>Вие определяте границите.</span><a href="#naemi">Обсъдете вашия процес ↗︎</a></div></div></div></section>
<section class="s-search s-wrap" aria-labelledby="search-title"><div><h2 id="search-title">Клиентите трябва да ви намират.<br/><span>И да разбират защо да изберат вас.</span></h2><p class="s-search-intro">Сайтът трябва да представя услугите ви днес, не отпреди година. Pishe го поддържа актуален и развива съдържанието му за хората, които търсят бизнеса ви в Google или питат AI асистент.</p><a class="s-text-link" href="/sluzhiteli/pishe/">Как Pishe се грижи за сайта ви ↗︎</a></div><div class="s-discovery-composition"><figure class="s-site-example"><div class="s-browser-bar"><span aria-hidden="true">● ● ●</span><span>Илюстративна страница за услуга</span></div><div class="s-example-page"><div class="s-example-nav"><strong>Вашият бизнес</strong><span>Услуги &nbsp; Контакти</span></div><div class="s-example-hero"><h3>Какво включва услугата<br/>и как да я заявите.</h3><p>За кого е, какво включва и как клиентът да се свърже с вас.</p><span class="s-example-cta">Запитване за услугата</span></div><div class="s-example-answer"><strong>Какво иска да знае клиентът?</strong><p>Цена и условия. Как протича услугата. Кога може да започнете.</p></div><div class="s-example-meta"><span>Актуални контакти</span><span>Цена и условия</span><span>Въпроси преди поръчка</span></div></div><figcaption>Страницата описва услугата, цената и начина за заявяване. Тази информация служи и на клиента, и на търсачките.</figcaption></figure><div class="s-search-details"><article><h3>Услуги, цени и контакти, които не са остарели</h3><p>Обновени услуги, цени и контакти, описан обхват и форми за запитване. Pishe обновява съществуващия сайт по предварително одобрени правила. Ако нямате сайт, изграждането се оферира отделно.</p></article><article><h3>Да ви откриват в Google — SEO</h3><p>Съдържание по въпросите, с които клиентите търсят вашата услуга, връзки между услугите, цените и свързаните статии и техническа достъпност за търсачките. Проверяваме дали страниците отговарят на тези въпроси и могат да бъдат обходени.</p></article><article><h3>Да ви разбират и AI асистентите — GEO</h3><p>Точна информация за бизнеса, услугите и техните условия, която може да бъде използвана като източник в AI отговори. Няма гарантирано място в Google AI Overviews или ChatGPT.</p></article><a href="/polezno/seo-geo/" class="s-text-link">Какво означават SEO и GEO за бизнеса ви ↗︎</a></div></div></section>

<section class="s-faq s-wrap"><div><h2>Какво е важно<br/><span>преди да започнете?</span></h2><a href="/polezno/seo-geo/" class="s-text-link">За Google и AI откриваемостта ↗︎</a></div><FAQ items={homeFaqs}/></section>
<section class="s-contact s-wrap" id="naemi"><div class="s-contact-intro"><div class="s-contact-team" aria-label="Изберете служител за запитването"><button type="button" data-enquiry-role="vdiga" aria-pressed="false"><img src="/assets/employee-vdiga-gloria-v1.webp" width="80" height="80" loading="lazy" alt=""/><span>Vdiga</span></button><button type="button" data-enquiry-role="pishe" aria-pressed="false"><img src="/assets/employee-pishe-v1.webp" width="80" height="80" loading="lazy" alt=""/><span>Pishe</span></button><button type="button" data-enquiry-role="pomaga" aria-pressed="false"><img src="/assets/employee-pomaga-v1.webp" width="80" height="80" loading="lazy" alt=""/><span>Pomaga</span></button></div><button type="button" class="s-custom-enquiry" data-enquiry-role="custom" aria-pressed="false">AI служител по поръчка</button><p class="s-selection-note" aria-live="polite">Изберете служител или ни разкажете какво ви трябва.</p><h2>Коя работа искате<br/><span>да свалим от вас?</span></h2><p>Опишете какво ви бави — не е нужно техническо задание. До един работен ден ще ви кажем дали можем да го поемем и какво е нужно, за да започнем.</p><a class="s-contact-mail" href={`mailto:${site.contactEmail}`}>{site.contactEmail} ↗︎</a></div><div class="s-form-wrap"><ContactForm title="Разкажете ни за работата" enquiry={true}/></div></section>
<script>
const setJourney=(key:string)=>{document.querySelectorAll<HTMLElement>('[data-project]').forEach(el=>el.hidden=el.dataset.project!==key);document.querySelectorAll<HTMLButtonElement>('[data-journey]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.journey===key)));};
document.querySelectorAll<HTMLButtonElement>('[data-journey]').forEach((button,index,buttons)=>{button.addEventListener('click',()=>setJourney(button.dataset.journey!));button.addEventListener('keydown',e=>{if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();const next=buttons[(index+(e.key==='ArrowDown'?1:-1)+buttons.length)%buttons.length];next.focus();next.click();}});});

document.querySelectorAll<HTMLButtonElement>('[data-enquiry-role]').forEach(button=>button.addEventListener('click',()=>{const role=button.dataset.enquiryRole!;const select=document.querySelector<HTMLSelectElement>('[data-agent-choice]');if(select){select.value=role;select.dispatchEvent(new Event('change',{bubbles:true}));}document.querySelectorAll('[data-enquiry-role]').forEach(el=>el.setAttribute('aria-pressed',String(el===button)));const note=document.querySelector('.s-selection-note');if(note)note.textContent=`Избрахте ${button.textContent?.trim()}. Разкажете ни какво искате да поеме.`;}));
const scenarios = {
vdiga:{name:'Vdiga',role:'AI рецепционист',question:'„Може ли час за утре следобед?“',state:'Резултат за екипа',result:'Часът е записан.',detail:'Утре, 14:30 · Обобщението е готово.',image:'employee-vdiga-gloria-v1.webp'},
pishe:{name:'Pishe',role:'AI уеб мениджър',question:'„Нека сайтът показва новата ни услуга.“',state:'По предварително одобрени правила',result:'Сайтът е актуализиран.',detail:'Добавени са описание, условия и начин за заявяване.',image:'employee-pishe-v1.webp'},
pomaga:{name:'Pomaga',role:'AI оперативен асистент',question:'„Получихме ново запитване по имейл.“',state:'Резултат за екипа',result:'Запитването е подредено.',detail:'Клиент в CRM · Задача към колега.',image:'employee-pomaga-v1.webp'}
};
document.querySelectorAll<HTMLButtonElement>('[data-role]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.role as keyof typeof scenarios;const s=scenarios[key];document.querySelectorAll('[data-role]').forEach(el=>el.setAttribute('aria-pressed',String(el===button))); for(const field of ['role','question','state','result','detail'] as const){const el=document.querySelector(`[data-demo-${field}]`);if(el)el.textContent=s[field];} const a=document.querySelector<HTMLAnchorElement>('[data-demo-link]');if(a){a.href=a.href.replace(/sluzhiteli\/[^/]+\//,`sluzhiteli/${key}/`);a.textContent=`Как работи ${s.name} ↗︎`;} const img=document.querySelector<HTMLImageElement>('.s-person>img');if(img){img.src=img.src.replace(/[^/]+$/,s.image);img.alt=`Образът на ${s.name}`;} const mark=document.querySelector<HTMLImageElement>('.s-demo-wordmark');if(mark){mark.src=mark.src.replace(/[^/]+$/,`${key}-wordmark-dark.webp`);mark.alt=s.name;mark.dataset.agentWordmark=key;mark.classList.remove('agent-wordmark--vdiga','agent-wordmark--pishe','agent-wordmark--pomaga');mark.classList.add(`agent-wordmark--${key}`);}}));
const form=document.querySelector<HTMLFormElement>('.studio [data-contact-form]');
if(form){
 const select=form.querySelector<HTMLSelectElement>('[data-agent-choice]');if(select){select.value='unsure';select.addEventListener('change',()=>{document.querySelectorAll<HTMLButtonElement>('[data-enquiry-role]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.enquiryRole===select.value)));const note=document.querySelector('.s-selection-note');if(note)note.textContent=select.value==='unsure'?'Изберете служител или ни разкажете какво ви трябва.':`Избрахте ${select.value==='vdiga'?'Vdiga':select.value==='pishe'?'Pishe':select.value==='custom'?'AI служител по поръчка':'Pomaga'}. Разкажете ни какво искате да поеме.`;});}
}
const chooseService=(role:string)=>{document.querySelectorAll<HTMLElement>('[data-service-panel]').forEach(el=>{el.hidden=el.dataset.servicePanel!==role;});document.querySelectorAll<HTMLButtonElement>('[data-service-choice]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.serviceChoice===role)));};
const requestedRole=new URLSearchParams(window.location.search).get('agent');
const validRole=requestedRole&&['vdiga','pishe','pomaga','custom'].includes(requestedRole)?requestedRole:null;
chooseService(validRole||'vdiga');
if(validRole)document.querySelector<HTMLButtonElement>(`[data-enquiry-role="${validRole}"]`)?.click();
document.querySelectorAll<HTMLAnchorElement>('[data-show-custom]').forEach(link=>link.addEventListener('click',()=>chooseService('custom')));
document.querySelectorAll<HTMLButtonElement>('[data-service-choice]').forEach((button,index,buttons)=>{button.addEventListener('click',()=>chooseService(button.dataset.serviceChoice!));button.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const next=buttons[(index+(e.key==='ArrowRight'?1:-1)+buttons.length)%buttons.length];next.focus();next.click();}});});
document.querySelectorAll<HTMLAnchorElement>('[data-pick-service]').forEach(link=>link.addEventListener('click',()=>{document.querySelector<HTMLButtonElement>(`[data-enquiry-role="${link.dataset.pickService}"]`)?.click();}));
</script>
</BaseLayout>

