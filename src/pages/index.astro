@media(max-width:700px){.s-service-strip>.s-wrap{padding-right:0}.s-strip-mark{width:104px;height:104px;right:8px;top:auto;bottom:54px;transform:none}.s-service-strip>.s-wrap>a:last-child{padding-right:126px}.s-service-strip .s-strip-terms{padding-right:0}}
