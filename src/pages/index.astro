---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";
import "../styles/reference-world.css";

const agents = (await getCollection("agents")).sort((a,b)=>a.data.order-b.data.order);
const schemas=[faqSchema(homeFaqs),breadcrumbSchema([{name:"Работи",url:site.url}])];
const verbs: Record<string,string>={vdiga:"чува",pishe:"променя",smyata:"проверява",pomaga:"свързва",prodava:"придвижва"};
---
<BaseLayout title="Работи — AI служители за реалната работа" description="Пет AI служители за обаждания, сайт, сметки, системи и продажби — с ясна цена и човешки контрол." canonical="/" schema={schemas} bodyClass="rw-page">
  <div class="rw-home">
    <section class="rw-hero">
      <div class="rw-hero__copy">
        <p class="rw-kicker"><span></span> AI служители за българския бизнес</p>
        <h1>Даваш задача.<br><em>Получаваш свършена работа.</em></h1>
        <p>Работи е екип от AI служители с конкретни длъжности. Вдигат телефона, поддържат сайта и прехвърлят работата между системите ти — по зададени правила.</p>
        <div class="rw-actions"><a class="rw-button" href="#ekip">Виж служителите</a><a class="rw-text-link" href="#kak">Как работят →</a></div>
      </div>
      <figure class="rw-machine"><img src="/assets/raboti-work-bench.png" alt="Пет свързани работни инструмента — един за всяка AI роля" width="1672" height="941" loading="eager" fetchpriority="high"><figcaption><span>една задача влиза</span><b>пет роли работят</b><span>резултатът излиза</span></figcaption></figure>
      <div class="rw-proof"><span><b>от 97 лв.</b> на месец</span><span><b>до 5 дни</b> за старт</span><span><b>човекът решава</b> преди рисково действие</span></div>
    </section>

    <section class="rw-roster" id="ekip">
      <header class="rw-section-head"><p>01 / ЕКИПЪТ</p><h2>Пет длъжности.<br>Една работна система.</h2><span>Избери по задачата, която остава несвършена.</span></header>
      <div class="rw-agent-list">
        {agents.map((agent,i)=><a class={`rw-agent rw-agent--${agent.data.slug}`} href={`/sluzhiteli/${agent.data.slug}/`}>
          <span class="rw-agent__no">0{i+1}</span><div><small>{agent.data.role}</small><h3>{agent.data.name}</h3></div><p>{agent.data.summary}</p><strong>{agent.data.status==="live"?agent.data.priceLabel:"Предстои"}</strong><i>{verbs[agent.data.slug]} →</i>
        </a>)}
      </div>
    </section>

    <section class="rw-flow" id="kak">
      <header class="rw-section-head rw-section-head--light"><p>02 / ЕДНА РЕАЛНА ЗАДАЧА</p><h2>Не показваме „AI магия“.<br>Показваме работата.</h2></header>
      <div class="rw-flow__track">
        <article><span>вход</span><b>14:29</b><h3>Клиент се обажда за свободен час.</h3></article>
        <article><span>работа</span><b>14:29:08</b><h3>Вдига разбира услугата и проверява графика.</h3></article>
        <article><span>резултат</span><b>14:30</b><h3>Часът е записан. Клиентът получава потвърждение.</h3></article>
      </div>
    </section>

    <section class="rw-control">
      <div><p>03 / КОНТРОЛ</p><h2>Работи самостоятелно.<br><em>Спира, когато трябва.</em></h2></div>
      <div class="rw-control__rules"><article><b>Сам</b><p>Чете, проверява, подготвя и записва по одобрени правила.</p></article><article><b>Пита</b><p>Преди плащане, договор, публикуване или необратима промяна.</p></article><article><b>Показва</b><p>Какво е получил, какво е направил и какъв е резултатът.</p></article></div>
    </section>

    <section class="rw-faq"><div><p>04 / ПРЕДИ ДА РЕШИШ</p><h2>Ясни отговори.<br>Без технологичен театър.</h2></div><FAQ items={homeFaqs}/></section>

    <section class="rw-contact"><div><p>05 / ЗАПОЧНИ ОТ ЗАДАЧАТА</p><h2>Коя работа ти струва най-много време или клиенти?</h2><span>Опиши я. Ще ти кажем дали може да бъде поета, за колко време и на каква цена.</span></div><ContactForm title="Разкажи ни за работата"/></section>
  </div>
</BaseLayout>
