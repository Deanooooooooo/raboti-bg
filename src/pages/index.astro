---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentAvatar from "../components/AgentAvatar.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import LivingWorkMap from "../components/LivingWorkMap.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import WorkGlyph from "../components/WorkGlyph.astro";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Работи", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Работи",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "49",
      highPrice: "249",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Работи",
    itemListElement: agents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="Работи — AI служители за задачите, които бавят бизнеса"
  description="AI служители за пропуснати обаждания, бавни отговори, работа по сайта и ръчни задачи. Избираш конкретна роля с ясна цена и човешки контрол."
  canonical="/"
  schema={schemas}
  bodyClass="home-art"
>
  <section class="home-hero" data-hero>
    <div class="home-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="home-noise" aria-hidden="true"></div>
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <p class="spectrum-label"><span></span> AI служители за българския бизнес</p>
        <h1>Работата не чака.<br /><em>Вече има кой да я свърши.</em></h1>
        <p class="home-hero__lead">Работи е българска услуга за AI служители с конкретна длъжност, месечна цена и човешки контрол. Те поемат пропуснатите обаждания, промените по сайта и ръчната работа между системите.</p>
        <div class="home-hero__actions">
          <a class="button button--spectrum" href="#ekip">Намери своя AI служител <Icon name="arrow-down" /></a>
          <a class="home-link" href="#proces">Виж как работи <Icon name="arrow-right" /></a>
        </div>
        <div class="home-hero__signals" aria-label="Основни характеристики">
          <span><i></i> Старт до 5 работни дни</span>
          <span><i></i> Работи на български</span>
          <span><i></i> Човек одобрява рисковото</span>
        </div>
      </div>
      <LivingWorkMap />
    </div>
  </section>

  <section class="home-facts" aria-label="Проблеми, които AI служителите поемат">
    <div class="shell home-facts__grid">
      <div><span>Докато телефонът звъни</span><strong>Не губиш следващия клиент</strong><p>Обаждането получава отговор, дори когато целият екип е зает.</p></div>
      <div><span>Докато задачите се трупат</span><strong>Рутината не блокира хората</strong><p>Повтарящата се работа се движи, вместо да чака „като остане време“.</p></div>
      <div><span>Докато бизнесът расте</span><strong>Контролът остава при теб</strong><p>Виждаш какво е свършено, а рисковите решения чакат човек.</p></div>
    </div>
  </section>

  <section class="home-section roster-section" id="ekip">
    <div class="shell">
      <div class="home-heading">
        <div><p class="spectrum-label spectrum-label--dark"><span></span> Избери по проблема</p><h2>Не купуваш AI.<br /><em>Наемаш свършена работа.</em></h2></div>
        <p>Започни от задачата, която губи клиенти или време днес. Всеки AI служител има ясна длъжност, цена и граници.</p>
      </div>

      <div class="roster-grid">
        {agents.map((agent) => {
          const data = agent.data;
          return (
            <article class:list={["roster-card", `roster-card--${data.slug}`, data.status === "soon" && "roster-card--soon"]} style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
              <div class="roster-card__halo" aria-hidden="true"></div>
              <header>
                <AgentAvatar name={data.name} slug={data.slug} accent={data.accent} accentSoft={data.accentSoft} size="small" />
                <span class="roster-status"><i></i>{data.status === "live" ? "може да започне" : "подготвя се"}</span>
              </header>
              <div class="roster-card__body">
                <p>{data.role}</p>
                <h3>{data.name}</h3>
                <span>{data.summary}</span>
              </div>
              <footer>
                <div><small>{data.status === "live" ? "Месечна цена" : "Достъп"}</small><strong>{data.priceLabel}</strong></div>
                <a href={`/sluzhiteli/${data.slug}/`} aria-label={`Виж ролята ${data.name}`}><span>Виж ролята</span><Icon name="arrow-right" /></a>
              </footer>
            </article>
          );
        })}
      </div>

      <aside class="fit-check" aria-labelledby="fit-title">
        <div class="fit-check__intro">
          <p class="spectrum-label spectrum-label--dark"><span></span> Бърза проверка</p>
          <h3 id="fit-title">Подходящ ли е AI служител за твоя бизнес?</h3>
          <p>Най-добрият първи процес е чест, ясен и достатъчно повтаряем, за да опишем правилата му.</p>
        </div>
        <div class="fit-check__column fit-check__column--yes">
          <strong><Icon name="check" /> Да, ако работата…</strong>
          <ul><li>се повтаря всяка седмица;</li><li>има ясен вход и очакван резултат;</li><li>днес бави екипа или изпуска клиенти.</li></ul>
        </div>
        <div class="fit-check__column fit-check__column--no">
          <strong><span aria-hidden="true">×</span> Не, ако работата…</strong>
          <ul><li>изисква свободна човешка преценка;</li><li>няма устойчиви правила;</li><li>включва необратими решения без одобрение.</li></ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section process-section" id="proces">
    <div class="shell process-layout">
      <div class="process-copy">
        <p class="spectrum-label"><span></span> От входяща задача до ясен резултат</p>
        <h2>Даваш работа.<br /><em>Не даваш сляп достъп.</em></h2>
        <p>Уточняваме какво може да върши сам, каква информация използва и кога трябва да потърси човек. Така печелиш време, без да предаваш важните решения.</p>
        <ul class="process-principles">
          <li><span class="principle-mark"><Icon name="arrow-right" /></span><div><strong>Получава задачата веднага</strong><small>От телефон, имейл, формуляр или график.</small></div></li>
          <li><span class="principle-mark"><Icon name="check" /></span><div><strong>Върши позволеното сам</strong><small>По твоите правила, данни и одобрен процес.</small></div></li>
          <li><span class="principle-mark"><WorkGlyph name="guard" /></span><div><strong>Пита, когато решението е твое</strong><small>Неясните и необратими действия не се отгатват.</small></div></li>
        </ul>
      </div>
      <WorkflowVisual />
    </div>
  </section>

  <section class="home-section boundaries-section" id="kontrol">
    <div class="shell boundaries-grid">
      <div class="boundary-intro">
        <p class="spectrum-label"><span></span> Спокойствие, не черна кутия</p>
        <h2>Знаеш какво върши.<br /><em>И кога спира.</em></h2>
      </div>
      <div class="boundary-card boundary-card--cyan"><span>Ясна работа</span><h3>Знаеш какво получаваш още преди старта</h3><p>Конкретни задачи, цена, срок за настройка и очакван резултат.</p></div>
      <div class="boundary-card boundary-card--violet"><span>Ясни права</span><h3>Достъпът стига само докъдето е нужен</h3><p>AI служителят използва единствено одобрените системи и действия.</p></div>
      <div class="boundary-card boundary-card--coral"><span>Ясна граница</span><h3>При съмнение пита, вместо да измисля</h3><p>Неясният или рисков случай идва при човек заедно с целия контекст.</p></div>
      <div class="boundary-card boundary-card--lime"><span>Ясен отчет</span><h3>Не се чудиш какво е станало със задачата</h3><p>Виждаш извършеното, резултата и следващото необходимо действие.</p></div>
    </div>
  </section>

  <section class="home-section home-faq-section">
    <div class="shell home-faq-grid">
      <div><p class="spectrum-label spectrum-label--dark"><span></span> Преди да решиш</p><h2>Ясни отговори, без AI мъгла.</h2><p>Не ти трябва технически екип. Трябва да посочиш работата, която днес остава несвършена, бави хората ти или изпуска клиенти.</p></div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section class="home-contact" id="naemi">
    <div class="home-contact__aurora" aria-hidden="true"></div>
    <div class="shell home-contact__grid">
      <div>
        <p class="spectrum-label"><span></span> Започни от един истински проблем</p>
        <h2>Коя задача ти струва<br /><em>най-много време или клиенти?</em></h2>
        <p>Опиши я с няколко думи. Ще ти кажем честно дали някой от AI служителите ни може да я поеме, как се настройва и каква ще е цената.</p>
        <div class="contact-spectrum" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <ContactForm title="Разкажи ни за работата" />
    </div>
  </section>
</BaseLayout>
