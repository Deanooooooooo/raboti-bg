---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import AgentWordmark from "../components/AgentWordmark.astro";
import HeroMotion from "../components/HeroMotion.astro";
import "../styles/studio.css";
import "../styles/raboti-work-machine-v4.css";
import "../styles/homepage-update.css";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgentOrder = ["vdiga", "pishe", "pomaga"];
const liveAgents = agents
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => liveAgentOrder.indexOf(a.data.slug) - liveAgentOrder.indexOf(b.data.slug));

const services = [
  {
    slug: "vdiga",
    name: "Vdiga",
    image: "/assets/employee-vdiga-gloria-v1.webp",
    imageAlt: "Gloria, образът на AI рецепциониста Vdiga",
    problem: "Телефонът звъни. Вие сте с клиент.",
    capabilities: [
      "Отговори за цени, услуги и работно време",
      "Записване на часове в календара ви",
      "Обобщение след разговора",
    ],
    prices: ["от €97/месец"],
    scope: "Какво поема Vdiga",
  },
  {
    slug: "pishe",
    name: "Pishe",
    image: "/assets/employee-pishe-v1.webp",
    imageAlt: "Визуално представяне на AI уеб мениджъра Pishe",
    problem: "Всяка промяна по сайта чака вас.",
    capabilities: [
      "Нов фирмен сайт, ако още нямате",
      "Актуални услуги, цени и контакти",
      "Съдържание по въпросите на клиентите",
    ],
    prices: ["Нов сайт: от €197 еднократно", "Поддръжка: от €297/месец"],
    scope: "Какво поема Pishe",
  },
  {
    slug: "pomaga",
    name: "Pomaga",
    image: "/assets/employee-pomaga-v1.webp",
    imageAlt: "Визуално представяне на AI оперативния асистент Pomaga",
    problem: "Данните от имейла пак се въвеждат на ръка.",
    capabilities: [
      "Данни от имейла в CRM или таблица",
      "Задачи за отговорния колега",
      "Справка за свършеното и чакащото",
    ],
    prices: ["от €297/месец"],
    scope: "Какво поема Pomaga",
  },
] as const;

const homeFaqs = [
  {
    question: "Какво точно поема Raboti?",
    answer: "Vdiga отговаря на обаждания и записва часове. Pishe изгражда или поддържа сайта ви. Pomaga прехвърля данни и създава задачи в програмите на екипа. Нашият екип настройва избраната услуга, поддържа я и предварително уточнява с вас какво може да прави самостоятелно.",
  },
  {
    question: "Колко ще плащам и има ли такса за настройка?",
    answer: "Vdiga започва от €97 на месец. Изграждането на фирмен сайт от Pishe започва от €197 еднократно, а поддръжката на сайт е от €297 на месец. Pomaga започва от €297 на месец за един локален агент. Цените са без ДДС. Настройката за месечните услуги се плаща отделно, а сумата се уточнява преди старта. При нов сайт допълнителните функции и платените външни услуги се договарят отделно.",
  },
  {
    question: "Какво става с програмите, които вече ползваме?",
    answer: "Първо проверяваме дали можем да свържем услугата с тях и дали имаме нужния достъп за конкретната задача. Ако някоя програма не позволява такава връзка, ще знаете това преди офертата. Проверката е наша работа.",
  },
  {
    question: "Кои действия остават за одобрение от нас?",
    answer: "Вие определяте кои повтарящи се задачи могат да се изпълняват самостоятелно. Плащанията, договорите и действията извън уговореното изискват потвърждение. Новите цени, оферти и важни обещания към клиентите също минават през вас преди публикуване.",
  },
  {
    question: "А ако ми трябва помощ с друга задача?",
    answer: "Вашият пример ни помага да преценим дали някоя от трите услуги е подходяща. Ако е нужна отделна разработка, първо уточняваме какво може да се поеме, с кои програми и на каква цена. Решението дали да започнем остава ваше.",
  },
];

const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Raboti", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Raboti",
    serviceType: "AI служители и уеб услуги за бизнеса",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "97",
      highPrice: "597",
      priceCurrency: "EUR",
      offerCount: "10",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Raboti",
    itemListElement: liveAgents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="AI служители за бизнеса: телефон, сайт и операции | Raboti"
  description="Vdiga приема обаждания, Pishe изгражда и поддържа сайтове, а Pomaga прехвърля данни и създава задачи в програмите на екипа. Вижте услуги и цени."
  canonical="/"
  image="/assets/brand/social/raboti-home-social.jpg"
  imageAlt="Raboti, AI служители за българския бизнес"
  imageWidth={1200}
  imageHeight={675}
  schema={schemas}
  bodyClass="studio rh-home"
>
  <section class="rh-hero" data-hero>
    <div class="rh-wrap rh-hero__layout">
      <div class="rh-hero__copy">
        <p class="rh-eyebrow">AI служители за българския бизнес</p>
        <h1>Всичко чака вас?</h1>
        <div class="rh-hero__lead">
          <p>Телефонът звъни, сайтът чака промени, а данните от имейла пак се преписват на ръка.</p>
          <p>Vdiga поема обажданията, Pishe се грижи за сайта, а Pomaga прехвърля информацията и създава задачи в програмите ви.</p>
        </div>
        <div class="rh-actions">
          <a class="rh-button" href="#ekip">Кой какво поема <span aria-hidden="true">↗</span></a>
          <a class="rh-link" href="#naemi">Запитване за моя бизнес</a>
        </div>
        <p class="rh-assurance">Настройката и поддръжката са наша работа.</p>
      </div>

      <div class="rh-demo">
        <HeroMotion />
        <p class="rh-demo__label">Пример как се върши работата</p>
        <div class="rh-result" data-rwm-result aria-live="polite" aria-atomic="true">
          <img src="/assets/homepage/result-appointment.svg" width="48" height="48" alt="" data-rwm-result-icon />
          <div>
            <p class="rh-result__request"><span>Заявка:</span> <span data-rwm-result-request>Клиент се обажда за час</span></p>
            <h2 data-rwm-result-title>Часът е в календара ви.</h2>
            <p data-rwm-result-detail>Vdiga проверява кога има свободно място и записва клиента. Екипът получава обобщение на разговора.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="rh-team rh-wrap" id="ekip" aria-labelledby="rh-team-title">
    <div class="rh-section-heading">
      <h2 id="rh-team-title">Кое ви отнема най-много време?</h2>
      <p>Началото може да е само една задача: обажданията, промените по сайта или преписването между програми.</p>
    </div>
    <div class="rh-services">
      {services.map((service) => (
        <article class={`rh-service rh-service--${service.slug}`}>
          <div class="rh-service__head">
            <img src={service.image} width="720" height="960" alt={service.imageAlt} loading="lazy" />
            <AgentWordmark slug={service.slug} tone="dark" alt={service.name} class="rh-service__wordmark" loading="lazy" />
          </div>
          <div class="rh-service__body">
            <h3>{service.problem}</h3>
            <ul>{service.capabilities.map((capability) => <li>{capability}</li>)}</ul>
            <div class="rh-service__price">
              {service.prices.map((price) => <strong>{price}</strong>)}
            </div>
            <div class="rh-service__actions">
              <a class="rh-link" href={`/sluzhiteli/${service.slug}/`}>{service.scope}</a>
              <a class="rh-link rh-link--enquiry" href="#naemi" data-pick-service={service.slug}>Запитване за {service.name}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="rh-price-note">Цените са без ДДС. Настройката за месечните услуги се заплаща отделно след уточняване на обхвата.</p>
    <div class="rh-custom">
      <div>
        <h3>Вашата задача е друга?</h3>
        <p>Един пример от работния ви ден ще ни помогне да преценим какво можем да поемем с програмите, които вече ползвате.</p>
      </div>
      <a class="rh-button rh-button--ink" href="#naemi" data-pick-service="custom">Запитване за друга задача <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="rh-setup" aria-labelledby="rh-setup-title">
    <div class="rh-wrap">
      <div class="rh-section-heading rh-section-heading--setup">
        <h2 id="rh-setup-title">Преди старта знаете какво поемаме и колко струва.</h2>
        <p>Първо уточняваме работата и цената. След това нашият екип настройва връзките с програмите ви и проверява дали всичко работи според уговореното.</p>
      </div>
      <ol class="rh-steps">
        <li><span>01</span><h3>Един пример от вашия ден</h3><p>Вашият разказ ни показва как пристига задачата, кой я поема и какво трябва да е готово накрая.</p></li>
        <li><span>02</span><h3>Оферта за конкретната работа</h3><p>В офертата виждате какво поемаме, колко струва настройката и каква е месечната цена, ако услугата е абонаментна.</p></li>
        <li><span>03</span><h3>Проба с вашите задачи</h3><p>Преди старта проверяваме и обичайните случаи, и изключенията: зает час, липсващи данни или въпрос, който изисква човек.</p></li>
      </ol>
      <div class="rh-control-note">
        <p>Вие решавате кога служителят действа сам и кога трябва да ви попита. Плащанията, договорите и действията извън уговореното чакат вашето потвърждение.</p>
        <a class="rh-link" href="/integracii/">Програмите, с които можем да работим</a>
      </div>
    </div>
  </section>

  <section class="rh-faq rh-wrap" aria-labelledby="rh-faq-title">
    <div class="rh-faq__intro">
      <h2 id="rh-faq-title">Преди да започнем.</h2>
      <p>Цени, програми и решенията, които остават при вас.</p>
    </div>
    <FAQ items={homeFaqs} />
  </section>

  <section class="rh-contact rh-wrap" id="naemi" aria-labelledby="rh-contact-title">
    <div class="rh-contact__intro">
      <div class="rh-contact__copy">
        <h2 id="rh-contact-title">Коя задача все отлагате за утре?</h2>
        <p>Няколко изречения са достатъчни: какво ви бави, как го вършите сега и какво искате да поемем.</p>
        <p class="rh-contact__response">До един работен ден ще получите отговор дали можем да помогнем и какво ни е нужно за начало.</p>
      </div>
      <div class="rh-brand-region" aria-hidden="true">
        <img src="/assets/homepage/raboti-r-cobalt.svg" width="300" height="300" alt="" />
        <span>Вашата задача</span>
      </div>
    </div>
    <div class="rh-contact__form">
      <div class="rh-role-picker" aria-label="Изберете услуга за запитването">
        <span class="rh-role-picker__label">Запитване за:</span>
        <div>
          {services.map((service) => <button type="button" data-enquiry-role={service.slug} aria-pressed="false">{service.name}</button>)}
          <button type="button" data-enquiry-role="custom" aria-pressed="false">Друга задача</button>
        </div>
        <p class="rh-selection-note" aria-live="polite">Можете да изберете услуга или да опишете задачата направо във формата.</p>
      </div>
      <ContactForm title="За какво ви трябва помощ?" enquiry={true} homepageCopy={true} />
    </div>
  </section>

  <script>
    import "../scripts/raboti-work-machine-v4.js";

    const form = document.querySelector<HTMLFormElement>(".rh-home [data-contact-form]");
    const select = form?.querySelector<HTMLSelectElement>("[data-agent-choice]");
    const formHeading = form?.querySelector<HTMLElement>("h2");
    const labels: Record<string, string> = { vdiga: "Vdiga", pishe: "Pishe", pomaga: "Pomaga", custom: "друга задача", unsure: "още не сте избрали услуга" };

    const syncRole = (role: string, focusForm = false) => {
      if (!select || !labels[role]) return;
      if (select.value !== role) {
        select.value = role;
        select.dispatchEvent(new Event("change", { bubbles: true }));
      }
      document.querySelectorAll<HTMLButtonElement>("[data-enquiry-role]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.enquiryRole === role)));
      const note = document.querySelector<HTMLElement>(".rh-selection-note");
      if (note) note.textContent = role === "unsure" ? "Можете да изберете услуга или да опишете задачата направо във формата." : `Избрахте ${labels[role]}. Можете да смените избора от бутоните или от формата.`;
      if (focusForm) requestAnimationFrame(() => formHeading?.focus({ preventScroll: true }));
    };

    document.querySelectorAll<HTMLButtonElement>("[data-enquiry-role]").forEach((button) => button.addEventListener("click", () => syncRole(button.dataset.enquiryRole || "unsure")));
    document.querySelectorAll<HTMLAnchorElement>("[data-pick-service]").forEach((link) => link.addEventListener("click", () => syncRole(link.dataset.pickService || "unsure", true)));
    select?.addEventListener("change", () => syncRole(select.value));

    const requestedRole = new URLSearchParams(window.location.search).get("agent");
    if (requestedRole && ["vdiga", "pishe", "pomaga", "custom"].includes(requestedRole)) syncRole(requestedRole);
  </script>
</BaseLayout>
