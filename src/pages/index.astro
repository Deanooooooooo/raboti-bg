---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import "../styles/home-refinement.css";
import RoleKeys from "../components/RoleKeys.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import WorkGlyph from "../components/WorkGlyph.astro";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgentOrder = ["vdiga", "pishe", "pomaga"];
const liveAgents = agents
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => liveAgentOrder.indexOf(a.data.slug) - liveAgentOrder.indexOf(b.data.slug));
const agentProfiles: Record<string, { name: string; image: string; imageAlt: string; cta: string; promise: string; summary: string }> = {
  vdiga: { name: "Vdiga", image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Gloria, образът на AI рецепциониста Vdiga", cta: "Вижте как работи Vdiga", promise: "Докато сте с един клиент, не изпускайте следващия.", summary: "Vdiga поема обажданията, отговаря на въпроси и записва часове. Клиентите получават внимание, без да прекъсват работата на екипа." },
  pishe: { name: "Pishe", image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Вижте как работи Pishe", promise: "Нека следващият ви клиент ви намери онлайн.", summary: "Pishe автоматично обновява сайта по уговорените правила или изгражда нов. Развива съдържанието, за да ви откриват в Google и отговорите на AI." },
  pomaga: { name: "Pomaga", image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Вижте как работи Pomaga", promise: "Повече време за работа. По-малко за администрация.", summary: "Pomaga свързва имейла, клиентските данни и задачите в един процес. Екипът върши същинската работа, вместо да преписва и да предава информация на ръка." },
};
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Raboti", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Raboti",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "97",
      highPrice: "297",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Raboti",
    itemListElement: liveAgents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="Raboti | AI служители за задачите, които бавят бизнеса"
  description="AI служители за клиентите, сайта и администрацията. Raboti поема ежедневната работа, за да не чака всичко вас. Вижте ролите и цените."
  canonical="/"
  schema={schemas}
  bodyClass="home-art"
>
  <section class="home-hero" data-hero>
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <h1>Бизнесът ви не трябва<br /><em>да чака да се освободите.</em></h1>
        <p class="home-hero__lead">Клиентите очакват отговор. Бизнесът ви трябва да се вижда онлайн. А ежедневната работа трябва да върви. Наемете AI служител от Raboti, който да поеме своята част — без всичко да остава за вас и екипа ви.</p>
        <div class="home-hero__actions">
          <a class="button button--spectrum" href="#ekip">Вижте AI служителите <Icon name="arrow-down" /></a>
          <a class="home-link" href="#naemi">Обсъдете с нас <Icon name="arrow-right" /></a>
        </div>
        <RoleKeys />
        <div class="home-hero__signals" aria-label="Основни характеристики">
          <span><i></i> Срок за настройка според задачата</span>
          <span><i></i> Работи на български</span>
          <span><i></i> Вие определяте какво прави сам</span>
        </div>
      </div>
    </div>
  </section>

  <section class="home-facts" aria-labelledby="home-facts-title">
    <div class="shell">
      <div class="home-facts__intro">
        <h2 id="home-facts-title">Не ви трябва<br /><em>още една система за разучаване.</em></h2>
        <p>Първо разбираме как работите и къде се натрупва забавянето. Подготвяме служителя за вашия бизнес и проверяваме работата му преди старта.</p>
      </div>

      <div class="home-facts__journey">
        <article class="home-fact">
          <strong>Разбираме къде ви тежи.</strong>
          <p>Разказвате ни какво прекъсва екипа, остава за после или кара клиентите да чакат. Разглеждаме реални примери от работата ви.</p>
        </article>
        <article class="home-fact">
          <strong>Уточняваме какво поемаме.</strong>
          <p>Записваме каква информация използва, до какво има достъп и в кои случаи трябва да ви попита.</p>
        </article>
        <article class="home-fact">
          <strong>Настройваме и проверяваме.</strong>
          <p>Проверяваме обичайните случаи и изключенията. След това го пускаме да върши задачите, за които сте се разбрали.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-section roster-section" id="ekip">
    <div class="shell">
      <div class="home-heading">
        <div><h2>Къде бизнесът ви има нужда<br /><em>от още един служител?</em></h2></div>
        <p>На телефона, онлайн или в ежедневната организация — изберете работата, която вече не искате да остава за после.</p>
      </div>

      <div class="roster-grid">
        {liveAgents.map((agent) => {
          const data = agent.data;
          const profile = agentProfiles[data.slug];
          return (
            <a class:list={["roster-card", `roster-card--${data.slug}`, data.status === "soon" && "roster-card--soon"]} href={`/sluzhiteli/${data.slug}/`} aria-label={`${profile.name}: как може да помогне`} style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
              <header>
                <div class="roster-card__heading">
                  <p>{data.role}</p>
                  <h3>{profile.name}</h3>
                </div>
              </header>
              <div class="roster-card__portrait">
                <img src={profile.image} width="720" height="960" alt={profile.imageAlt} loading="lazy" decoding="async" />
              </div>
              <div class="roster-card__body">
                <strong class="roster-card__promise">{profile.promise}</strong>
                <span>{profile.summary}</span>
              </div>
              <footer>
                <strong>{data.priceLabel}</strong>
                <span class="roster-card__action"><span>{profile.cta}</span><Icon name="arrow-right" /></span>
              </footer>
            </a>
          );
        })}
      </div>

    </div>
  </section>

  <section class="home-section process-section" id="proces">
    <div class="shell process-layout">
      <div class="process-copy">
        <h2>Работата върви.<br /><em>Решенията остават ваши.</em></h2>
        <p>Знаете какво е възложено на служителя и какво е свършил. Предварително уточняваме кога действа сам и кога чака вашето потвърждение. Така делегирате работата, без да губите контрол.</p>
        <ul class="process-principles">
          <li><span class="principle-mark"><Icon name="arrow-right" /></span><div><strong>Поема задачата, когато пристигне</strong><small>Дори когато екипът е зает или денят е приключил.</small></div></li>
          <li><span class="principle-mark"><Icon name="check" /></span><div><strong>Върши само задачите, за които сте се разбрали</strong><small>Използва само информацията и програмите, до които сте му дали достъп.</small></div></li>
          <li><span class="principle-mark"><WorkGlyph name="guard" /></span><div><strong>Спира, когато трябва да решите вие</strong><small>Плащанията, договорите и промените извън даденото разрешение чакат вашето потвърждение.</small></div></li>
        </ul>
        <a class="button process-cta" href="#naemi">Опишете как работите сега <Icon name="arrow-right" /></a>
      </div>
      <WorkflowVisual />
    </div>
  </section>

  <section class="home-section proof-section" id="kontrol">
    <div class="shell proof-grid">
      <div class="proof-copy">
        <h2>Кое спира бизнеса ви, <em>когато нямате време?</em></h2>
        <p>Обаждания без отговор? Сайт, който изостава или още липсва? Администрация след работния ден? Разкажете ни къде ви тежи. Ще ви кажем какво можем да поемем и колко ще струва.</p>
        <a class="button proof-cta" href="#naemi">Изпратете запитване <Icon name="arrow-right" /></a>
        <small>Не подготвяйте задание. Напишете го както бихте го обяснили на нов колега.</small>
      </div>
      <div class="decision-brief" aria-label="Какво ще ви кажем за задачата">
        <header>
          <strong>Ще ви кажем направо:</strong>
        </header>
        <ul>
          <li><span><Icon name="check" /></span><div><strong>Кой може да я поеме</strong><p>Ще ви кажем дали задачата е за Vdiga, Pishe или Pomaga. Ако не е подходяща за нито един от тях, ще го кажем направо.</p></div></li>
          <li><span><Icon name="check" /></span><div><strong>Какво ще върши</strong><p>Откъде поема задачата, докъде я довежда и какво остава за вас.</p></div></li>
          <li><span><Icon name="check" /></span><div><strong>Какво ще ни трябва от вас</strong><p>Информация, достъпи и кога служителят трябва да изчака вашето решение.</p></div></li>
          <li><span><Icon name="check" /></span><div><strong>Колко струва и кога тръгва</strong><p>Месечната цена, настройката и кога може да започне работа.</p></div></li>
        </ul>
        <footer>Ако задачата не е за нас, няма да ви разкарваме.</footer>
      </div>
    </div>
  </section>

  <section class="home-section home-faq-section">
    <div class="shell home-faq-grid">
      <div><h2>Какво поема AI служителят и как започва?</h2><p>Не ви трябва технически екип. Покажете ни работата, която остава несвършена, бави хората ви или изпуска клиенти.</p></div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section class="home-contact" id="naemi">
    <div class="home-contact__aurora" aria-hidden="true"></div>
    <div class="shell home-contact__grid">
      <div>
        <h2>Не е нужно да знаете<br /><em>как се автоматизира.</em></h2>
        <p>Достатъчно е да знаете какво ви тежи. Опишете проблема със свои думи. До един работен ден ще ви отговорим дали Raboti е подходящ за него и каква е следващата стъпка.</p>
        <div class="contact-spectrum" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <ContactForm title="Изпратете запитване" enquiry={true} />
    </div>
  </section>
</BaseLayout>
