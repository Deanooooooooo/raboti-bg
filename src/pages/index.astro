---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentAvatar from "../components/AgentAvatar.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import RabotiEmployeeHero from "../components/RabotiEmployeeHero.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import WorkGlyph from "../components/WorkGlyph.astro";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgents = agents.filter((agent) => agent.data.status === "live");
const futureAgents = agents.filter((agent) => agent.data.status === "soon");
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Работи", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Работи",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "49",
      highPrice: "249",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Работи",
    itemListElement: agents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="Работи — AI служители за задачите, които бавят бизнеса"
  description="AI служители за пропуснати обаждания, промени по сайта и повтарящи се задачи. Виж какво поема всяка роля, колко струва и кога пита човек."
  canonical="/"
  schema={schemas}
  bodyClass="home-art"
>
  <section class="home-hero" data-hero>
    <div class="home-aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="home-noise" aria-hidden="true"></div>
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <h1><em>Наеми AI служители</em><br />за българския бизнес.</h1>
        <p class="home-hero__lead">Работата не чака. Работи поема обаждания, промени по сайта и повтарящи се задачи между системите. Всеки AI служител има ясна роля, месечна цена и човек, който одобрява важните решения.</p>
        <div class="home-hero__actions">
          <a class="button button--spectrum" href="#naemi">Намери своя AI служител <Icon name="arrow-down" /></a>
          <a class="home-link" href="#ekip">Виж AI служителите <Icon name="arrow-right" /></a>
        </div>
        <div class="home-hero__signals" aria-label="Основни характеристики">
          <span><i></i> Старт до 5 работни дни</span>
          <span><i></i> Работи на български</span>
          <span><i></i> Важните решения чакат одобрение</span>
        </div>
      </div>
      <RabotiEmployeeHero />
    </div>
  </section>

  <section class="home-facts" aria-labelledby="home-facts-title">
    <div class="shell">
      <div class="home-facts__intro">
        <h2 id="home-facts-title">Не просто AI служител.<br /><em>Вашият AI служител.</em></h2>
        <p>Подготвяме го за вашия начин на работа и оставаме до вас, докато стане истински полезен.</p>
      </div>

      <div class="home-facts__journey">
        <article class="home-fact">
          <strong>Показвате ни работата.</strong>
          <p>Виждаме къде се губят време и внимание — и как изглежда добре свършеното при вас.</p>
        </article>
        <article class="home-fact">
          <strong>Ние подготвяме служителя.</strong>
          <p>Учим го на вашите правила, примери и начин на работа. Тестваме и донастройваме, докато е готов да помага истински.</p>
        </article>
        <article class="home-fact">
          <strong>После работите като екип.</strong>
          <p>Знаете какво да му възлагате и как да го насочвате. Когато работата се промени, развиваме го заедно с вас.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-section roster-section" id="ekip">
    <div class="shell">
      <div class="home-heading">
        <div><h2>Къде ви трябва<br /><em>още един човек?</em></h2></div>
        <p>Изберете откъде да започнем. Ние ще подготвим служителя за работата така, както тя се върши при вас.</p>
      </div>

      <div class="roster-grid">
        {liveAgents.map((agent) => {
          const data = agent.data;
          return (
            <article class:list={["roster-card", `roster-card--${data.slug}`, data.status === "soon" && "roster-card--soon"]} style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
              <div class="roster-card__halo" aria-hidden="true"></div>
              <header>
                <div class="roster-card__heading">
                  <p>{data.role}</p>
                  <h3>{data.name}</h3>
                </div>
                <div class="roster-card__mark">
                  <AgentAvatar name={data.name} slug={data.slug} accent={data.accent} accentSoft={data.accentSoft} size="medium" />
                </div>
              </header>
              <div class="roster-card__body">
                <span>{data.summary}</span>
              </div>
              <footer>
                <div><small>Предлага се · месечна цена</small><strong>{data.priceLabel}</strong></div>
                <a href={`/sluzhiteli/${data.slug}/`} aria-label={`Виж задачите и цената за ${data.name}`}><span>Виж задачите</span><Icon name="arrow-right" /></a>
              </footer>
            </article>
          );
        })}
      </div>

      <div class="future-roles" aria-label="Роли в разработка">
        <div><span>В разработка</span><strong>Следващите роли не се продават още.</strong></div>
        {futureAgents.map((agent) => <a href={`/sluzhiteli/${agent.data.slug}/`}><span>{agent.data.name}</span><small>{agent.data.role} · списък за известие</small></a>)}
      </div>

      <aside class="fit-check" aria-labelledby="fit-title">
        <div class="fit-check__intro">
          <h3 id="fit-title">Подходящ ли е AI служител за твоя бизнес?</h3>
          <p>Започни с работа, която се повтаря и може да бъде показана с реални примери.</p>
        </div>
        <div class="fit-check__column fit-check__column--yes">
          <strong><Icon name="check" /> Да, ако работата…</strong>
          <ul><li>се повтаря всяка седмица;</li><li>започва от обаждане, имейл, формуляр или документ;</li><li>днес бави екипа или изпуска клиенти.</li></ul>
        </div>
        <div class="fit-check__column fit-check__column--no">
          <strong><span aria-hidden="true">×</span> Не, ако работата…</strong>
          <ul><li>изисква свободна човешка преценка;</li><li>няма устойчиви правила;</li><li>включва необратими решения без одобрение.</li></ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="home-section process-section" id="proces">
    <div class="shell process-layout">
      <div class="process-copy">
        <h2>Даваш работа.<br /><em>Не даваш сляп достъп.</em></h2>
        <p>Показваш ни как вършите задачата днес. Настройваме каква информация използва AI служителят, какво може да направи сам и при кои действия чака твоето одобрение.</p>
        <ul class="process-principles">
          <li><span class="principle-mark"><Icon name="arrow-right" /></span><div><strong>Получава задачата веднага</strong><small>От телефон, имейл, формуляр или график.</small></div></li>
          <li><span class="principle-mark"><Icon name="check" /></span><div><strong>Върши одобрените действия</strong><small>Използва само информацията и системите, които си разрешил.</small></div></li>
          <li><span class="principle-mark"><WorkGlyph name="guard" /></span><div><strong>Спира преди необратимо действие</strong><small>Плащане, договор или публикуване чакат човек.</small></div></li>
        </ul>
      </div>
      <WorkflowVisual />
    </div>
  </section>

  <section class="home-section proof-section" id="kontrol">
    <div class="shell proof-grid">
      <div><h2>Обхватът е написан.<br /><em>Границата също.</em></h2><p>Нямаме измислени лога и проценти, с които да те убеждаваме. Показваме какво реално влиза в предложението.</p></div>
      <ol>
        <li><span>01</span><div><strong>Задачи</strong><p>Кои входове приема ролята и какъв резултат трябва да остави.</p></div></li>
        <li><span>02</span><div><strong>Достъпи</strong><p>Кои системи и данни са нужни — нищо извън описаното.</p></div></li>
        <li><span>03</span><div><strong>Одобрения</strong><p>Точният момент, в който работата спира и чака човек.</p></div></li>
        <li><span>04</span><div><strong>Цена и старт</strong><p>Месечната цена, еднократната настройка и реалният срок преди работа.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="home-section home-faq-section">
    <div class="shell home-faq-grid">
      <div><h2>Какво поема AI служителят и как започва?</h2><p>Не ти трябва технически екип. Покажи ни работата, която остава несвършена, бави хората ти или изпуска клиенти.</p></div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section class="home-contact" id="naemi">
    <div class="home-contact__aurora" aria-hidden="true"></div>
    <div class="shell home-contact__grid">
      <div>
        <h2>Коя задача остана<br /><em>за утре и днес?</em></h2>
        <p>Опиши само една. До един работен ден ще ти кажем дали Вдига, Пише или Помага може да я поеме — и ако не може, ще го кажем направо.</p>
        <div class="contact-spectrum" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <ContactForm title="Разкажи ни за работата" />
    </div>
  </section>
</BaseLayout>
