---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import "../styles/studio.css";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgentOrder = ["vdiga", "pishe", "pomaga"];
const liveAgents = agents
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => liveAgentOrder.indexOf(a.data.slug) - liveAgentOrder.indexOf(b.data.slug));
const agentProfiles: Record<string, { name: string; image: string; imageAlt: string; cta: string; promise: string; summary: string; fit: string }> = {
  vdiga: { name: "Vdiga", fit: "За екипи, които не смогват да вдигат", image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Gloria, образът на AI рецепциониста Vdiga", cta: "Вижте как работи Vdiga", promise: "Докато сте с един клиент, не изпускайте следващия.", summary: "Обаждания, въпроси и записване на часове — без да прекъсвате клиента пред вас." },
  pishe: { name: "Pishe", fit: "За бизнеси, чийто сайт има нужда от постоянна грижа", image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Вижте как работи Pishe", promise: "Нека следващият ви клиент ви намери онлайн.", summary: "Автоматични актуализации, нов сайт при нужда и съдържание за Google и AI отговорите." },
  pomaga: { name: "Pomaga", fit: "За екипи с повтаряща се администрация", image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Вижте как работи Pomaga", promise: "Повече време за работа. По-малко за администрация.", summary: "Свързва имейла, клиентските данни и задачите. Без едно и също преписване всеки ден." },
};
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Raboti", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Raboti",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "97",
      highPrice: "297",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Raboti",
    itemListElement: liveAgents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---
<BaseLayout title="Raboti | AI служители за вашия бизнес" description="AI служители за обаждания, автоматична грижа за сайта и администрация. Вижте Vdiga, Pishe и Pomaga — с ясни правила и човешки контрол." canonical="/" schema={schemas} bodyClass="studio">
<section class="s-hero s-wrap">
 <div class="s-intro"><p class="s-eyebrow"><span class="s-dot"></span> AI СЛУЖИТЕЛИ. РЕАЛНА РАБОТА.</p><h1>Бизнесът ви<br/>не трябва<br/>да <span>чака.</span></h1><p class="s-lead">Клиентите, сайтът, ежедневната работа.<br/>Вашият AI екип поема своята част,<br class="s-desktop"/> докато вие движите бизнеса.</p><div class="s-actions"><a class="s-primary" href="#ekip">Запознайте се с екипа <span>↗</span></a><a class="s-text-link" href="#naemi">Обсъдете с нас</a></div><p class="s-caption">На български. По вашите правила.</p></div>
 <div class="s-stage" aria-label="Илюстративен пример за работа на AI служител">
  <div class="s-stage-grid" aria-hidden="true"></div><div class="s-orbit s-orbit-one" aria-hidden="true"></div><div class="s-orbit s-orbit-two" aria-hidden="true"></div>
  <div class="s-floating-note"><span class="s-dot"></span> Една задача по-малко за вас.</div>
  <div class="s-work-window"><div class="s-window-bar"><span>raboti<span class="s-blue">.</span></span><small>ПРИМЕРЕН СЦЕНАРИЙ</small><i></i></div><div class="s-person"><img src="/assets/employee-vdiga-gloria-v1.webp" width="64" height="64" alt="Глория — образът на Vdiga"/><div><strong data-demo-name>Vdiga</strong><span data-demo-role>AI рецепционист</span></div><span class="s-person-icon" aria-hidden="true">↗</span></div><div class="s-wave" aria-hidden="true">{Array.from({length:31},(_,i)=><i style={`--h:${12+Math.sin(i*.7)**2*42}px;--d:${i*30}ms`}></i>)}</div><p class="s-demo-question" data-demo-question>„Може ли час за утре следобед?“</p><div class="s-result"><span class="s-result-icon" aria-hidden="true">✓</span><div><small data-demo-state>РЕЗУЛТАТ ЗА ЕКИПА</small><strong data-demo-result>Часът е записан.</strong><span data-demo-detail>Утре, 14:30 · Обобщението е готово.</span></div></div><a class="s-demo-link" data-demo-link href="/sluzhiteli/vdiga/">Как работи Vdiga <span>↗</span></a></div>
  <div class="s-stage-tabs" aria-label="Изберете пример"><button type="button" data-role="vdiga" aria-pressed="true">Vdiga</button><button type="button" data-role="pishe" aria-pressed="false">Pishe</button><button type="button" data-role="pomaga" aria-pressed="false">Pomaga</button></div><p class="s-stage-caption">Илюстративен пример, не активност на живо.</p>
 </div>
</section>
<div class="s-service-strip"><div class="s-wrap"><a href="/sluzhiteli/vdiga/"><span>01</span> Клиентите получават отговор <b>↗</b></a><a href="/sluzhiteli/pishe/"><span>02</span> Сайтът върви с бизнеса <b>↗</b></a><a href="/sluzhiteli/pomaga/"><span>03</span> Администрацията не чака <b>↗</b></a></div></div>
<section class="s-team s-wrap" id="ekip"><div class="s-section-heading"><div><p class="s-eyebrow">ВАШАТА СЛЕДВАЩА ДОБРА СРЕЩА</p><h2>Още един служител.<br/><span>По-малко „ще го свърша“.</span></h2></div><p>Изберете къде ви трябва подкрепа.<br/>Ние подготвяме служителя<br/>за начина, по който работите.</p></div><div class="s-team-grid">{liveAgents.map(agent=>{const p=agentProfiles[agent.data.slug];return <article class={`s-agent s-agent-${agent.data.slug}`}><a class="s-portrait" href={`/sluzhiteli/${agent.data.slug}/`}><span class="s-role-label">{agent.data.role}</span><img src={p.image} width="720" height="960" alt={p.imageAlt} loading="lazy"/><span class="s-agent-name">{p.name}<span>↗</span></span></a><div class="s-agent-info"><h3>{p.promise}</h3><p>{p.summary}</p><div class="s-agent-price"><strong>{agent.data.priceLabel}</strong><a href={`/sluzhiteli/${agent.data.slug}/`} aria-label={`Научете повече за ${p.name}`}>Вижте повече ↗</a></div><small>Без ДДС · настройката се уточнява отделно</small></div></article>})}</div></section>
<section class="s-control"><div class="s-wrap s-control-grid"><div class="s-control-art" aria-label="Пример: промяна по сайта чака одобрение"><div class="s-approval-top"><span class="s-dot"></span> PISHE / ПРОМЯНА ПО САЙТА</div><div class="s-approval-sheet"><span class="s-file-icon" aria-hidden="true">↗</span><small>ПОДГОТВЕНА ПРОМЯНА</small><h3>Новата услуга<br/>е готова за сайта.</h3><div class="s-change-line"><span>Съдържание</span><b>Подготвено ✓</b></div><div class="s-change-line"><span>Публикуване</span><b data-approval-state>Чака вашето решение</b></div><button type="button" class="s-approve" data-approve>Одобрете примера <span>↗</span></button><small class="s-approval-disclaimer">Интерактивен пример. Не променя реален сайт.</small></div><div class="s-sheet-shadow" aria-hidden="true"></div></div><div class="s-control-copy"><p class="s-eyebrow">РАБОТА БЕЗ ИЗЛИШНИ ИЗНЕНАДИ</p><h2>Повече свършено.<br/><span>Контролът е ваш.</span></h2><p>Предварително уточняваме какво служителят прави сам и кога изчаква вашето решение. Виждате какво е възложено и какво е свършено.</p><ul><li>Само задачите и достъпите, които сте разрешили.</li><li>Промените извън разрешението чакат одобрение.</li><li>Ясен резултат, който екипът може да използва.</li></ul><a href="/integracii/" class="s-text-link">Вижте как се свързва с вашата работа ↗</a></div></div></section>
<section class="s-setup s-wrap"><div class="s-section-heading"><div><p class="s-eyebrow">ОТ ПЪРВИЯ РАЗГОВОР ДО ПЪРВАТА ЗАДАЧА</p><h2>Не още една система.<br/><span>Още свършена работа.</span></h2></div><p>AI служител, подготвен за конкретната работа.<br/>Не заместител на всяко човешко решение.</p></div><div class="s-steps"><article><span>01 / РАЗГОВОР</span><h3>Показвате ни<br/>къде ви тежи.</h3><p>Разглеждаме работата, която прекъсва екипа или постоянно остава за после.</p></article><article><span>02 / ПРАВИЛА</span><h3>Уточняваме<br/>какво поемаме.</h3><p>Задачи, информация, достъпи и одобрения. Получавате обхват, цена и срок преди старта.</p></article><article><span>03 / СТАРТ</span><h3>Проверяваме.<br/>После започваме.</h3><p>Тестваме обичайните случаи и изключенията, преди да възложите реална работа.</p></article></div></section>
<section class="s-faq s-wrap"><div><p class="s-eyebrow">ПРЕДИ ДА ЗАПОЧНЕМ</p><h2>Добри въпроси.<br/><span>Ясни отговори.</span></h2><a href="/polezno/seo-geo/" class="s-text-link">За Google и AI откриваемостта ↗</a></div><FAQ items={homeFaqs}/></section>
<section class="s-contact s-wrap" id="naemi"><div><p class="s-eyebrow">ДА ОСВОБОДИМ МЯСТО ЗА ВАЖНОТО</p><h2>Кое не трябва<br/>да чака <span>вас?</span></h2><p>Не ви трябва техническо задание.<br/>Разкажете ни какво ви тежи.<br/>Отговаряме до един работен ден.</p><a class="s-contact-mail" href={`mailto:${site.contactEmail}`}>{site.contactEmail} ↗</a></div><div class="s-form-wrap"><p class="s-preview-notice">Дизайн preview · формата не изпраща. За връзка използвайте имейла.</p><ContactForm title="Нека поговорим за вашия бизнес" enquiry={true}/></div></section>
<script>
const scenarios = {
vdiga:{name:'Vdiga',role:'AI рецепционист',question:'„Може ли час за утре следобед?“',state:'РЕЗУЛТАТ ЗА ЕКИПА',result:'Часът е записан.',detail:'Утре, 14:30 · Обобщението е готово.',image:'employee-vdiga-gloria-v1.webp'},
pishe:{name:'Pishe',role:'AI уеб мениджър',question:'„Нека сайтът показва новата ни услуга.“',state:'ПО ПРЕДВАРИТЕЛНО ОДОБРЕНИ ПРАВИЛА',result:'Сайтът е актуализиран.',detail:'Ясно съдържание за хората, Google и AI.',image:'employee-pishe-v1.webp'},
pomaga:{name:'Pomaga',role:'AI оперативен асистент',question:'„Получихме ново запитване по имейл.“',state:'РЕЗУЛТАТ ЗА ЕКИПА',result:'Запитването е подредено.',detail:'Клиент в CRM · Задача към колега.',image:'employee-pomaga-v1.webp'}
};
document.querySelectorAll<HTMLButtonElement>('[data-role]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.role as keyof typeof scenarios;const s=scenarios[key];document.querySelectorAll('[data-role]').forEach(el=>el.setAttribute('aria-pressed',String(el===button))); for(const field of ['name','role','question','state','result','detail'] as const){const el=document.querySelector(`[data-demo-${field}]`);if(el)el.textContent=s[field];} const a=document.querySelector<HTMLAnchorElement>('[data-demo-link]');if(a){a.href=a.href.replace(/sluzhiteli\/[^/]+\//,`sluzhiteli/${key}/`);a.textContent=`Как работи ${s.name} ↗`;} const img=document.querySelector<HTMLImageElement>('.s-person img');if(img){img.src=img.src.replace(/[^/]+$/,s.image);img.alt=`Образът на ${s.name}`;}}));
document.querySelector<HTMLButtonElement>('[data-approve]')?.addEventListener('click',e=>{const b=e.currentTarget as HTMLButtonElement;const done=b.dataset.done==='true';b.dataset.done=String(!done);b.textContent=done?'Одобрете примера ↗':'Публикувано в примера ✓ · Отначало';document.querySelector('[data-approval-state]')!.textContent=done?'Чака вашето решение':'Одобрено от вас ✓';});
const form=document.querySelector<HTMLFormElement>('.studio [data-contact-form]');if(form){form.addEventListener('submit',e=>{e.preventDefault();e.stopImmediatePropagation();},true);const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(submit){submit.disabled=true;submit.textContent='Изпращане изключено в preview';}const select=form.querySelector<HTMLSelectElement>('[data-agent-choice]');if(select)select.value='unsure';}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector('.site-nav')?.classList.remove('is-open');document.querySelector('.nav-toggle')?.setAttribute('aria-expanded','false');}});
</script>
</BaseLayout>
