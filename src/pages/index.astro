---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import Icon from "../components/Icon.astro";
import RabotiEmployeeHero from "../components/RabotiEmployeeHero.astro";
import WorkflowVisual from "../components/WorkflowVisual.astro";
import WorkGlyph from "../components/WorkGlyph.astro";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgentOrder = ["vdiga", "pishe", "pomaga"];
const liveAgents = agents
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => liveAgentOrder.indexOf(a.data.slug) - liveAgentOrder.indexOf(b.data.slug));
const agentProfiles: Record<string, { name: string; image: string; imageAlt: string; cta: string }> = {
  vdiga: { name: "Vdiga", image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Gloria — образът на AI рецепциониста Vdiga", cta: "Как мога да съм полезна?" },
  pishe: { name: "Pishe", image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Как мога да съм полезен?" },
  pomaga: { name: "Pomaga", image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Как мога да съм полезна?" },
};
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Работи", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Работи",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "97",
      highPrice: "297",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Работи",
    itemListElement: agents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---

<BaseLayout
  title="Работи — AI служители за задачите, които бавят бизнеса"
  description="AI служители за пропуснати обаждания, промени по сайта и повтарящи се задачи. Виж какво поема всяка роля, колко струва и кога пита човек."
  canonical="/"
  schema={schemas}
  bodyClass="home-art"
>
  <section class="home-hero" data-hero>
    <div class="shell home-hero__grid">
      <div class="home-hero__copy">
        <h1><em>Наеми AI служители</em><br />за българския бизнес.</h1>
        <p class="home-hero__lead">Работата не чака. Работи поема обаждания, промени по сайта и повтарящи се задачи между системите. Всеки AI служител има ясна роля, месечна цена и човек, който одобрява важните решения.</p>
        <div class="home-hero__actions">
          <a class="button button--spectrum" href="#naemi">Намери своя AI служител <Icon name="arrow-down" /></a>
          <a class="home-link" href="#ekip">Виж AI служителите <Icon name="arrow-right" /></a>
        </div>
        <div class="home-hero__signals" aria-label="Основни характеристики">
          <span><i></i> Старт до 5 работни дни</span>
          <span><i></i> Работи на български</span>
          <span><i></i> Важните решения чакат одобрение</span>
        </div>
      </div>
      <RabotiEmployeeHero />
    </div>
  </section>

  <section class="home-facts" aria-labelledby="home-facts-title">
    <div class="shell">
      <div class="home-facts__intro">
        <h2 id="home-facts-title">Не просто AI служител.<br /><em>Вашият AI служител.</em></h2>
        <p>Подготвяме го за вашия начин на работа и оставаме до вас, докато стане истински полезен.</p>
      </div>

      <div class="home-facts__journey">
        <article class="home-fact">
          <strong>Показвате ни работата.</strong>
          <p>Виждаме къде се губят време и внимание — и как изглежда добре свършеното при вас.</p>
        </article>
        <article class="home-fact">
          <strong>Ние подготвяме служителя.</strong>
          <p>Учим го на вашите правила, примери и начин на работа. Тестваме и донастройваме, докато е готов да помага истински.</p>
        </article>
        <article class="home-fact">
          <strong>После работите като екип.</strong>
          <p>Знаете какво да му възлагате и как да го насочвате. Когато работата се промени, развиваме го заедно с вас.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-section roster-section" id="ekip">
    <div class="shell">
      <div class="home-heading">
        <div><h2>Къде ви трябва<br /><em>още един служител?</em></h2></div>
        <p>Изберете откъде да започнем. Ние ще подготвим служителя за работата така, както тя се върши при вас.</p>
      </div>

      <div class="roster-grid">
        {liveAgents.map((agent) => {
          const data = agent.data;
          const profile = agentProfiles[data.slug];
          return (
            <a class:list={["roster-card", `roster-card--${data.slug}`, data.status === "soon" && "roster-card--soon"]} href={`/sluzhiteli/${data.slug}/`} aria-label={`${profile.name}: как може да помогне`} style={`--agent:${data.accent};--agent-soft:${data.accentSoft}`}>
              <header>
                <div class="roster-card__heading">
                  <p>{data.role}</p>
                  <h3>{profile.name}</h3>
                </div>
              </header>
              <div class="roster-card__portrait">
                <img src={profile.image} width="720" height="960" alt={profile.imageAlt} loading="eager" decoding="sync" />
              </div>
              <div class="roster-card__body">
                <span>{data.summary}</span>
              </div>
              <footer>
                <strong>{data.priceLabel}</strong>
                <span class="roster-card__action"><span>{profile.cta}</span><Icon name="arrow-right" /></span>
              </footer>
            </a>
          );
        })}
      </div>

    </div>
  </section>

  <section class="home-section process-section" id="proces">
    <div class="shell process-layout">
      <div class="process-copy">
        <h2>Работата не чака.<br /><em>Важните решения чакат теб.</em></h2>
        <p>Обажданията, промените по сайта и прехвърлянето на данни вече не чакат свободен човек. Служителят ги поема по ясни правила. Плащане, договор или публикуване не минават без твоето „да“.</p>
        <ul class="process-principles">
          <li><span class="principle-mark"><Icon name="arrow-right" /></span><div><strong>Поема задачата, когато пристигне</strong><small>Дори когато екипът е зает или денят е приключил.</small></div></li>
          <li><span class="principle-mark"><Icon name="check" /></span><div><strong>Прави точно договореното</strong><small>Само с информацията и системите, които си разрешил.</small></div></li>
          <li><span class="principle-mark"><WorkGlyph name="guard" /></span><div><strong>Пита преди риск</strong><small>Парите, договорите и окончателните решения остават при теб.</small></div></li>
        </ul>
        <a class="button process-cta" href="/kontakti/">Покажи ни една задача <Icon name="arrow-right" /></a>
      </div>
      <WorkflowVisual />
    </div>
  </section>

  <section class="home-section proof-section" id="kontrol">
    <div class="shell proof-grid">
      <div class="proof-copy">
        <h2>Преди да наемеш, ще знаеш <em>точно какво получаваш.</em></h2>
        <p>Опиши една повтаряща се задача. До един работен ден ще ти кажем дали можем да я поемем, кой служител е подходящ и при какви условия. Ако не можем — казваме го директно.</p>
        <a class="button proof-cta" href="/kontakti/">Провери моята задача <Icon name="arrow-right" /></a>
        <small>Не ти трябва техническо задание. Достатъчно е да опишеш как я вършите сега.</small>
      </div>
      <div class="decision-brief" aria-label="Какво ще съдържа нашият отговор">
        <header>
          <span>Какво получаваш от нас</span>
          <strong>Ясно „да“, „не“ или „да, при тези условия“.</strong>
        </header>
        <ul>
          <li><span><Icon name="check" /></span><div><strong>Подходящият служител</strong><p>Vdiga, Pishe или Pomaga — и защо точно тази роля пасва на задачата.</p></div></li>
          <li><span><Icon name="check" /></span><div><strong>Точният обхват</strong><p>Какво поема, какъв резултат оставя и какво остава извън предложението.</p></div></li>
          <li><span><Icon name="check" /></span><div><strong>Пълната цена и реалният старт</strong><p>Месечна цена, еднократна настройка и кога служителят може да започне.</p></div></li>
          <li><span><Icon name="check" /></span><div><strong>Достъпи и човешко одобрение</strong><p>До кои системи има достъп и кои действия винаги чакат твоето „да“.</p></div></li>
        </ul>
        <footer>Така решаваш по конкретна оферта, не по обещания.</footer>
      </div>
    </div>
  </section>

  <section class="home-section home-faq-section">
    <div class="shell home-faq-grid">
      <div><h2>Какво поема AI служителят и как започва?</h2><p>Не ти трябва технически екип. Покажи ни работата, която остава несвършена, бави хората ти или изпуска клиенти.</p></div>
      <FAQ items={homeFaqs} />
    </div>
  </section>

  <section class="home-contact" id="naemi">
    <div class="home-contact__aurora" aria-hidden="true"></div>
    <div class="shell home-contact__grid">
      <div>
        <h2>Коя задача остана<br /><em>за утре и днес?</em></h2>
        <p>Опиши само една. До един работен ден ще ти кажем дали Вдига, Пише или Помага може да я поеме — и ако не може, ще го кажем направо.</p>
        <div class="contact-spectrum" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <ContactForm title="Разкажи ни за работата" />
    </div>
  </section>
</BaseLayout>
