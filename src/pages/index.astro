---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
import "../styles/studio.css";
import { breadcrumbSchema, faqSchema } from "../data/schema";
import { homeFaqs as originalFaqs, site } from "../data/site";

const agents = (await getCollection("agents")).sort((a, b) => a.data.order - b.data.order);
const liveAgentOrder = ["vdiga", "pishe", "pomaga"];
const liveAgents = agents
  .filter((agent) => agent.data.status === "live")
  .sort((a, b) => liveAgentOrder.indexOf(a.data.slug) - liveAgentOrder.indexOf(b.data.slug));
const agentProfiles: Record<string, { name: string; image: string; imageAlt: string; cta: string; promise: string; summary: string; fit: string }> = {
  vdiga: { name: "Vdiga", fit: "За екипи, които не смогват да вдигат", image: "/assets/employee-vdiga-gloria-v1.webp", imageAlt: "Gloria, образът на AI рецепциониста Vdiga", cta: "Вижте как работи Vdiga", promise: "Докато сте с един клиент, другият получава отговор.", summary: "Vdiga приема обаждания, отговаря на въпроси и записва часове. Клиентите могат да се свържат с бизнеса, без телефонът постоянно да прекъсва работата ви." },
  pishe: { name: "Pishe", fit: "За бизнеси, чийто сайт има нужда от постоянна грижа", image: "/assets/employee-pishe-v1.webp", imageAlt: "Визуално представяне на AI уеб мениджъра Pishe", cta: "Вижте как работи Pishe", promise: "Сайтът ви работи за бизнеса, вместо да изостава от него.", summary: "Pishe обновява сегашния ви сайт автоматично по уговорени правила, развива съдържанието за Google и AI отговорите и изгражда нов сайт, ако нямате." },
  pomaga: { name: "Pomaga", fit: "За екипи с повтаряща се администрация", image: "/assets/employee-pomaga-v1.webp", imageAlt: "Визуално представяне на AI оперативния асистент Pomaga", cta: "Вижте как работи Pomaga", promise: "Екипът ви върши работа, вместо да преписва информация.", summary: "Pomaga обработва запитвания и прехвърля данни между имейла, CRM и задачите. Повтарящите се стъпки не зависят от това кой ще намери време да ги свърши." },
};
const homeFaqs = [
 {question: "Какво получавам, когато наема AI служител?", answer: "Услуга за конкретна работа във вашия бизнес, а не само достъп до AI програма. Уточняваме задачите, подготвяме служителя и го свързваме с необходимата информация и системи. Вие знаете какво поема и в кои случаи трябва да ви попита."},
 {question: "Колко струва и има ли такса за настройка?", answer: "Месечните планове започват от €97 за Vdiga, €197 за Pishe и €297 за Pomaga, без ДДС. Първоначалната настройка се плаща отделно. Получавате точен обхват и обща цена преди да започнем. Нов сайт или голям редизайн също се оферира отделно."},
 {question: "Pishe може ли да обновява сегашния ми сайт автоматично?", answer: "Да, ако сайтът позволява надежден достъп за редакция и връщане на предишна версия. Pishe прилага предварително разрешените актуализации. Нови цени, оферти и важни обещания към клиентите първо се потвърждават от вас. Ако нямате сайт, може да изгради нов."},
 {question: "Как помагате за откриването на бизнеса в Google и AI отговорите?", answer: "Pishe подобрява страниците за услугите, актуализира информацията и подготвя полезни отговори на въпросите на клиентите. Работи по техническата достъпност за търсачките и структурираното описание на бизнеса. Това подпомага SEO и откриваемостта в AI отговори, но не гарантира позиция или препоръка от Google или ChatGPT."},
 ...originalFaqs.filter(item => ["Трябва ли да сменим програмите, които използваме?", "Може ли AI служителят да действа без човешки контрол?", "Кой стои зад Raboti?"].includes(item.question))
];
const schemas = [
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: "Raboti", url: site.url }]),
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/#ai-employees`,
    name: "AI служители от Raboti",
    serviceType: "Абонаментна услуга за AI служители",
    description: "AI служители за входящи обаждания, работа по сайта и повтарящи се оперативни задачи с предварително зададени правила и човешки контрол.",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: { "@type": "Country", name: "България" },
    availableChannel: { "@type": "ServiceChannel", serviceUrl: site.url, availableLanguage: "bg" },
    offers: {
      "@type": "AggregateOffer",
      lowPrice: "97",
      highPrice: "297",
      priceCurrency: "EUR",
      offerCount: "3",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "AI служители от Raboti",
    itemListElement: liveAgents.map((agent, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: `${site.url}/sluzhiteli/${agent.data.slug}/`,
      name: agent.data.name,
    })),
  },
];
---
<BaseLayout title="AI служители за бизнеса — телефон, сайт и администрация | Raboti" description="Наемете AI служител за обаждания, автоматична поддръжка на сайт, SEO и ежедневна администрация. Вижте услугите, цените и как започваме." canonical="/" schema={schemas} bodyClass="studio">
<section class="s-hero s-wrap">
 <div class="s-intro"><h1>AI служители за работата, която все остава <span>за вас.</span></h1><p class="s-lead">Обслужвате клиенти, а телефонът звъни. Сайтът чака промени. След работа остават имейлите и справките. Raboti поема тази ежедневна работа, за да не се налага вие и екипът ви да вършите всичко.</p><div class="s-actions"><a class="s-primary" href="#ekip">Вижте кой може да помогне <span>↗</span></a><a class="s-text-link" href="#naemi">Обсъдете вашия бизнес</a></div><p class="s-caption">Настройваме служителя за вашия бизнес. Вие определяте какво му възлагате.</p></div>
 <div class="s-stage" aria-label="Илюстративен пример за работа на AI служител">
  
  
  <svg class="s-light-field" viewBox="0 0 600 600" fill="none" aria-hidden="true"><defs><linearGradient id="spectrum"><stop stop-color="#97e1d4"/><stop offset=".48" stop-color="#829fff"/><stop offset="1" stop-color="#e4b8f2"/></linearGradient></defs><path d="M20 390C80 80 350 50 545 245S450 580 250 490S70 330 20 390" stroke="url(#spectrum)" stroke-width="42"/><path d="M0 450C160 90 450 110 590 300" stroke="url(#spectrum)" stroke-width="2"/></svg><div class="s-work-window"><div class="s-window-bar"><span>raboti<span class="s-blue">.</span></span><small>Пример за работа</small><i></i></div><div class="s-person"><img src="/assets/employee-vdiga-gloria-v1.webp" width="64" height="64" alt="Глория — образът на Vdiga"/><div><strong data-demo-name>Vdiga</strong><span data-demo-role>AI рецепционист</span></div><span class="s-person-icon" aria-hidden="true">↗</span></div><p class="s-request-label">Запитване от клиент</p><p class="s-demo-question" data-demo-question>„Може ли час за утре следобед?“</p><div class="s-result" aria-live="polite" aria-atomic="true"><span class="s-result-icon" aria-hidden="true">✓</span><div><small data-demo-state>Резултат за екипа</small><strong data-demo-result>Часът е записан.</strong><span data-demo-detail>Утре, 14:30 · Обобщението е готово.</span></div></div><a class="s-demo-link" data-demo-link href="/sluzhiteli/vdiga/">Как работи Vdiga <span>↗</span></a></div>
  <div class="s-stage-tabs" aria-label="Изберете пример"><button type="button" data-role="vdiga" aria-pressed="true">Vdiga</button><button type="button" data-role="pishe" aria-pressed="false">Pishe</button><button type="button" data-role="pomaga" aria-pressed="false">Pomaga</button></div><p class="s-stage-caption">Илюстративен пример, не активност на живо.</p>
 </div>
</section>
<div class="s-service-strip"><div class="s-wrap"><a href="/sluzhiteli/vdiga/">Клиентите получават отговор <b>↗</b></a><a href="/sluzhiteli/pishe/">Сайтът е актуален и откриваем <b>↗</b></a><a href="/sluzhiteli/pomaga/">По-малко ръчна администрация <b>↗</b></a></div></div>
<section class="s-team s-wrap" id="ekip"><div class="s-section-heading"><div><h2>Къде ви трябва<br/><span>още един служител?</span></h2></div><p>Три услуги за три постоянни нужди: обслужване по телефона, грижа за сайта и по-малко ръчна администрация.</p></div><div class="s-team-grid">{liveAgents.map(agent=>{const p=agentProfiles[agent.data.slug];return <article class={`s-agent s-agent-${agent.data.slug}`}><a class="s-portrait" href={`/sluzhiteli/${agent.data.slug}/`}><span class="s-role-label">{agent.data.role}</span><img src={p.image} width="720" height="960" alt={p.imageAlt} loading="lazy"/><span class="s-agent-name">{p.name}<span>↗</span></span></a><div class="s-agent-info"><h3>{p.promise}</h3><p>{p.summary}</p><div class="s-agent-price"><strong>{agent.data.priceLabel}</strong><a href={`/sluzhiteli/${agent.data.slug}/`} aria-label={`Научете повече за ${p.name}`}>Какво включва ↗</a></div><small>Без ДДС. Настройката се заплаща отделно.</small></div></article>})}</div></section>
<section class="s-control"><div class="s-wrap s-control-grid"><div class="s-control-art" aria-label="Пример: промяна по сайта чака одобрение"><div class="s-approval-top"><span class="s-dot"></span> Pishe · Пример за одобрение</div><div class="s-approval-sheet"><span class="s-file-icon" aria-hidden="true">↗</span><small>Подготвена страница</small><h3>Страницата за новата услуга е готова.</h3><div class="s-change-line"><span>Съдържание</span><b>Подготвено ✓</b></div><div class="s-change-line"><span>Публикуване</span><b data-approval-state>Чака вашето решение</b></div><button type="button" class="s-approve" data-approve>Одобрете примера <span>↗</span></button><small class="s-approval-disclaimer">Интерактивен пример. Не променя реален сайт.</small></div><div class="s-sheet-shadow" aria-hidden="true"></div></div><div class="s-control-copy"><h2>Делегирате работата.<br/><span>Не и решенията.</span></h2><p>Предварително уточняваме какво служителят прави сам и кога изчаква вашето решение. Виждате какво е възложено и какво е свършено.</p><ul><li>Само задачите и достъпите, които сте разрешили.</li><li>Промените извън разрешението чакат одобрение.</li><li>Ясен резултат, който екипът може да използва.</li></ul><a href="/integracii/" class="s-text-link">Вижте поддържаните интеграции ↗</a></div></div></section>
<section class="s-search s-wrap" data-discovery-selected="0" aria-labelledby="search-title"><div><h2 id="search-title">Не е достатъчно<br/><span>просто да имате сайт.</span></h2><p class="s-search-intro">Хората трябва да ви намират, да разбират какво предлагате и лесно да се свързват с вас. Затова Pishe съчетава поддръжката на сайта с работа по съдържанието, SEO и откриваемостта в AI отговорите.</p><a class="s-text-link" href="/sluzhiteli/pishe/">Как Pishe се грижи за сайта ви ↗</a></div><div class="s-discovery" aria-label="Изберете част от работата по сайта"><svg viewBox="0 0 540 260" fill="none" aria-hidden="true"><defs><linearGradient id="discovery-line"><stop stop-color="#71c7b3"/><stop offset=".5" stop-color="#315cf5"/><stop offset="1" stop-color="#b994e4"/></linearGradient></defs><path d="M85 180C85 60 270 210 270 65S455 60 455 180" stroke="url(#discovery-line)" stroke-width="2"/><circle cx="270" cy="65" r="49" stroke="#d7e0f5"/><circle cx="270" cy="65" r="62" stroke="#e8edf8"/></svg><div class="s-discovery-nodes"><button type="button" data-discovery="0" aria-pressed="true"><span class="s-node-icon"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="4" y="5" width="24" height="22" rx="3"/><path d="M4 12h24M9 9h2m3 0h2M9 18h14m-14 4h9"/></svg></span>Вашият сайт</button><button type="button" data-discovery="1" aria-pressed="false"><span class="s-node-icon"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="14" cy="14" r="8"/><path d="m20 20 7 7"/></svg></span>Google · SEO</button><button type="button" data-discovery="2" aria-pressed="false"><span class="s-node-icon"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 3 20 12 29 16 20 20 16 29 12 20 3 16 12 12Z"/></svg></span>AI отговори · GEO</button></div><p>Изберете къде искате да развиете присъствието си.</p></div><div class="s-search-details"><article><h3>Сайт, на който клиентът може да разчита</h3><p>Актуални услуги, цени и контакти, ясни страници и работещи форми. Pishe обновява съществуващия сайт по предварително одобрени правила. Ако нямате сайт, изграждането се оферира отделно.</p></article><article><h3>Да ви откриват в Google — SEO</h3><p>Съдържание по въпросите, с които клиентите търсят вашата услуга, ясни връзки между страниците и техническа достъпност за търсачките. Не просто добавяне на ключови думи.</p></article><article><h3>Да ви разбират и AI асистентите — GEO</h3><p>Точна информация за бизнеса, услугите и техните условия, която може да бъде използвана като източник в AI отговори. Няма гарантирано място в Google AI Overviews или ChatGPT.</p></article><a href="/polezno/seo-geo/" class="s-text-link">Какво означават SEO и GEO за бизнеса ви ↗</a></div></section>
<section class="s-setup s-wrap"><div class="s-section-heading"><div><h2>Започваме с вашата работа.<br/><span>Не с нова програма.</span></h2></div><p>Не е нужно да знаете как се прави автоматизация. Покажете ни как работите сега; ние ще преценим какво може да се поеме надеждно.</p></div><div class="s-journey" aria-hidden="true"><div class="s-journey-conversation"><span></span><span></span><span></span></div><svg viewBox="0 0 200 60" fill="none"><path d="M0 30H190m-15-10 15 10-15 10"/></svg><div class="s-journey-rules"><i></i><i></i><i></i></div><svg viewBox="0 0 200 60" fill="none"><path d="M0 30H190m-15-10 15 10-15 10"/></svg><div class="s-journey-check"><svg viewBox="0 0 48 48" fill="none"><path d="m12 25 8 8 17-19"/></svg></div></div><div class="s-steps"><article><span>01 / РАЗГОВОР</span><h3>Показвате ни къде ви тежи.</h3><p>Разглеждаме работата, която прекъсва екипа или постоянно остава за после.</p></article><article><span>02 / ПРАВИЛА</span><h3>Уточняваме какво поемаме.</h3><p>Задачи, информация, достъпи и одобрения. Получавате обхват, цена и срок преди старта.</p></article><article><span>03 / СТАРТ</span><h3>Проверяваме, преди да започнем.</h3><p>Тестваме обичайните случаи и изключенията, преди да възложите реална работа.</p></article></div></section>
<section class="s-faq s-wrap"><div><h2>Какво е важно<br/><span>преди да започнете?</span></h2><a href="/polezno/seo-geo/" class="s-text-link">За Google и AI откриваемостта ↗</a></div><FAQ items={homeFaqs}/></section>
<section class="s-contact s-wrap" id="naemi"><div><div class="s-contact-team" aria-label="Изберете служител за запитването"><button type="button" data-enquiry-role="vdiga" aria-pressed="false"><img src="/assets/employee-vdiga-gloria-v1.webp" width="80" height="80" loading="lazy" alt=""/><span>Vdiga</span></button><button type="button" data-enquiry-role="pishe" aria-pressed="false"><img src="/assets/employee-pishe-v1.webp" width="80" height="80" loading="lazy" alt=""/><span>Pishe</span></button><button type="button" data-enquiry-role="pomaga" aria-pressed="false"><img src="/assets/employee-pomaga-v1.webp" width="80" height="80" loading="lazy" alt=""/><span>Pomaga</span></button></div><p class="s-selection-note" aria-live="polite">Изберете служител или ни разкажете какво ви трябва.</p><h2>Коя работа отнема<br/><span>твърде много от времето ви?</span></h2><p>Разкажете ни какво постоянно остава за вас или бави екипа. До един работен ден ще ви отговорим дали можем да го поемем, с кой служител и каква е следващата стъпка.</p><a class="s-contact-mail" href={`mailto:${site.contactEmail}`}>{site.contactEmail} ↗</a></div><div class="s-form-wrap"><p class="s-preview-notice">Тестова версия: формата не изпраща запитвания. Можете да ни пишете на посочения имейл.</p><ContactForm title="Разкажете ни за работата" enquiry={true}/></div></section>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-discovery]').forEach(button=>button.addEventListener('click',()=>{const index=Number(button.dataset.discovery);document.querySelector('.s-search')?.setAttribute('data-discovery-selected',String(index));document.querySelectorAll('[data-discovery]').forEach(el=>el.setAttribute('aria-pressed',String(el===button)));document.querySelectorAll('.s-search-details article').forEach((el,i)=>el.classList.toggle('is-selected',i===index));}));
document.querySelectorAll<HTMLButtonElement>('[data-enquiry-role]').forEach(button=>button.addEventListener('click',()=>{const role=button.dataset.enquiryRole!;const select=document.querySelector<HTMLSelectElement>('[data-agent-choice]');if(select){select.value=role;select.dispatchEvent(new Event('change',{bubbles:true}));}document.querySelectorAll('[data-enquiry-role]').forEach(el=>el.setAttribute('aria-pressed',String(el===button)));const note=document.querySelector('.s-selection-note');if(note)note.textContent=`Избрахте ${button.textContent?.trim()}. Разкажете ни какво искате да поеме.`;}));
const scenarios = {
vdiga:{name:'Vdiga',role:'AI рецепционист',question:'„Може ли час за утре следобед?“',state:'Резултат за екипа',result:'Часът е записан.',detail:'Утре, 14:30 · Обобщението е готово.',image:'employee-vdiga-gloria-v1.webp'},
pishe:{name:'Pishe',role:'AI уеб мениджър',question:'„Нека сайтът показва новата ни услуга.“',state:'По предварително одобрени правила',result:'Сайтът е актуализиран.',detail:'Ясно съдържание за хората, Google и AI.',image:'employee-pishe-v1.webp'},
pomaga:{name:'Pomaga',role:'AI оперативен асистент',question:'„Получихме ново запитване по имейл.“',state:'Резултат за екипа',result:'Запитването е подредено.',detail:'Клиент в CRM · Задача към колега.',image:'employee-pomaga-v1.webp'}
};
document.querySelectorAll<HTMLButtonElement>('[data-role]').forEach(button=>button.addEventListener('click',()=>{const key=button.dataset.role as keyof typeof scenarios;const s=scenarios[key];document.querySelectorAll('[data-role]').forEach(el=>el.setAttribute('aria-pressed',String(el===button))); for(const field of ['name','role','question','state','result','detail'] as const){const el=document.querySelector(`[data-demo-${field}]`);if(el)el.textContent=s[field];} const a=document.querySelector<HTMLAnchorElement>('[data-demo-link]');if(a){a.href=a.href.replace(/sluzhiteli\/[^/]+\//,`sluzhiteli/${key}/`);a.textContent=`Как работи ${s.name} ↗`;} const img=document.querySelector<HTMLImageElement>('.s-person img');if(img){img.src=img.src.replace(/[^/]+$/,s.image);img.alt=`Образът на ${s.name}`;}}));
document.querySelector<HTMLButtonElement>('[data-approve]')?.addEventListener('click',e=>{const b=e.currentTarget as HTMLButtonElement;const done=b.dataset.done==='true';b.dataset.done=String(!done);b.textContent=done?'Одобрете примера ↗':'Публикувано в примера ✓ · Отначало';document.querySelector('[data-approval-state]')!.textContent=done?'Чака вашето решение':'Одобрено от вас ✓';});
const form=document.querySelector<HTMLFormElement>('.studio [data-contact-form]');if(form){form.addEventListener('submit',e=>{e.preventDefault();e.stopImmediatePropagation();},true);const submit=form.querySelector<HTMLButtonElement>('button[type="submit"]');if(submit){submit.disabled=true;submit.textContent='Изпращането е изключено в тестовата версия';}const select=form.querySelector<HTMLSelectElement>('[data-agent-choice]');if(select)select.value='unsure';}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){document.querySelector('.site-nav')?.classList.remove('is-open');document.querySelector('.nav-toggle')?.setAttribute('aria-expanded','false');}});
</script>
</BaseLayout>
