---
import "@fontsource-variable/inter/wght.css";
import interCyrillic from "@fontsource-variable/inter/files/inter-cyrillic-wght-normal.woff2?url";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "../styles/global.css";
import "../styles/home-refinement.css";
import onestCyrillic from "../assets/fonts/onest-cyrillic-wght-normal.woff2?url";
import onestLatin from "../assets/fonts/onest-latin-wght-normal.woff2?url";
import JourneyEvents from "../components/JourneyEvents.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import StickyCallBar from "../components/StickyCallBar.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
  bodyClass?: string;
  imageAlt?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  author?: string;
  darkOpener?: boolean;
}
const props = Astro.props;
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f5f7f4" />
    <link rel="preload" href={(props.bodyClass === "home-art" || props.bodyClass?.includes("candidate-page") || props.bodyClass?.includes("studio-secondary")) ? onestCyrillic : interCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={(props.bodyClass === "home-art" || props.bodyClass?.includes("candidate-page") || props.bodyClass?.includes("studio-secondary")) ? onestLatin : interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="bg" href={new URL(props.canonical || Astro.url.pathname, site.url)} />
    <link rel="alternate" hreflang="x-default" href={new URL(props.canonical || Astro.url.pathname, site.url)} />
    <SEO {...props} />
    {site.plausibleDomain && <script is:inline defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body class:list={[props.bodyClass, { "has-dark-opener": props.darkOpener }]}>
    {props.bodyClass === "home-art" && <Fragment set:html={`<!--
THESIS: Three unfinished moments from one working day make the offer concrete; this refuses the category-default card catalogue and abstract AI dashboard.
OWN-WORLD: Near-black operational surfaces, cyan/violet/coral role signals, crisp white reading fields, and authored work records.
STORY: Recognize the work that waits, see one available role take it within explicit limits, then submit one real task for evaluation.
FIRST VIEWPORT: Direct offer and action on the left; an interactive working-day record with three recognizable moments on the right.
FORM: Three unfinished moments, third grounded structure; seed 3f09ee64.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`} />}
    {props.bodyClass === "integrations-c" && <Fragment set:html={`<!--
THESIS: A single physical connection spine shows software becoming completed work; this refuses the generic integration-logo catalogue.
OWN-WORLD: Warm white working paper, one deep-green hardware spine, real brand marks, circular employee portraits, and restrained signal colors.
STORY: See familiar software connect to a named employee, understand the resulting work, then ask Raboti to check a connection.
FIRST VIEWPORT: Logo plugs enter a full-height spine at left, three employees branch from it in the middle, and one four-line promise anchors the right.
FORM: Vertical connection rail, user-approved direction C; seed 3d8b1317.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->`} />}
    <a class="skip-link" href="#main">Към съдържанието</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <StickyCallBar />
    <JourneyEvents />
    <script>
      document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((link) => {
        link.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("raboti:tel-click", { detail: { href: link.href, path: location.pathname } }));
        });
      });
    </script>
  </body>
</html>
