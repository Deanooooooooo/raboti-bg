---
import "@fontsource-variable/onest/wght.css";
import "@fontsource-variable/manrope/wght.css";
import onestCyrillic from "@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url";
import manropeCyrillic from "@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SEO from "../components/SEO.astro";
import StickyCallBar from "../components/StickyCallBar.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}
const props = Astro.props;
---
<!doctype html>
<html lang="bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#f5f7f4" />
    <link rel="preload" href={onestCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={manropeCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="bg" href={new URL(props.canonical || Astro.url.pathname, site.url)} />
    <link rel="alternate" hreflang="x-default" href={new URL(props.canonical || Astro.url.pathname, site.url)} />
    <SEO {...props} />
    {site.plausibleDomain && <script is:inline defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
  </head>
  <body>
    <a class="skip-link" href="#main">Към съдържанието</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <StickyCallBar />
    <script>
      document.querySelectorAll<HTMLAnchorElement>('a[href^="tel:"]').forEach((link) => {
        link.addEventListener("click", () => {
          window.dispatchEvent(new CustomEvent("raboti:tel-click", { detail: { href: link.href, path: location.pathname } }));
        });
      });
    </script>
  </body>
</html>
